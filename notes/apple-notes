def cmd_export(args):
    """Handle export command"""
    result = find_note(args.identifier)

    if not result:
        print(f"Note not found: {args.identifier}", file=sys.stderr)
        sys.exit(1)

    pk, title, identifier, compressed_data, locked = result

    # A locked note has no readable body — say so, rather than blaming the
    # parser for content that was never there.
    if locked:
        print(
            f"Note {pk} is password-protected; its contents are encrypted and "
            "cannot be exported.\nUnlock it in Notes.app and copy the text out "
            "manually — there is no API to decrypt it.",
            file=sys.stderr,
        )
        sys.exit(2)

    print(f"Found note: {title} (ID: {pk})", file=sys.stderr)

    # Parse the note content using protobuf
    text, runs = parse_note_content(compressed_data)

    if not text:
        print("Failed to parse note content", file=sys.stderr)
        sys.exit(1)

    # Resolve human-readable labels for embedded objects (attachments, files, ...).
    identifiers = [r["attachment"]["identifier"] for r in runs if r.get("attachment")]
    attachment_labels = get_attachment_labels(identifiers)

    # A note link, a hashtag and a mention all store their target here. Only
    # the ones that parse as a URI become links.
    attachment_links = get_attachment_links(identifiers)

    # Tables carry their cells in a separate blob, and the labels resolve any
    # note link, hashtag or mention sitting inside a cell.
    tables = get_note_tables(identifiers, attachment_labels, attachment_links)

    # Apply formatting (highlights, links, embedded objects)
    formatted_text = apply_formatting(text, runs, attachment_labels, tables,
                                      attachment_links)

    # Format as markdown
    markdown = format_as_markdown(title, formatted_text)

    # Output to stdout or file
    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(markdown)
        print(f"Exported to: {args.output}", file=sys.stderr)
    else:
        print(markdown)


def cmd_get_url(args):
    """Handle get-url command"""
    result = find_note(args.identifier)

    if not result:
        print(f"Note not found: {args.identifier}", file=sys.stderr)
        sys.exit(1)

    pk, title, identifier, _, locked = result

    if not identifier:
        print(f"Note has no identifier: {title}", file=sys.stderr)
        sys.exit(1)

    # A deep link to a locked note still works — Notes.app prompts for the
    # password — so this is reported, not refused.
    url = f"applenotes://note/{identifier}"
    if getattr(args, "json", False):
        payload = {"id": pk, "title": title, "url": url}
        if locked:
            payload["locked"] = True
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        if locked:
            print("note: this note is password-protected; opening it will "
                  "prompt for the password", file=sys.stderr)
        print(url)


# --------------------------------------------------------------------------- #
# Call recordings and voice memos.
#
# The audio, its transcript and Apple's summary are NOT in the note body — the
# body holds only an attachment placeholder, so `export` shows nothing useful.
# They live in the attachment's ZMERGEABLEDATA1 blob. See mergeable.py.
# --------------------------------------------------------------------------- #


def _clock(seconds):
    """m:ss, or h:mm:ss past an hour."""
    seconds = int(seconds)
    if seconds >= 3600:
        return "%d:%02d:%02d" % (seconds // 3600, (seconds % 3600) // 60, seconds % 60)
    return "%d:%02d" % (seconds // 60, seconds % 60)


def _load_recording(identifier):
    """Resolve a note and return (pk, title, recording).

    Exits with a message rather than a traceback for the three ways this goes
    wrong: no such note, a note with no recording on it, and a recording whose
    transcript has not been generated.
    """
    result = find_note(identifier)
    if not result:
        print("Note not found: %s" % identifier, file=sys.stderr)
        sys.exit(1)

    pk, title, _, _, locked = result
    if locked:
        print("Note %d is password-protected; its attachments cannot be read."
              % pk, file=sys.stderr)
        sys.exit(2)

    recordings = recordings_for_note(get_db_path(), pk)
    if not recordings:
        print("Note %d (%s) has no audio recording attached.\n"
              "Call recordings and voice memos live on the note as an "
              "attachment; this note has none." % (pk, title), file=sys.stderr)
        sys.exit(1)

    if len(recordings) > 1:
        print("note: this note carries %d recordings; using the first"
              % len(recordings), file=sys.stderr)
    return pk, title, recordings[0]


def _matches(recording, term, include_transcript=False):
    """Substring match, AND of terms — the same semantics as `mail search`."""
    if not term:
        return True
    parts = [recording.note_id, recording.note_title, recording.title,
             recording.local_handle, recording.remote_handle,
             recording.top_line_summary, recording.summary]
    if include_transcript:
        parts.extend(s.text for s in recording.segments)
    haystack = " ".join(str(v) for v in parts if v).lower()
    return all(word in haystack for word in term.lower().split())


def cmd_recordings(args):
    """List every audio recording in the store."""
    # Segments are only decoded when the search needs them: it is the bulk of
    # the work and scales with recording length, so a plain listing skips it.
    want_transcripts = bool(args.transcripts and args.search)
    found = all_recordings(get_db_path(), with_segments=want_transcripts)

    if args.calls_only:
        found = [r for r in found if r.is_call]
    found = [r for r in found if _matches(r, args.search, want_transcripts)]
    if args.limit:
        found = found[:args.limit]

    if args.json:
        payload = []
        for r in found:
            entry = {
                "note_id": r.note_id,
                "note_title": r.note_title,
                "attachment_id": r.attachment_id,
                "title": r.title,
                "is_call": r.is_call,
                "duration": r.audio_duration,
                "file_size": r.file_size,
                "local_handle": r.local_handle,
                "remote_handle": r.remote_handle,
                "call_type": r.call_type,
                "top_line_summary": r.top_line_summary,
                "summary": r.summary,
            }
            if r.start_time:
                entry["start_time"] = datetime.datetime.fromtimestamp(
                    r.start_time).isoformat()
            payload.append(entry)
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return

    if not found:
        print("No recordings found." if args.search or args.calls_only
              else "No audio recordings in this Notes store.")
        return

    header = "%5s  %-16s %7s  %-14s %-14s %s" % (
        "ID", "WHEN", "LENGTH", "YOU", "OTHER PARTY", "SUMMARY")
    print(Style.dim(header))
    print(Style.dim("-" * 118))
    for r in found:
        when = ""
        if r.start_time:
            when = datetime.datetime.fromtimestamp(r.start_time).strftime(
                "%Y-%m-%d %H:%M")
        elif r.created:
            when = datetime.datetime.fromtimestamp(r.created).strftime(
                "%Y-%m-%d %H:%M")
        length = _clock(r.audio_duration) if r.audio_duration else "-"
        # A non-call recording has no handles at all; leave the columns empty
        # rather than printing a placeholder that reads like a failed lookup.
        summary = r.top_line_summary or r.summary or r.note_title or ""
        print("%s  %-16s %7s  %-14s %-14s %s" % (
            Style.identifier("%5d" % r.note_id),
            when, length,
            r.local_handle or "", r.remote_handle or "",
            Style.title(summary[:48])))

    # ⚠️ LENGTH is how long the RECORDING ran, which is not how long the call
    # lasted: recording can be started at any point, and stops when it is
    # stopped. Said once here so a short length is not read as a short call.
    # stdout is flushed first — otherwise this unbuffered stderr line lands
    # above the buffered table when either is redirected.
    sys.stdout.flush()
    print(Style.dim("\nLENGTH is the recorded audio, not the full call — "
                    "recording can start mid-call."), file=sys.stderr)


def cmd_transcript(args):
    """Print a recording's transcript."""
    pk, title, rec = _load_recording(args.identifier)

    if not rec.segments:
        # A recording with no segments is the normal state when Apple
        # Intelligence never transcribed it — not a decode failure.
        print("Recording on note %d has no transcript.\n"
              "Transcription is generated on-device by Apple Intelligence; a "
              "device without it, or an unsupported language, records audio "
              "only." % pk, file=sys.stderr)
        sys.exit(1)

    turns = rec.turns()

    if args.json:
        payload = {
            "note_id": pk,
            "note_title": title,
            "attachment_id": rec.attachment_id,
            "duration": rec.audio_duration,
            "is_call": rec.is_call,
            "local_handle": rec.local_handle,
            "remote_handle": rec.remote_handle,
            "top_line_summary": rec.top_line_summary,
            "summary": rec.summary,
            "segment_count": len(rec.segments),
        }
        if rec.start_time:
            payload["start_time"] = datetime.datetime.fromtimestamp(
                rec.start_time).isoformat()
        if args.words:
            payload["segments"] = [
                {"speaker": s.speaker, "text": s.text,
                 "timestamp": s.timestamp, "duration": s.duration}
                for s in rec.segments
            ]
        else:
            payload["turns"] = turns
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return

    lines = ["# %s" % (rec.title or title)]
    if rec.start_time:
        lines.append("")
        lines.append(datetime.datetime.fromtimestamp(rec.start_time)
                     .strftime("%Y-%m-%d %H:%M"))
    if rec.top_line_summary:
        lines.append("")
        lines.append("**Summary:** %s" % rec.top_line_summary)
    if rec.is_call:
        lines.append("")
        lines.append("- you: `%s`" % rec.local_handle)
        lines.append("- other party: `%s`" % rec.remote_handle)
    lines.append("")
    lines.append("---")
    lines.append("")

    for turn in turns:
        # A recording with no speakers (a voice memo, an imported file) gets
        # no name prefix — see Recording.speaker_label.
        stamp = "" if args.no_timestamps else "[%s] " % _clock(turn["start"])
        if turn["label"]:
            lines.append("**%s%s:** %s" % (stamp, turn["label"], turn["text"]))
        elif stamp:
            lines.append("**%s** %s" % (stamp.rstrip(), turn["text"]))
        else:
            lines.append(turn["text"])
        lines.append("")

    text = "\n".join(lines).rstrip() + "\n"
    if args.output:
        with open(args.output, "w", encoding="utf-8") as handle:
            handle.write(text)
        print("Wrote transcript to: %s" % args.output, file=sys.stderr)
    else:
        sys.stdout.write(text)


def cmd_summary(args):
    """Print Apple's generated summary of a recording."""
    pk, title, rec = _load_recording(args.identifier)

    if args.json:
        payload = {
            "note_id": pk,
            "note_title": title,
            "attachment_id": rec.attachment_id,
            "top_line_summary": rec.top_line_summary,
            "summary": rec.summary,
            "duration": rec.audio_duration,
            "is_call": rec.is_call,
            "segment_count": len(rec.segments),
        }
        if rec.start_time:
            payload["start_time"] = datetime.datetime.fromtimestamp(
                rec.start_time).isoformat()
        print(json.dumps(payload, indent=2, ensure_ascii=False))
        return

    # ⚠️ `summary` is frequently absent while `topLineSummary` is present —
    # report which one is missing rather than printing an empty line.
    if not rec.top_line_summary and not rec.summary:
        print("Recording on note %d has no summary.\n"
              "Summaries are generated on-device by Apple Intelligence."
              % pk, file=sys.stderr)
        sys.exit(1)

    if rec.top_line_summary:
        print(rec.top_line_summary)
    if rec.summary and rec.summary != rec.top_line_summary:
        print()
        print(rec.summary)


# --------------------------------------------------------------------------- #
# Writes.
#
# These hide a wart in the Shortcuts layer: Create takes plain Markdown as its
# input while Append needs a JSON object naming the target, and `shortcuts run`
# types its input by FILE EXTENSION — .md/.txt/.text deliver, .json is dropped
# silently and the run exits 0 having done nothing. Callers should not have to
# know any of that, so the payload shape and the extension are chosen here.
#
# Body input follows the same convention as `apple mail draft`:
#   --body TEXT        literal
#   --body-file FILE   from a file
#   --body-file -      from stdin
# --------------------------------------------------------------------------- #


def read_body(args):
    """Resolve the body from --body, --body-file, or stdin."""
    if args.body is not None and args.body_file is not None:
        print("error: pass --body or --body-file, not both", file=sys.stderr)
        sys.exit(2)
    if args.body is not None:
        return args.body
    if args.body_file == "-":
        return sys.stdin.read()
    if args.body_file:
        try:
            with open(args.body_file, "r", encoding="utf-8") as f:
                return f.read()
        except OSError as exc:
            print("error: cannot read %s: %s" % (args.body_file, exc), file=sys.stderr)
            sys.exit(1)
    if not sys.stdin.isatty():          # piped input with no flag
        return sys.stdin.read()
    print("error: no body given — use --body, --body-file, or pipe stdin",
          file=sys.stderr)
    sys.exit(2)


def require_shortcuts():
    """Refuse early, with the fix, rather than failing obscurely mid-write."""
    sc = shortcuts_status()
    if sc["available"]:
        return
    detail = sc.get("reason") or "missing: %s" % ", ".join(sc["missing"])
    print("error: the Notes write path is unavailable — %s" % detail, file=sys.stderr)
    print("       Run `apple notes install-shortcuts`.", file=sys.stderr)
    sys.exit(1)


def fail_write(what, title):
    """Exit non-zero after a write the store could not corroborate.

    🛑 `shortcuts run` exits 0 whether or not the shortcut did anything, so its
    return code proves nothing. Every write here is confirmed by re-reading the
    store, the same discipline `apple calendar` and `apple contacts` use.

    The most common cause is a missing permission grant, which is invisible
    from the run itself, so it is named here rather than left to be guessed.
    """
    print("error: the shortcut ran but %s (%r)." % (what, title), file=sys.stderr)
    print("       `shortcuts run` exits 0 whether or not it did anything, so "
          "this is the only signal.", file=sys.stderr)
    print("       Run the shortcut by hand to see whether it asks for "
          "permission: `shortcuts run \"%s\" --input-path <file.md>`"
          % sorted(SHORTCUTS)[0], file=sys.stderr)
    sys.exit(1)


def run_shortcut(name, payload, suffix):
    """Run a shortcut with `payload` as its input.

    `suffix` matters: `shortcuts run --input-path` types the input from the file
    extension, and anything outside the shortcut's declared input classes is
    dropped without an error. Always .md or .txt here — never .json.
    """
    import tempfile
    with tempfile.NamedTemporaryFile("w", suffix=suffix, delete=False,
                                     encoding="utf-8") as f:
        f.write(payload)
        path = f.name
    try:
        proc = subprocess.run(["shortcuts", "run", name, "--input-path", path],
                              capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        print("error: `%s` timed out after 120s." % name, file=sys.stderr)
        print("       A hang usually means the shortcut is waiting on a "
              "permission dialog — check Shortcuts.app.", file=sys.stderr)
        sys.exit(1)
    finally:
        try:
            os.unlink(path)
        except OSError:
            pass
    if proc.returncode != 0:
        print("error: `%s` failed: %s" % (name, proc.stderr.strip()), file=sys.stderr)
        sys.exit(1)


def note_pks_titled(title):
    """Every live note Z_PK with exactly this title."""
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        return [r[0] for r in conn.execute(
            "SELECT n.Z_PK FROM ZICCLOUDSYNCINGOBJECT n "
            "LEFT JOIN ZICCLOUDSYNCINGOBJECT f ON n.ZFOLDER = f.Z_PK "
            "WHERE n.ZTITLE1 = ? AND n.ZMARKEDFORDELETION = 0 "
            "AND COALESCE(f.ZTITLE2, '') != 'Recently Deleted'", (title,)).fetchall()]
    finally:
        conn.close()


# Apple epoch (2001-01-01) to Unix epoch, seconds. ZCREATIONDATE3 is in these.
APPLE_EPOCH_OFFSET = 978307200


def note_created_since(when):
    """The newest live note created at or after `when` (Apple-epoch seconds)."""
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        row = conn.execute(
            "SELECT n.Z_PK, n.ZTITLE1 FROM ZICCLOUDSYNCINGOBJECT n "
            "LEFT JOIN ZICCLOUDSYNCINGOBJECT f ON n.ZFOLDER = f.Z_PK "
            "WHERE n.ZCREATIONDATE3 >= ? AND n.ZTITLE1 IS NOT NULL "
            "AND n.ZMARKEDFORDELETION = 0 "
            "AND COALESCE(f.ZTITLE2, '') != 'Recently Deleted' "
            "ORDER BY n.ZCREATIONDATE3 DESC LIMIT 1", (when,)).fetchone()
        return (row[0], row[1]) if row else (None, None)
    finally:
        conn.close()


def cmd_create(args):
    """Create a note from Markdown. Checklists and tables come out native."""
    require_shortcuts()
    body = read_body(args)
    if args.title:
        body = "%s\n\n%s" % (args.title, body.lstrip("\n"))
    # The first line becomes the note's title either way — that is Notes'
    # behaviour on every write, not something this adds.
    requested = body.splitlines()[0].strip() if body.strip() else ""

    # 🛑 **Confirm by creation time, never by title.** The shortcut interprets
    # the body as Markdown, so Apple rewrites the first line before it becomes
    # the title: `__name__` is bold, and the note lands titled `name`. Matching
    # on the title we sent therefore reported `created: false` for a note that
    # had been created correctly — and every run of this tool's own test suite
    # hit it, because the fixture prefix `__claude_notes_test__` is itself bold.
    started = time.time() - APPLE_EPOCH_OFFSET
    run_shortcut("Apple Tools Create Note", body, ".md")

    # Verify through the store, never through AppleScript.
    pk = title = None
    for _ in range(20):
        pk, title = note_created_since(started)
        if pk:
            break
        time.sleep(0.5)

    if args.json:
        out = {"created": pk is not None, "title": title or requested}
        if pk:
            out["id"] = pk
            # ⚠️ Report what the store holds, not what was asked for. They
            # differ whenever the first line carries Markdown.
            if title != requested:
                out["requested_title"] = requested
        print(json.dumps(out, indent=2, ensure_ascii=False))
    elif pk:
        print("Created note %d: %s" % (pk, title))
        if title != requested:
            print("note: Notes interpreted the first line as Markdown, so the "
                  "title is %r, not %r." % (title, requested), file=sys.stderr)

    # 🛑 A write that did nothing must not exit 0. Nothing else signals failure:
    # `shortcuts run` exits 0 whether or not the shortcut did anything.
    if pk is None:
        fail_write("no new note appeared", requested)


def cmd_append(args):
    """Append Markdown to an existing note, preserving attachments and checklists."""
    require_shortcuts()
    body = read_body(args)

    found = find_note(args.identifier)
    if not found:
        print("Note not found: %s" % args.identifier, file=sys.stderr)
        sys.exit(1)
    pk, title, _ident, _data, locked = found
    if locked:
        print("error: note %d is password-protected and cannot be written."
              % pk, file=sys.stderr)
        sys.exit(2)
    if not title:
        print("error: note %d has no title, and the write path targets a note "
              "by title." % pk, file=sys.stderr)
        sys.exit(1)

    # 🛑 **The shortcut matches the target by Name, and a name that matches
    # nothing does not fail — Shortcuts opens a NOTE PICKER listing every note
    # and waits for a human.** Whatever they pick receives the text. Measured:
    # four queued appends all landed on one note chosen minutes later, and the
    # note the caller asked for was in Recently Deleted the whole time.
    #
    # ⚠️ `shortcuts run` still returns in ~2s while that picker is open, so the
    # exit code and the elapsed time both look like success. There is no signal
    # after the fact. The only safe move is to refuse before running it.
    #
    # `note_pks_titled` counts live notes only, so a target in Recently Deleted
    # comes back as zero matches. Refusing on zero is what stops a write from
    # being redirected onto one of the user's real notes.
    matches = note_pks_titled(title)
    if pk not in matches:
        print("error: note %d (%r) is not a live note, so there is nothing to "
              "append to." % (pk, title), file=sys.stderr)
        print("       It is in Recently Deleted, or its title changed since it "
              "was looked up.", file=sys.stderr)
        print("       Refusing to run the shortcut: with no target it opens a "
              "note picker, and whatever", file=sys.stderr)
        print("       is chosen receives the text.", file=sys.stderr)
        sys.exit(1)

    # Names are not unique. Appending to every match would be a silent,
    # unrecoverable mistake, so refuse — the same rule `apple messages` applies
    # to an ambiguous chat reference.
    if len(matches) > 1:
        print("error: %d notes are titled %r; refusing to append to all of them."
              % (len(matches), title), file=sys.stderr)
        print("       ids: %s" % ", ".join(str(m) for m in sorted(matches)),
              file=sys.stderr)
        print("       Rename one in Notes.app, then retry.", file=sys.stderr)
        sys.exit(1)

    # Read the body BEFORE the write, so the confirmation below can compare.
    before_text = sqlite_text_for(pk)

    payload = json.dumps({"note": title, "text": body})
    run_shortcut("Apple Tools Append Note", payload, ".txt")

    # 🛑 **Confirm that the note CHANGED, never that it contains what we sent.**
    # The shortcut interprets the body as Markdown, so Apple rewrites it before
    # storing: `- [x] item` lands as `item`, `## head` as `head`, and a pipe
    # table as a single U+FFFC. Matching the first line we sent therefore
    # reported failure for appends that worked perfectly — six of them in the
    # first run of tests/test_append.py. Same trap `create` had with titles.
    landed = False
    for _ in range(20):
        if sqlite_text_for(pk) != before_text:
            landed = True
            break
        time.sleep(0.5)

    if args.json:
        print(json.dumps({"appended": landed, "id": pk, "title": title},
                         indent=2, ensure_ascii=False))
    elif landed:
        print("Appended to note %d: %s" % (pk, title))

    if not landed:
        fail_write("the text did not appear on the note", title)


RECENTLY_DELETED = "Recently Deleted"


def store_uuid():
    """The Core Data store UUID that AppleScript note ids are built from.

    An AppleScript note id is `x-coredata://<UUID>/ICNote/p<Z_PK>`, and the UUID
    is `Z_METADATA.Z_UUID` in the same file the reader already opens. Verified
    equal on this store.

    🛑 That join is the whole reason `delete` is safe. It addresses a note by
    primary key, so the name matching that forces `append` to refuse an
    ambiguous title cannot arise here at all.
    """
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        row = conn.execute("SELECT Z_UUID FROM Z_METADATA").fetchone()
    except sqlite3.Error:
        return None
    finally:
        conn.close()
    value = row[0] if row else None
    if not value or not re.fullmatch(r"[0-9A-Fa-f-]{36}", value):
        return None
    return value


def note_state(pk):
    """(title, folder, marked_for_deletion, locked) for a Z_PK, or None."""
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        row = conn.execute(
            "SELECT n.ZTITLE1, COALESCE(f.ZTITLE2, ''), "
            "COALESCE(n.ZMARKEDFORDELETION, 0), "
            "COALESCE(n.ZISPASSWORDPROTECTED, 0) "
            "FROM ZICCLOUDSYNCINGOBJECT n "
            "LEFT JOIN ZICCLOUDSYNCINGOBJECT f ON n.ZFOLDER = f.Z_PK "
            "WHERE n.Z_PK = ?", (pk,)).fetchone()
    finally:
        conn.close()
    return tuple(row) if row else None


def note_is_live(pk):
    """True while a note is still in a normal folder."""
    state = note_state(pk)
    if state is None:
        return False
    _title, folder, marked, _locked = state
    return not marked and folder != RECENTLY_DELETED


def resolve_delete_target(identifier):
    """Every LIVE note Z_PK this identifier names. Exact titles only.

    🛑 `find_note` falls through to `LIKE '%term%'` and returns the FIRST row it
    finds. That is right for `export`, which reads, and wrong for a delete:
    `delete budget` would destroy whichever of several notes sqlite happened to
    return first, and say nothing. So a title here must match in full, and more
    than one match is refused rather than picked between.
    """
    if identifier.isdigit() or identifier.startswith("applenotes://"):
        found = find_note(identifier)
        return [found[0]] if found else []
    return sorted(note_pks_titled(identifier))


def applescript_delete(pk, uuid):
    """Move one note to Recently Deleted, addressed by its primary key.

    🛑 **No third Shortcut is needed for this.** AppleScript `delete` works
    today, and the test harness has used it since the suite was written. It
    costs a build, a signing step and a permission dialog to reimplement.

    ⚠️ It needs Automation -> Notes for the calling terminal, and it LAUNCHES
    Notes.app if the app is closed. Reads need neither.
    """
    note_id = "x-coredata://%s/ICNote/p%d" % (uuid, pk)
    script = 'tell application "Notes" to delete note id "%s"' % note_id
    try:
        return subprocess.run(["osascript", "-e", script],
                              capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        print("error: the delete timed out after 120s.", file=sys.stderr)
        print("       Notes.app may be waiting on a permission dialog.",
              file=sys.stderr)
        sys.exit(1)


def applescript_note_deleted(pk, uuid):
    """Ask Notes.app whether a note is in Recently Deleted.

    Returns "deleted", "live", or None when Notes could not answer.

    🛑 **This is the authoritative answer, and the sqlite store is not.**
    Measured on this machine: a note Notes.app already listed in Recently
    Deleted still had `ZFOLDER` pointing at `Notes` in the store more than ten
    minutes later, while another delete showed up in the store in 3.5 seconds.
    The lag is unbounded in practice, so a store read alone cannot tell a slow
    delete from a failed one.

    ⚠️ `container of note id …` does NOT work here. It fails with -1728 for a
    deleted note AND for a live one, so it distinguishes nothing. Enumerating
    the Recently Deleted folder and asking for the id does work, in about 0.7s.
    """
    script = (
        'set target to "x-coredata://%s/ICNote/p%d"\n'
        'tell application "Notes"\n'
        '  repeat with acc in accounts\n'
        '    repeat with f in folders of acc\n'
        '      if name of f is "Recently Deleted" then\n'
        '        if (count of (notes of f whose id is target)) > 0 then '
        'return "deleted"\n'
        '      end if\n'
        '    end repeat\n'
        '  end repeat\n'
        '  return "live"\n'
        'end tell' % (uuid, pk))
    try:
        proc = subprocess.run(["osascript", "-e", script],
                              capture_output=True, text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return None
    if proc.returncode != 0:
        return None
    answer = proc.stdout.strip()
    return answer if answer in ("deleted", "live") else None


def cmd_delete(args):
    """Move a note to Recently Deleted. Recoverable for about 30 days."""
    matches = resolve_delete_target(args.identifier)

    if not matches:
        print("Note not found: %s" % args.identifier, file=sys.stderr)
        print("       A title must match in full. `delete` does not take a "
              "partial title the way `export` does,", file=sys.stderr)
        print("       and it only ever names live notes.", file=sys.stderr)
        sys.exit(1)

    # Names are not unique, and deleting every match would be a silent mistake.
    # Same rule `append` applies, and the same rule `apple messages` applies to
    # an ambiguous chat reference.
    if len(matches) > 1:
        print("error: %d live notes are titled %r; refusing to delete all of "
              "them." % (len(matches), args.identifier), file=sys.stderr)
        for pk in matches:
            state = note_state(pk)
            print("       %d  in %s" % (pk, (state[1] if state else "?") or "?"),
                  file=sys.stderr)
        print("       Pass the id of the one you mean.", file=sys.stderr)
        sys.exit(1)

    pk = matches[0]
    state = note_state(pk)
    if state is None:
        print("error: note %d is not in the store." % pk, file=sys.stderr)
        sys.exit(1)
    title, folder, marked, locked = state

    # ⚠️ A locked note has no readable body, so the user cannot be shown what
    # they are about to destroy. `export` refuses it with exit 2 for the same
    # reason; this keeps the code consistent. Delete it in Notes.app.
    if locked:
        print("error: note %d (%r) is password-protected, so its contents "
              "cannot be shown." % (pk, title), file=sys.stderr)
        print("       Refusing to delete a note nobody can read first. Delete "
              "it in Notes.app.", file=sys.stderr)
        sys.exit(2)

    if marked or folder == RECENTLY_DELETED:
        print("error: note %d (%r) is already in Recently Deleted."
              % (pk, title), file=sys.stderr)
        print("       There is no API to empty that folder. It purges itself "
              "in about 30 days.", file=sys.stderr)
        sys.exit(1)

    uuid = store_uuid()
    if uuid is None:
        print("error: cannot read the Core Data store UUID (Z_METADATA.Z_UUID).",
              file=sys.stderr)
        print("       Without it a note cannot be addressed by id, and this "
              "command will not fall back to", file=sys.stderr)
        print("       matching by name.", file=sys.stderr)
        sys.exit(1)

    if not args.yes:
        # ⚠️ Never assume consent from a pipe. An agent running this command
        # unattended must pass --yes deliberately.
        if not sys.stdin.isatty():
            print("error: refusing to delete without confirmation. Pass --yes.",
                  file=sys.stderr)
            sys.exit(1)
        print("Delete note %d: %s" % (pk, title or "(untitled)"))
        print("  folder: %s" % (folder or "?"))
        print("  It moves to Recently Deleted and purges itself in ~30 days.")
        try:
            answer = input("Delete it? [y/N] ")
        except (EOFError, KeyboardInterrupt):
            answer = ""
            print()
        if answer.strip().lower() not in ("y", "yes"):
            if args.json:
                print(json.dumps({"deleted": False, "cancelled": True,
                                  "id": pk, "title": title},
                                 indent=2, ensure_ascii=False))
            else:
                print("Cancelled.", file=sys.stderr)
            sys.exit(1)

    proc = applescript_delete(pk, uuid)
    if proc.returncode != 0:
        err = proc.stderr.strip()
        print("error: Notes refused the delete: %s" % err, file=sys.stderr)
        if "-1743" in err or "not authorized" in err.lower():
            print("       Deleting needs Automation -> Notes for this terminal. "
                  "Reads do not.", file=sys.stderr)
        sys.exit(1)

    # 🛑 **`osascript` exiting 0 is not evidence the note moved**, the same way
    # `shortcuts run` exiting 0 is not evidence a note was written. Confirm it.
    #
    # ⚠️ **Ask Notes.app, not the store.** The store lags an unbounded amount:
    # measured here, one delete appeared in sqlite in 3.5s and another was still
    # in `ZFOLDER` = `Notes` more than ten minutes after Notes.app had already
    # listed it in Recently Deleted. A store read alone cannot tell a slow
    # delete from a failed one, so it must not be the deciding signal.
    state = applescript_note_deleted(pk, uuid)

    if state == "live":
        print("error: Notes accepted the delete and note %d (%r) is still in "
              "its folder." % (pk, title), file=sys.stderr)
        print("       Nothing was deleted. Try again, or delete it in "
              "Notes.app.", file=sys.stderr)
        sys.exit(1)

    # The store is reported separately, because a caller that goes on to read
    # the store needs to know whether it has caught up. `--wait` is how long to
    # give it; the default is 0, since the answer above is already authoritative.
    store_confirmed = False
    deadline = time.time() + max(0.0, args.wait)
    while True:
        if not note_is_live(pk):
            store_confirmed = True
            break
        if time.time() >= deadline:
            break
        time.sleep(0.5)

    if args.json:
        print(json.dumps({"deleted": True,
                          "confirmed": state == "deleted",
                          "store_confirmed": store_confirmed,
                          "id": pk, "title": title, "folder": folder},
                         indent=2, ensure_ascii=False))
    else:
        print("Deleted note %d: %s" % (pk, title or "(untitled)"))

    # Flush before the stderr notes, so a piped run keeps the two in order.
    sys.stdout.flush()

    if state is None:
        print("note: Notes.app could not say whether note %d moved, so the "
              "delete is unconfirmed." % pk, file=sys.stderr)
    if not store_confirmed:
        print("note: the sqlite store still shows note %d in %r. It settles "
              "over minutes and this is normal," % (pk, folder), file=sys.stderr)
        print("      not a failure. Pass --wait to give it longer.",
              file=sys.stderr)
    # ⚠️ The reader can see Recently Deleted, so a search straight after a
    # delete still lists the note and reads as a failure.
    print("note: it is in Recently Deleted, which `apple notes search` still "
          "lists.", file=sys.stderr)


def sqlite_text_for(pk):
    """Decoded note text for a Z_PK, or None."""
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        row = conn.execute(
            "SELECT ZDATA FROM ZICNOTEDATA WHERE ZNOTE = ? AND ZDATA IS NOT NULL",
            (pk,)).fetchone()
    finally:
        conn.close()
    if not row or not row[0]:
        return None
    try:
        text, _runs = parse_note_content(row[0])
    except Exception:
        return None
    return text


def main():
    parser = argparse.ArgumentParser(
        prog="apple-notes",
        description="Apple Notes CLI - search, export, and get URLs",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Protobuf definitions from:
  https://github.com/threeplanetssoftware/apple_cloud_notes_parser

Examples:
    apple-notes search                     # List recent notes
    apple-notes search "meeting"           # Search by title
    apple-notes folders                    # List all folders
    apple-notes folders Piano              # List notes in Piano folder
    apple-notes export 261                 # Export note ID 261 to stdout
    apple-notes export "My Note" -o out.md # Export to file
    apple-notes get-url 261                # Get applenotes:// URL
    apple-notes recordings                 # Table of every recording
    apple-notes recordings verizon --transcripts   # Search inside transcripts
    apple-notes transcript 11426           # Transcript of a call recording
    apple-notes summary 11426              # Apple's summary of it
    apple-notes delete 261                 # Move note 261 to Recently Deleted
        """,
    )

    parser.add_argument(
        "--version", action="version", version=f"apple-notes {__version__}"
    )

    subparsers = parser.add_subparsers(dest="command", help="Command")

    # search command
    search_parser = subparsers.add_parser("search", help="Search notes by title")
    search_parser.add_argument(
        "term", nargs="*", help="Search term (optional, lists recent if omitted)"
    )
    search_parser.add_argument(
        "--limit", "-n", type=int, default=50, help="Max results (default: 50)"
    )
    search_parser.add_argument("--json", action="store_true", help="Output as JSON")
    search_parser.add_argument(
        "--include-locked",
        action="store_true",
        help="List password-protected notes too (their contents stay unreadable)",
    )

    # folders command
    folders_parser = subparsers.add_parser(
        "folders", help="List folders or search notes in a folder"
    )
    folders_parser.add_argument(
        "name", nargs="*", help="Folder name (optional, lists all folders if omitted)"
