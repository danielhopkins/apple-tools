def get_db_path():
    """Get the Apple Notes database path"""
    return os.path.expanduser(
        "~/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite"
    )


def check_access():
    """Report whether the Notes store is readable.

    There is no API to query Full Disk Access, so this reads the store the same
    way every other command does and reports what happened. A denied read is
    the only reliable signal, and it costs one open() to get.

    Returns (status, usable, advice).
    """
    db_path = get_db_path()
    settings = "System Settings → Privacy & Security → Full Disk Access"

    if not os.path.exists(db_path):
        # A missing store is not a permission problem: FDA denial makes the
        # path unreadable, not absent. Notes has simply never run here.
        return ("noNoteStore", False,
                "No Notes database at %s — open Notes.app once." % db_path)

    try:
        conn = sqlite3.connect("file:%s?mode=ro" % db_path, uri=True)
        try:
            conn.execute("SELECT 1 FROM ZICCLOUDSYNCINGOBJECT LIMIT 1").fetchone()
        finally:
            conn.close()
        return ("authorized", True, None)
    except sqlite3.OperationalError as exc:
        message = str(exc).lower()
        if "unable to open" in message or "authorization denied" in message:
            return ("denied", False,
                    "Grant Full Disk Access to your terminal in %s." % settings)
        return ("unreadable", False, "Could not read the Notes store: %s" % exc)
    except PermissionError:
        return ("denied", False,
                "Grant Full Disk Access to your terminal in %s." % settings)


class _AEDesc(ctypes.Structure):
    _fields_ = [("descriptorType", ctypes.c_uint32), ("dataHandle", ctypes.c_void_p)]


def _fourcc(code):
    return int.from_bytes(code.encode(), "big")


def check_automation():
    """Report Automation → Notes state without requesting it.

    AEDeterminePermissionToAutomateTarget with askUserIfNeeded = false is the
    only way to read this without side effects; sending a real Apple Event to
    find out would trigger the very dialog a status command must not trigger.
    This is the same call `apple mail status` makes, reached through ctypes
    because this tool is Python.

    Returns (status, ok, advice).
    """
    settings = "System Settings → Privacy & Security → Automation"
    try:
        lib = ctypes.cdll.LoadLibrary(
            "/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices"
        )
        lib.AECreateDesc.argtypes = [
            ctypes.c_uint32, ctypes.c_char_p, ctypes.c_long, ctypes.POINTER(_AEDesc)
        ]
        lib.AECreateDesc.restype = ctypes.c_int16
        lib.AEDeterminePermissionToAutomateTarget.argtypes = [
            ctypes.POINTER(_AEDesc), ctypes.c_uint32, ctypes.c_uint32, ctypes.c_bool
        ]
        lib.AEDeterminePermissionToAutomateTarget.restype = ctypes.c_int32
        lib.AEDisposeDesc.argtypes = [ctypes.POINTER(_AEDesc)]

        desc = _AEDesc()
        bundle = b"com.apple.Notes"
        if lib.AECreateDesc(_fourcc("bund"), bundle, len(bundle), ctypes.byref(desc)) != 0:
            return ("unknown", False, None)
        try:
            code = lib.AEDeterminePermissionToAutomateTarget(
                ctypes.byref(desc), _fourcc("****"), _fourcc("****"), False
            )
        finally:
            lib.AEDisposeDesc(ctypes.byref(desc))
    except OSError:
        return ("unknown", False, None)

    if code == 0:
        return ("authorized", True, None)
    if code == -1743:
        return ("denied", False, "Re-enable Notes under %s." % settings)
    if code == -1744:
        return ("notDetermined", False,
                "Run any `apple notes` write once to trigger the prompt.")
    if code == -600:
        return ("notesNotRunning", False,
                "Automation state cannot be read while Notes is not running; "
                "this says nothing about whether the grant exists.")
    return ("unknown(%d)" % code, False, None)


def cmd_status(args):
    """Report both grants. Never prompts — neither check can."""
    status, usable, advice = check_access()
    automation, automation_ok, automation_advice = check_automation()

    if args.json:
        # `usable` tracks reads only, matching what it has always meant and what
        # `apple status` aggregates. Writes are reported alongside rather than
        # folded in, so a read-only setup is not called broken.
        payload = {
            "status": status,
            "usable": usable,
            "full_disk_access": usable,
            "automation": automation,
            "can_write": automation_ok,
        }
        if advice:
            payload["advice"] = advice
        if automation_advice:
            payload["automation_advice"] = automation_advice
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        suffix = "" if usable else "  (cannot read notes)"
        print("Notes access: %s%s" % (status, suffix))
        if advice:
            print(advice)
        print("Automation → Notes: %s%s" % (
            automation, "" if automation_ok else "  (cannot write)"))
        if automation_advice:
            print(automation_advice)


# --------------------------------------------------------------------------- #
# Write path
#
# Reads come from NoteStore.sqlite; writes have to go through AppleScript,
# because there is no supported way to write that store directly and doing it
# anyway would corrupt a database Notes syncs to every device.
#
# Two different grants are therefore involved: Full Disk Access for the reads
# and Automation -> Notes for the writes. `status` reports both.
# --------------------------------------------------------------------------- #

# The only writable properties on a note are `name` and `body`. `container` is
# read-only, so there is no folder-move command here; the sdef offers no `move`
# either. Verified against Notes.sdef on macOS 27.


class AppleScriptError(RuntimeError):
    pass


def run_applescript(script, timeout=60):
    """Run AppleScript, returning trimmed stdout.

    A missing Automation grant surfaces here as a -1743, which is a permission
    problem rather than a bug in the script, so it gets its own message.
    """
    try:
        proc = subprocess.run(
            ["osascript", "-"],
            input=script,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise AppleScriptError(
            "Notes did not respond within %ds. It may be showing a dialog, or "
            "syncing a large account." % timeout
        )
    if proc.returncode != 0:
        message = proc.stderr.strip() or "osascript exit %d" % proc.returncode
        if "-1743" in message or "not allowed" in message.lower():
            raise AppleScriptError(
                "Not permitted to control Notes. Approve this terminal under "
                "System Settings → Privacy & Security → Automation → Notes.\n"
                "  (%s)" % message
            )
        raise AppleScriptError(message)
    return proc.stdout.rstrip("\n")


def applescript_string(value):
    """Quote a Python string as an AppleScript literal.

    Backslashes first, then quotes — the other order double-escapes. AppleScript
    string literals have no escape for a raw newline, so those are re-joined
    with `& return &`, which is what makes multi-line bodies work at all.
    """
    if value is None:
        value = ""
    escaped = value.replace("\\", "\\\\").replace('"', '\\"')
    parts = escaped.split("\n")
    if len(parts) == 1:
        return '"%s"' % parts[0]
    return " & return & ".join('"%s"' % part for part in parts)


def store_uuid():
    """The CoreData store UUID that AppleScript note ids are namespaced by."""
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        row = conn.execute("SELECT Z_UUID FROM Z_METADATA").fetchone()
    finally:
        conn.close()
    if not row or not row[0]:
        raise AppleScriptError("Could not read the Notes store UUID.")
    return row[0]


def applescript_note_id(pk):
    """SQLite Z_PK -> the id AppleScript addresses a note by.

    Verified by round-trip on a real store: the id is
    x-coredata://<store-uuid>/ICNote/p<Z_PK>, and fetching p17 returns exactly
    the note whose Z_PK is 17.
    """
    return "x-coredata://%s/ICNote/p%d" % (store_uuid(), pk)


def note_attachments(pk):
    """Attachments on a note, as [(uti, label)].

    This is the guard for every body write. Attachments hang off
    ZICCLOUDSYNCINGOBJECT.ZNOTE; the UTI matters because "attachment" here
    covers far more than photos — com.apple.notes.table is a table,
    com.apple.drawing.2 a sketch, public.url an inline link preview. All of them
    are destroyed by a body write.
    """
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        rows = conn.execute(
            """
            SELECT ZTYPEUTI, ZFILENAME, ZTITLE, ZALTTEXT, ZURLSTRING
              FROM ZICCLOUDSYNCINGOBJECT
             WHERE ZNOTE = ?
            """,
            (pk,),
        ).fetchall()
    finally:
        conn.close()

    attachments = []
    for uti, filename, title, alt, url in rows:
        label = next(
            (c.strip() for c in (filename, title, alt, url) if c and c.strip()), None
        )
        attachments.append((uti or "unknown", label or describe_uti(uti)))
    return attachments


# Names for the embedded objects that carry no filename of their own. Without
# these a refusal reads "unknown (unknown)", which tells the user nothing about
# what they are about to lose.
UTI_LABELS = {
    "com.apple.notes.table": "a table",
    "com.apple.drawing.2": "a drawing",
    "com.apple.drawing": "a drawing",
    "com.apple.notes.gallery": "an image gallery",
    "com.apple.paper": "a handwriting/paper item",
    "com.apple.paper.doc.scan": "a scanned document",
    "public.url": "an inline link preview",
}


def describe_uti(uti):
    if not uti:
        return "an embedded object"
    return UTI_LABELS.get(uti, uti)


def guard_body_write(pk, title, force, action):
    """Refuse a body write that would destroy attachments.

    🛑 This is the whole reason writing was withheld until now. A note's `body`
    does not include its attachments, so `set body` — and `set body to body &
    ...`, which is how appending works — deletes every one of them. There is no
    attachment-preserving edit path in the API, and no undo: the attachments do
    not go to Recently Deleted, they are simply gone.

    On a real store this is not an edge case. 232 of 928 notes carry at least
    one attachment.
    """
    attachments = note_attachments(pk)
    if not attachments:
        return

    listing = "\n".join(
        "    - %s  (%s)" % (label, uti) for uti, label in attachments[:10]
    )
    if len(attachments) > 10:
        listing += "\n    ... and %d more" % (len(attachments) - 10)

    if not force:
        print(
            "Refusing to %s '%s': it has %d attachment(s), and writing a note's\n"
            "body destroys every one of them. There is no attachment-preserving\n"
            "edit path and no undo — they do not go to Recently Deleted.\n\n"
            "%s\n\n"
            "Edit this note in Notes.app, or pass --force to proceed and lose them."
            % (action, title, len(attachments), listing),
            file=sys.stderr,
        )
        sys.exit(2)

    print(
        "warning: --force given; %s '%s' will destroy %d attachment(s):\n%s"
        % (action, title, len(attachments), listing),
        file=sys.stderr,
    )


def html_escape(text):
    """Escape text destined for a note body, which is HTML."""
    return (
        text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    )


def text_to_note_html(text):
    """Render plain text as the HTML a note body expects.

    Notes wraps a non-HTML body in a <div> of its own, but does not turn blank
    lines into paragraph breaks, so line structure is lost unless it is spelled
    out here.
    """
    lines = text.split("\n")
    return "".join("<div>%s</div>" % (html_escape(line) or "<br>") for line in lines)


def read_body_argument(args):
    """Body text from --body, or --body-file (with '-' meaning stdin)."""
    if getattr(args, "body_file", None):
        if args.body_file == "-":
            return sys.stdin.read()
        with open(args.body_file, "r", encoding="utf-8") as handle:
            return handle.read()
    return args.body or ""


def resolve_note_for_write(identifier):
    """find_note, but erroring the same way for every write command."""
    result = find_note(identifier)
    if not result:
        print("Note not found: %s" % identifier, file=sys.stderr)
        sys.exit(1)
    return result


def note_title_and_folder(pk):
    """Current title and folder name for a note, for reporting after a write."""
    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        row = conn.execute(
            """
            SELECT n.ZTITLE1, f.ZTITLE2
              FROM ZICCLOUDSYNCINGOBJECT n
              LEFT JOIN ZICCLOUDSYNCINGOBJECT f ON f.Z_PK = n.ZFOLDER
             WHERE n.Z_PK = ?
            """,
            (pk,),
        ).fetchone()
    finally:
        conn.close()
    return (row[0] if row else None, row[1] if row else None)


def search_notes(term=None, limit=50):
    """Search notes by title or list recent notes."""
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    if term:
        cursor.execute(
            """
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, n.ZMODIFICATIONDATE1
            FROM ZICCLOUDSYNCINGOBJECT n
            WHERE n.ZTITLE1 IS NOT NULL
            AND n.ZMARKEDFORDELETION = 0
            AND n.ZTITLE1 LIKE ?
            ORDER BY n.ZMODIFICATIONDATE1 DESC
            LIMIT ?
        """,
            (f"%{term}%", limit),
        )
    else:
        cursor.execute(
            """
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, n.ZMODIFICATIONDATE1
            FROM ZICCLOUDSYNCINGOBJECT n
            WHERE n.ZTITLE1 IS NOT NULL
            AND n.ZMARKEDFORDELETION = 0
            ORDER BY n.ZMODIFICATIONDATE1 DESC
            LIMIT ?
        """,
            (limit,),
        )

    results = []
    for row in cursor.fetchall():
        results.append(
            {"pk": row[0], "title": row[1], "identifier": row[2], "modified": row[3]}
        )

    conn.close()
    return results


def list_folders():
    """List all folders in Apple Notes."""
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    cursor.execute(
        """
        SELECT f.Z_PK, f.ZTITLE2, COUNT(n.Z_PK) as note_count
        FROM ZICCLOUDSYNCINGOBJECT f
        LEFT JOIN ZICCLOUDSYNCINGOBJECT n ON n.ZFOLDER = f.Z_PK
            AND n.ZMARKEDFORDELETION = 0
            AND n.ZTITLE1 IS NOT NULL
        WHERE f.ZTITLE2 IS NOT NULL
        AND f.ZMARKEDFORDELETION = 0
        GROUP BY f.Z_PK, f.ZTITLE2
        ORDER BY f.ZTITLE2
    """
    )

    results = []
    for row in cursor.fetchall():
        results.append({"pk": row[0], "title": row[1], "count": row[2]})

    conn.close()
    return results


def search_by_folder(folder_name, limit=100):
    """Search notes in a specific folder."""
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    cursor.execute(
        """
        SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, n.ZMODIFICATIONDATE1, f.ZTITLE2
        FROM ZICCLOUDSYNCINGOBJECT n
        JOIN ZICCLOUDSYNCINGOBJECT f ON n.ZFOLDER = f.Z_PK
        WHERE f.ZTITLE2 LIKE ?
        AND n.ZMARKEDFORDELETION = 0
        AND n.ZTITLE1 IS NOT NULL
        ORDER BY n.ZMODIFICATIONDATE1 DESC
        LIMIT ?
    """,
        (f"%{folder_name}%", limit),
    )

    results = []
    for row in cursor.fetchall():
        results.append(
            {
                "pk": row[0],
                "title": row[1],
                "identifier": row[2],
                "modified": row[3],
                "folder": row[4],
            }
        )

    conn.close()
    return results


def find_note(identifier):
    """Find a note by title, ID, or Apple Notes link"""
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    # Check if it's a numeric ID
    if identifier.isdigit():
        cursor.execute(
            """
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA
            FROM ZICCLOUDSYNCINGOBJECT n
            JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
            WHERE n.Z_PK = ?
        """,
            (int(identifier),),
        )
    # Check if it's an Apple Notes link (applenotes://...)
    elif identifier.startswith("applenotes://"):
        match = re.search(r"applenotes://[^/]+/([^/]+)", identifier)
        if match:
            note_id = match.group(1)
            cursor.execute(
                """
                SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA
                FROM ZICCLOUDSYNCINGOBJECT n
                JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
                WHERE n.ZIDENTIFIER = ?
            """,
                (note_id,),
            )
        else:
            conn.close()
            return None
    else:
        # Search by title (exact match first, then partial)
        cursor.execute(
            """
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA
            FROM ZICCLOUDSYNCINGOBJECT n
            JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
            WHERE n.ZTITLE1 = ?
        """,
            (identifier,),
        )

        result = cursor.fetchone()
        if not result:
            # Try partial match
            cursor.execute(
                """
                SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA
                FROM ZICCLOUDSYNCINGOBJECT n
                JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
                WHERE n.ZTITLE1 LIKE ?
            """,
                (f"%{identifier}%",),
            )

    result = cursor.fetchone()
    conn.close()
    return result


def is_highlight_color(color):
    """Check if a color represents a highlight (yellow-ish background)."""
    if color is None:
        return False
    # Apple Notes uses yellow highlight: high red, high green, low blue
    # Typical values: red~1.0, green~0.95, blue~0.55, alpha~1.0
    return (
        color.red > 0.9
        and color.green > 0.8
        and color.blue < 0.7
        and color.alpha > 0.5
    )


def parse_note_content(compressed_data):
    """Parse the note content and extract text with formatting.

    Field numbers below come from notestore.proto:
      Note.note_text = 2, Note.attribute_run = 5
      AttributeRun: length=1 paragraph_style=2 font_weight=5 underlined=6
                    strikethrough=7 link=9 color=10 attachment_info=12
      ParagraphStyle: style_type=1 indent_amount=4 checklist=5
      Checklist.done = 2, AttachmentInfo: identifier=1 type_uti=2
    """
    # Decompress the gzipped protobuf data
    data = gzip.decompress(compressed_data)

    note = parse_note_store(data)
    if note is None:
        return None, []

    text = note.string(2, "")

    # Extract formatting runs with all attributes
    runs = []
    for attr_run in note.messages(5):
        color = attr_run.message(10)
        is_highlight = is_highlight_color(Color(color)) if color is not None else False
        link = attr_run.string(9)

        # Paragraph style info
        para_style = None
        ps = attr_run.message(2)
        if ps is not None:
            checklist = ps.message(5)
            para_style = {
                "style_type": ps.int32(1, -1),  # proto default is -1
                "indent": ps.int32(4, 0),
                "checklist": {"done": checklist.int32(2)} if checklist is not None else None,
            }

        # Embedded object info (dividers, tables, files, images, ...). These occupy
        # a single U+FFFC object-replacement char in the text; the type comes from
        # the protobuf and a human-readable name is resolved later from the DB.
        attachment = None
        ai = attr_run.message(12)
        if ai is not None:
            attachment = {
                "type_uti": ai.string(2),
                "identifier": ai.string(1),
            }

        font_weight = attr_run.int32(5)
        runs.append({
            "length": attr_run.int32(1),
            "highlight": is_highlight,
            "link": link,
            "underlined": attr_run.int32(6, 0),
            "strikethrough": attr_run.int32(7, 0),
            "bold": font_weight == 1 if font_weight else False,
            "paragraph_style": para_style,
            "attachment": attachment,
        })

    return text, runs


# A single U+FFFC object-replacement char marks each embedded object in note text.
OBJECT_REPLACEMENT_CHAR = "￼"
# Notes encodes a horizontal-rule / divider as an inline-text attachment.
DIVIDER_UTI = "com.apple.notes.inlinetextattachment.dividerline"


def get_attachment_labels(identifiers):
    """Map attachment ZIDENTIFIER -> human label (filename/title/url) from the DB."""
    identifiers = [i for i in identifiers if i]
    if not identifiers:
        return {}

    conn = sqlite3.connect(get_db_path())
    cursor = conn.cursor()
    placeholders = ",".join("?" * len(identifiers))
    cursor.execute(
        f"""
        SELECT ZIDENTIFIER, ZTYPEUTI, ZFILENAME, ZTITLE, ZURLSTRING, ZALTTEXT
        FROM ZICCLOUDSYNCINGOBJECT
        WHERE ZIDENTIFIER IN ({placeholders})
        """,
        identifiers,
    )

    labels = {}
    for ident, _uti, filename, title, url, alt in cursor.fetchall():
        # Prefer the most human-friendly non-empty field.
        for candidate in (filename, title, alt, url):
            if candidate and candidate.strip():
                labels[ident] = candidate.strip()
                break
    conn.close()
    return labels


def embedded_object_markdown(attachment, labels):
    """Render an embedded object (the U+FFFC placeholder) as markdown."""
    if not attachment:
        return "[attachment]"

    uti = attachment.get("type_uti") or ""
    if uti == DIVIDER_UTI:
        return "---"

    label = labels.get(attachment.get("identifier"))
    if not label:
        if uti.startswith("com.apple.notes.inlinetextattachment."):
            label = uti.rsplit(".", 1)[-1]  # e.g. hashtag, mention
        elif uti == "com.apple.notes.table":
            label = "table"
        else:
            label = uti or "attachment"
    return f"[attachment: {label}]"


def apply_formatting(text, runs, attachment_labels=None):
    """Apply markdown formatting based on attribute runs."""
    if not runs:
        return text

    labels = attachment_labels or {}

    # Build character-level formatting map
    char_formats = []
    position = 0
    for run in runs:
        for i in range(run["length"]):
            char_formats.append({
                "highlight": run["highlight"],
                "bold": run["bold"],
                "link": run["link"],
                "strikethrough": run["strikethrough"],
                "underlined": run["underlined"],
                "paragraph_style": run["paragraph_style"],
                "attachment": run.get("attachment"),
            })
        position += run["length"]

    # Process text line by line for paragraph-level formatting
    lines = text.split('\n')
    result_lines = []
    char_idx = 0

    for line in lines:
        if not line:
            result_lines.append("")
            char_idx += 1  # account for newline
            continue

        line_start_idx = char_idx

        # Get paragraph style from first char of line
        para_style = None
        if char_idx < len(char_formats):
            para_style = char_formats[char_idx].get("paragraph_style")

        # A divider sits alone on its line; remember it so we can pad it with a
        # blank line (otherwise "text\n---" is parsed as a setext heading).
        is_divider_line = (
            line == OBJECT_REPLACEMENT_CHAR
            and char_idx < len(char_formats)
            and (char_formats[char_idx].get("attachment") or {}).get("type_uti") == DIVIDER_UTI
        )

        # Apply inline formatting to the line
        formatted_chars = []
        in_bold = False
        in_highlight = False

        for i, char in enumerate(line):
            if char_idx + i >= len(char_formats):
                formatted_chars.append(char)
                continue

            fmt = char_formats[char_idx + i]

            # Embedded objects (dividers, tables, files, ...) are a single U+FFFC
            # placeholder; substitute a readable markdown rendering for them.
            if char == OBJECT_REPLACEMENT_CHAR:
                formatted_chars.append(embedded_object_markdown(fmt.get("attachment"), labels))
                continue

            # Handle bold transitions
            if fmt["bold"] and not in_bold:
                formatted_chars.append("**")
                in_bold = True
            elif not fmt["bold"] and in_bold:
                formatted_chars.append("**")
                in_bold = False

            # Handle highlight transitions
            if fmt["highlight"] and not in_highlight:
                formatted_chars.append("==")
                in_highlight = True
            elif not fmt["highlight"] and in_highlight:
                formatted_chars.append("==")
                in_highlight = False

            formatted_chars.append(char)

        # Close any open formatting at end of line
        if in_bold:
            formatted_chars.append("**")
        if in_highlight:
            formatted_chars.append("==")

        formatted_line = "".join(formatted_chars)

        # Apply paragraph-level formatting
        if para_style:
            style_type = para_style.get("style_type", -1)
            indent = para_style.get("indent", 0)
            checklist = para_style.get("checklist")

            # Style types (from Apple Notes):
            # 0 = title, 1 = heading, 2 = subheading, 4 = monospace
            # 100 = bullet list, 101 = dashed list, 102 = numbered list
            # 103 = checklist
            if style_type == 1:  # Heading
                formatted_line = f"## {formatted_line}"
            elif style_type == 2:  # Subheading
                formatted_line = f"### {formatted_line}"
            elif style_type == 4:  # Monospace
                formatted_line = f"`{formatted_line}`"
            elif style_type == 100:  # Bullet list
                prefix = "  " * indent + "- "
                formatted_line = prefix + formatted_line
            elif style_type == 101:  # Dashed list
                prefix = "  " * indent + "- "
                formatted_line = prefix + formatted_line
            elif style_type == 102:  # Numbered list
                prefix = "  " * indent + "1. "
                formatted_line = prefix + formatted_line
            elif style_type == 103:  # Checklist
                if checklist and checklist.get("done"):
                    prefix = "  " * indent + "- [x] "
                else:
                    prefix = "  " * indent + "- [ ] "
                formatted_line = prefix + formatted_line

        # Keep a divider as a proper thematic break by padding with a blank line.
        if is_divider_line and result_lines and result_lines[-1] != "":
            result_lines.append("")

        result_lines.append(formatted_line)
        char_idx += len(line) + 1  # +1 for newline

    return "\n".join(result_lines)


def format_as_markdown(title, text, links=None):
    """Format the note text as markdown"""
    lines = text.split("\n")

    # Check if the first line is the title
    if lines and lines[0].strip() == title:
        lines = lines[1:]
        # Skip leading empty lines after title
        while lines and not lines[0].strip():
            lines = lines[1:]

    # Reconstruct with title as header
    markdown = f"# {title}\n\n"
    markdown += "\n".join(lines)

    # Ensure file ends with newline
    if not markdown.endswith("\n"):
        markdown += "\n"

    return markdown


def cmd_search(args):
    """Handle search command"""
    term = " ".join(args.term) if args.term else None
    results = search_notes(term, limit=args.limit)

    if getattr(args, "json", False):
        print(json.dumps(
            [{"id": n["pk"], "title": n["title"]} for n in results],
            indent=2, ensure_ascii=False))
        return

    if not results:
        print("No notes found.")
        return

    print(Style.dim(f"{'ID':>5}  Title"))
    print(Style.dim("-" * 60))
    for note in results:
        print(f"{Style.identifier('%5d' % note['pk'])}  {Style.title(note['title'])}")


def cmd_folders(args):
    """Handle folders command"""
    if args.name:
        # Search notes in a specific folder
        folder_name = " ".join(args.name)
        results = search_by_folder(folder_name, limit=args.limit)

        if getattr(args, "json", False):
            print(json.dumps(
                [{"id": n["pk"], "title": n["title"]} for n in results],
                indent=2, ensure_ascii=False))
            return

        if not results:
            print(f"No notes found in folder matching '{folder_name}'.")
            return

        print(Style.dim(f"{'ID':>5}  Title"))
        print(Style.dim("-" * 60))
        for note in results:
            print(f"{Style.identifier('%5d' % note['pk'])}  {Style.title(note['title'])}")
    else:
        # List all folders
        results = list_folders()

        if getattr(args, "json", False):
            print(json.dumps(
                [{"id": f["pk"], "title": f["title"], "count": f["count"]} for f in results],
                indent=2, ensure_ascii=False))
            return

        if not results:
            print("No folders found.")
            return

        print(Style.dim(f"{'ID':>5}  {'Notes':>5}  Folder"))
        print(Style.dim("-" * 60))
        for folder in results:
            print(f"{Style.identifier('%5d' % folder['pk'])}  "
                  f"{Style.dim('%5d' % folder['count'])}  {Style.title(folder['title'])}")


def cmd_export(args):
    """Handle export command"""
    result = find_note(args.identifier)

    if not result:
        print(f"Note not found: {args.identifier}", file=sys.stderr)
        sys.exit(1)

    pk, title, identifier, compressed_data = result
    print(f"Found note: {title} (ID: {pk})", file=sys.stderr)

    # Parse the note content using protobuf
    text, runs = parse_note_content(compressed_data)

    if not text:
        print("Failed to parse note content", file=sys.stderr)
        sys.exit(1)

    # Resolve human-readable labels for embedded objects (attachments, files, ...).
    attachment_labels = get_attachment_labels(
        [r["attachment"]["identifier"] for r in runs if r.get("attachment")]
    )

    # Apply formatting (highlights, embedded objects)
    formatted_text = apply_formatting(text, runs, attachment_labels)

    # Format as markdown
    markdown = format_as_markdown(title, formatted_text)

    # Output to stdout or file
    if args.output:
        with open(args.output, "w", encoding="utf-8") as f:
            f.write(markdown)
        print(f"Exported to: {args.output}", file=sys.stderr)
    else:
        print(markdown)


def cmd_create(args):
    """Create a note. The only write with nothing to destroy."""
    body = read_body_argument(args)
    if not body and not args.title:
        print("Nothing to create: pass a title, --body, or --body-file.", file=sys.stderr)
        sys.exit(1)

    # The first line of the body becomes the title, always — Notes re-derives it
    # on every body write. So a --title is prepended as that first line rather
    # than set separately, which would be silently overwritten.
    text = body
    if args.title:
        text = args.title + ("\n" + body if body else "")

    html = text_to_note_html(text)

    if args.folder:
        script = (
            'tell application "Notes"\n'
            "  set matches to every folder whose name is %s\n"
            "  if (count of matches) is 0 then error "
            '"no folder named " & %s number 8001\n'
            "  set f to item 1 of matches\n"
            "  set n to make new note at f with properties {body:%s}\n"
            "  return id of n\n"
            "end tell"
        ) % (
            applescript_string(args.folder),
            applescript_string(args.folder),
            applescript_string(html),
        )
    else:
        script = (
            'tell application "Notes"\n'
            "  set n to make new note with properties {body:%s}\n"
            "  return id of n\n"
            "end tell"
        ) % applescript_string(html)

    try:
        note_id = run_applescript(script)
    except AppleScriptError as exc:
        message = str(exc)
        if "8001" in message or "no folder named" in message:
            print(
                "No folder named '%s'. Run `apple notes folders` to see what exists."
                % args.folder,
                file=sys.stderr,
            )
            sys.exit(1)
        print("Could not create the note: %s" % message, file=sys.stderr)
        sys.exit(1)

    pk = None
    match = re.search(r"/ICNote/p(\d+)$", note_id)
    if match:
        pk = int(match.group(1))
    title, folder = note_title_and_folder(pk) if pk else (None, None)

    if args.json:
        payload = {"created": True, "applescript_id": note_id}
        if pk:
            payload["id"] = pk
        if title:
            payload["title"] = title
        if folder:
            payload["folder"] = folder
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        label = title or (args.title or "(untitled)")
        where = " in %s" % folder if folder else ""
        print("%s Created '%s'%s%s" % (
            Style.success("✓"), label, where,
            "  (id %d)" % pk if pk else ""))


def cmd_edit(args):
    """Replace a note's body. Full replace, never a merge."""
    pk, title, identifier, _data = resolve_note_for_write(args.identifier)
    body = read_body_argument(args)
    if not body:
        print(
            "Refusing to write an empty body — that would erase the note.\n"
            "Pass --body/--body-file with content, or use `delete`.",
            file=sys.stderr,
        )
        sys.exit(1)

    guard_body_write(pk, title, args.force, "edit")

    html = text_to_note_html(body)
    script = (
        'tell application "Notes"\n'
        "  set n to note id %s\n"
        "  set body of n to %s\n"
        "  return name of n\n"
        "end tell"
    ) % (applescript_string(applescript_note_id(pk)), applescript_string(html))

    try:
        new_title = run_applescript(script)
    except AppleScriptError as exc:
        print("Could not edit the note: %s" % exc, file=sys.stderr)
        sys.exit(1)

    # The title is re-derived from the first line on every body write, so it can
    # change without being asked to. Say so rather than let it be discovered.
    if args.json:
        print(json.dumps(
            {"id": pk, "edited": True, "title": new_title,
             "title_changed": new_title != title},
            indent=2, sort_keys=True))
    else:
        print("%s Edited note %d" % (Style.success("✓"), pk))
        if new_title != title:
            print("  title is now '%s' (taken from the first line, as always)"
                  % new_title)


def cmd_append(args):
    """Append to a note's body.

    Implemented as `set body to body & ...`, which is still a body write — so it
    destroys attachments exactly like `edit` does and carries the same guard.
    """
    pk, title, identifier, _data = resolve_note_for_write(args.identifier)
    text = read_body_argument(args)
    if not text:
        print("Nothing to append: pass --body or --body-file.", file=sys.stderr)
        sys.exit(1)

    guard_body_write(pk, title, args.force, "append to")

    html = text_to_note_html(text)
    script = (
        'tell application "Notes"\n'
        "  set n to note id %s\n"
        "  set body of n to (body of n) & %s\n"
        "  return name of n\n"
        "end tell"
    ) % (applescript_string(applescript_note_id(pk)), applescript_string(html))

    try:
        new_title = run_applescript(script)
    except AppleScriptError as exc:
        print("Could not append to the note: %s" % exc, file=sys.stderr)
        sys.exit(1)

    if args.json:
        print(json.dumps(
            {"id": pk, "appended": True, "title": new_title,
             "title_changed": new_title != title},
            indent=2, sort_keys=True))
    else:
        print("%s Appended to note %d" % (Style.success("✓"), pk))
        if new_title != title:
            print("  title is now '%s'" % new_title)


def cmd_delete(args):
    """Soft-delete a note: it moves to Recently Deleted."""
    pk, title, identifier, _data = resolve_note_for_write(args.identifier)

    script = (
        'tell application "Notes"\n'
        "  delete note id %s\n"
        "end tell"
    ) % applescript_string(applescript_note_id(pk))

    try:
        run_applescript(script)
    except AppleScriptError as exc:
        print("Could not delete the note: %s" % exc, file=sys.stderr)
        sys.exit(1)

    if args.json:
        print(json.dumps(
            {"id": pk, "deleted": True, "title": title, "recoverable": True},
            indent=2, sort_keys=True))
    else:
        print("%s Moved '%s' to Recently Deleted" % (Style.success("✓"), title))
        print("  Recoverable there for ~30 days; there is no API to purge it.")


def cmd_get_url(args):
    """Handle get-url command"""
    result = find_note(args.identifier)

    if not result:
        print(f"Note not found: {args.identifier}", file=sys.stderr)
        sys.exit(1)

    pk, title, identifier, _ = result

    if not identifier:
        print(f"Note has no identifier: {title}", file=sys.stderr)
        sys.exit(1)

    url = f"applenotes://note/{identifier}"
    if getattr(args, "json", False):
        print(json.dumps({"id": pk, "title": title, "url": url}, indent=2, ensure_ascii=False))
    else:
        print(url)


def main():
    parser = argparse.ArgumentParser(
        prog="apple-notes",
        description="Apple Notes CLI - search, export, and get URLs",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Protobuf definitions from:
  https://github.com/threeplanetssoftware/apple_cloud_notes_parser

Examples:
    apple-notes search                     # List recent notes
    apple-notes search "meeting"           # Search by title
    apple-notes folders                    # List all folders
    apple-notes folders Piano              # List notes in Piano folder
    apple-notes export 261                 # Export note ID 261 to stdout
    apple-notes export "My Note" -o out.md # Export to file
    apple-notes get-url 261                # Get applenotes:// URL
        """,
    )

    parser.add_argument(
        "--version", action="version", version=f"apple-notes {__version__}"
    )

    subparsers = parser.add_subparsers(dest="command", help="Command")

    # search command
    search_parser = subparsers.add_parser("search", help="Search notes by title")
    search_parser.add_argument(
        "term", nargs="*", help="Search term (optional, lists recent if omitted)"
    )
    search_parser.add_argument(
        "--limit", "-n", type=int, default=50, help="Max results (default: 50)"
    )
    search_parser.add_argument("--json", action="store_true", help="Output as JSON")

    # folders command
    folders_parser = subparsers.add_parser(
        "folders", help="List folders or search notes in a folder"
    )
    folders_parser.add_argument(
        "name", nargs="*", help="Folder name (optional, lists all folders if omitted)"
    )
    folders_parser.add_argument(
        "--limit", "-n", type=int, default=100, help="Max results (default: 100)"
    )
    folders_parser.add_argument("--json", action="store_true", help="Output as JSON")

    # export command
    export_parser = subparsers.add_parser(
        "export", help="Export note to markdown with highlights"
    )
    export_parser.add_argument(
        "identifier", help="Note ID, title, or applenotes:// URL"
    )
    export_parser.add_argument("-o", "--output", help="Output file (default: stdout)")

    # get-url command
    url_parser = subparsers.add_parser("get-url", help="Get applenotes:// URL for note")
    url_parser.add_argument("identifier", help="Note ID or title")
    url_parser.add_argument("--json", action="store_true", help="Output as JSON")

    # --- writes ---------------------------------------------------------- #
    # These drive Notes.app through AppleScript; reads never do. Every one of
    # them needs Automation → Notes on top of the Full Disk Access reads use.

    create_parser = subparsers.add_parser("create", help="Create a new note")
    create_parser.add_argument(
        "title", nargs="?", help="Title — becomes the first line of the body"
    )
    create_parser.add_argument("--body", help="Body text")
    create_parser.add_argument(
        "--body-file", help="Read the body from a file, or '-' for stdin"
    )
    create_parser.add_argument("--folder", help="Folder to create it in")
    create_parser.add_argument("--json", action="store_true", help="Output as JSON")

    edit_parser = subparsers.add_parser(
        "edit", help="Replace a note's body (full replace, never a merge)"
    )
    edit_parser.add_argument("identifier", help="Note ID, title, or applenotes:// URL")
    edit_parser.add_argument("--body", help="New body text")
    edit_parser.add_argument(
        "--body-file", help="Read the new body from a file, or '-' for stdin"
    )
    edit_parser.add_argument(
        "--force",
        action="store_true",
        help="Proceed even though it will destroy the note's attachments",
    )
    edit_parser.add_argument("--json", action="store_true", help="Output as JSON")

    append_parser = subparsers.add_parser("append", help="Append to a note's body")
    append_parser.add_argument("identifier", help="Note ID, title, or applenotes:// URL")
    append_parser.add_argument("--body", help="Text to append")
    append_parser.add_argument(
        "--body-file", help="Read the text from a file, or '-' for stdin"
    )
    append_parser.add_argument(
        "--force",
        action="store_true",
        help="Proceed even though it will destroy the note's attachments",
    )
    append_parser.add_argument("--json", action="store_true", help="Output as JSON")

    delete_parser = subparsers.add_parser(
        "delete", help="Move a note to Recently Deleted"
    )
    delete_parser.add_argument("identifier", help="Note ID, title, or applenotes:// URL")
    delete_parser.add_argument("--json", action="store_true", help="Output as JSON")

    status_parser = subparsers.add_parser(
        "status", help="Report access state without requesting it"
    )
    status_parser.add_argument("--json", action="store_true", help="Output as JSON")

    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    if args.command == "search":
        cmd_search(args)
    elif args.command == "folders":
        cmd_folders(args)
    elif args.command == "export":
        cmd_export(args)
    elif args.command == "get-url":
        cmd_get_url(args)
    elif args.command == "create":
        cmd_create(args)
    elif args.command == "edit":
        cmd_edit(args)
    elif args.command == "append":
        cmd_append(args)
    elif args.command == "delete":
        cmd_delete(args)
    elif args.command == "status":
        cmd_status(args)


if __name__ == "__main__":
    main()
