def get_db_path():
    """Get the Apple Notes database path"""
    return os.path.expanduser(
        "~/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite"
    )


def check_access():
    """Report whether the Notes store is readable.

    There is no API to query Full Disk Access, so this reads the store the same
    way every other command does and reports what happened. A denied read is
    the only reliable signal, and it costs one open() to get.

    Returns (status, usable, advice).
    """
    db_path = get_db_path()
    settings = "System Settings → Privacy & Security → Full Disk Access"

    if not os.path.exists(db_path):
        # A missing store is not a permission problem: FDA denial makes the
        # path unreadable, not absent. Notes has simply never run here.
        return ("noNoteStore", False,
                "No Notes database at %s — open Notes.app once." % db_path)

    try:
        conn = sqlite3.connect("file:%s?mode=ro" % db_path, uri=True)
        try:
            conn.execute("SELECT 1 FROM ZICCLOUDSYNCINGOBJECT LIMIT 1").fetchone()
        finally:
            conn.close()
        return ("authorized", True, None)
    except sqlite3.OperationalError as exc:
        message = str(exc).lower()
        if "unable to open" in message or "authorization denied" in message:
            return ("denied", False,
                    "Grant Full Disk Access to your terminal in %s." % settings)
        return ("unreadable", False, "Could not read the Notes store: %s" % exc)
    except PermissionError:
        return ("denied", False,
                "Grant Full Disk Access to your terminal in %s." % settings)


# --------------------------------------------------------------------------- #
# Shortcuts — the write path.
#
# Reads use SQLite and need only Full Disk Access. Writes go through Notes'
# AppIntents, driven by `shortcuts run`, because AppleScript cannot express a
# checklist and its only body write destroys attachments. See
# docs/apple-notes-shortcuts.md.
#
# Each shortcut must be installed once (there is no headless install) and
# authorised once. Both are per-shortcut, so status reports each separately.
# --------------------------------------------------------------------------- #
SHORTCUTS = {
    "Apple Tools Create Note": "create a note from Markdown",
    "Apple Tools Append Note": "append Markdown to an existing note",
}


def shortcuts_dir():
    """Where the .shortcut files live, in a repo checkout or a Homebrew install."""
    for candidate in (
        SCRIPT_DIR / "shortcuts",                                   # repo layout
        SCRIPT_DIR.parent / "share" / "apple-tools" / "shortcuts",  # brew: libexec -> share
        SCRIPT_DIR / ".." / "share" / "apple-tools" / "shortcuts",
    ):
        if candidate.is_dir() and any(candidate.glob("*.shortcut")):
            return candidate.resolve()
    return None


def installed_shortcuts():
    """Names present in the user's Shortcuts library, or None if unavailable."""
    if not os.path.exists("/usr/bin/shortcuts"):
        return None
    try:
        out = subprocess.run(["shortcuts", "list"], capture_output=True,
                             text=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return {line.strip() for line in out.stdout.splitlines() if line.strip()}


def shortcuts_status():
    """Report the write path: which shortcuts are installed and what's missing.

    Deliberately does not run one — running is what triggers the permission
    prompt, and status must never prompt.

    ⚠️ **This cannot tell you whether a shortcut is *allowed* to run**, and no
    known local state can. `ZACCESSRESOURCEPERMISSION` in the Shortcuts library
    looks like the grant store and is **not** — it stayed empty on this machine
    after a permission dialog was answered "Always Allow". A check was built on
    that table and removed; do not rebuild it without evidence.
    """
    have = installed_shortcuts()
    if have is None:
        return {
            "available": False,
            "reason": "the `shortcuts` CLI is unavailable",
            "installed": [], "missing": sorted(SHORTCUTS),
        }
    missing = sorted(n for n in SHORTCUTS if n not in have)
    return {
        "available": not missing,
        "installed": sorted(n for n in SHORTCUTS if n in have),
        "missing": missing,
        "advice": ("Run `apple notes install-shortcuts` to install them."
                   if missing else None),
    }


def cmd_status(args):
    """Report Full Disk Access and the Shortcuts write path. Never prompts."""
    status, usable, advice = check_access()
    sc = shortcuts_status()

    if args.json:
        payload = {"status": status, "usable": usable, "shortcuts": sc}
        if advice:
            payload["advice"] = advice
        print(json.dumps(payload, indent=2, sort_keys=True))
        return

    suffix = "" if usable else "  (cannot read notes)"
    print("Notes access: %s%s" % (status, suffix))
    if advice:
        print(advice)

    if sc["available"]:
        print("Write path:   shortcuts installed (%d)" % len(sc["installed"]))
    else:
        detail = sc.get("reason") or "%d not installed" % len(sc["missing"])
        print("Write path:   unavailable — %s" % detail)
        for name in sc["missing"]:
            print("                missing: %s" % name)
        if sc.get("advice"):
            print("              %s" % sc["advice"])


# A password-protected ("locked") note keeps its row in ZICCLOUDSYNCINGOBJECT but
# its body is encrypted and not exposed to us at all — ZICNOTEDATA.ZDATA is NULL.
# There is no read path: the key is derived from the user's note password (or the
# device passcode on iOS 16+), which we neither have nor should ask for. So these
# are skipped by default rather than surfaced as notes that mysteriously fail.
#
# Verified against the live store; see docs/apple-notes-api.md §4.
NOT_LOCKED = "COALESCE(n.ZISPASSWORDPROTECTED, 0) = 0"


def search_notes(term=None, limit=50, include_locked=False):
    """Search notes by title or list recent notes.

    Locked notes are excluded unless include_locked, in which case they come
    back with locked=True and no readable body.
    """
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    # With --include-locked the title filter is relaxed too: a locked note may
    # carry no title at all, and omitting it after the user explicitly asked to
    # see locked notes would be the same silent gap the flag exists to close.
    if include_locked:
        lock_clause = ""
        title_clause = "(n.ZTITLE1 IS NOT NULL OR COALESCE(n.ZISPASSWORDPROTECTED, 0) = 1)"
    else:
        lock_clause = f"AND {NOT_LOCKED}"
        title_clause = "n.ZTITLE1 IS NOT NULL"

    if term:
        cursor.execute(
            f"""
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, n.ZMODIFICATIONDATE1,
                   COALESCE(n.ZISPASSWORDPROTECTED, 0)
            FROM ZICCLOUDSYNCINGOBJECT n
            WHERE {title_clause}
            AND n.ZMARKEDFORDELETION = 0
            {lock_clause}
            AND n.ZTITLE1 LIKE ?
            ORDER BY n.ZMODIFICATIONDATE1 DESC
            LIMIT ?
        """,
            (f"%{term}%", limit),
        )
    else:
        cursor.execute(
            f"""
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, n.ZMODIFICATIONDATE1,
                   COALESCE(n.ZISPASSWORDPROTECTED, 0)
            FROM ZICCLOUDSYNCINGOBJECT n
            WHERE {title_clause}
            AND n.ZMARKEDFORDELETION = 0
            {lock_clause}
            ORDER BY n.ZMODIFICATIONDATE1 DESC
            LIMIT ?
        """,
            (limit,),
        )

    results = []
    for row in cursor.fetchall():
        entry = {
            "pk": row[0],
            "title": row[1],
            "identifier": row[2],
            "modified": row[3],
        }
        if row[4]:
            entry["locked"] = True
            if entry["title"] is None:
                entry["title"] = "<locked note>"
        results.append(entry)

    conn.close()
    return results


def count_locked_notes():
    """How many live notes are locked — used to tell the user what was skipped."""
    conn = sqlite3.connect(get_db_path())
    try:
        return conn.execute(
            "SELECT COUNT(*) FROM ZICCLOUDSYNCINGOBJECT n "
            "WHERE COALESCE(n.ZISPASSWORDPROTECTED, 0) = 1 "
            "AND n.ZMARKEDFORDELETION = 0"
        ).fetchone()[0]
    finally:
        conn.close()


def warn_locked_skipped(include_locked):
    """Say on stderr that locked notes were omitted, so the gap is never silent."""
    if include_locked:
        return
    try:
        n = count_locked_notes()
    except sqlite3.Error:
        return
    if n:
        print(
            f"note: skipped {n} password-protected note{'s' if n != 1 else ''} "
            "(contents are encrypted; pass --include-locked to list them)",
            file=sys.stderr,
        )


def list_folders():
    """List all folders in Apple Notes."""
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    cursor.execute(
        """
        SELECT f.Z_PK, f.ZTITLE2, COUNT(n.Z_PK) as note_count
        FROM ZICCLOUDSYNCINGOBJECT f
        LEFT JOIN ZICCLOUDSYNCINGOBJECT n ON n.ZFOLDER = f.Z_PK
            AND n.ZMARKEDFORDELETION = 0
            AND n.ZTITLE1 IS NOT NULL
            AND COALESCE(n.ZISPASSWORDPROTECTED, 0) = 0
        WHERE f.ZTITLE2 IS NOT NULL
        AND f.ZMARKEDFORDELETION = 0
        GROUP BY f.Z_PK, f.ZTITLE2
        ORDER BY f.ZTITLE2
    """
    )

    results = []
    for row in cursor.fetchall():
        results.append({"pk": row[0], "title": row[1], "count": row[2]})

    conn.close()
    return results


def search_by_folder(folder_name, limit=100):
    """Search notes in a specific folder."""
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    cursor.execute(
        """
        SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, n.ZMODIFICATIONDATE1, f.ZTITLE2
        FROM ZICCLOUDSYNCINGOBJECT n
        JOIN ZICCLOUDSYNCINGOBJECT f ON n.ZFOLDER = f.Z_PK
        WHERE f.ZTITLE2 LIKE ?
        AND n.ZMARKEDFORDELETION = 0
        AND n.ZTITLE1 IS NOT NULL
        AND COALESCE(n.ZISPASSWORDPROTECTED, 0) = 0
        ORDER BY n.ZMODIFICATIONDATE1 DESC
        LIMIT ?
    """,
        (f"%{folder_name}%", limit),
    )

    results = []
    for row in cursor.fetchall():
        results.append(
            {
                "pk": row[0],
                "title": row[1],
                "identifier": row[2],
                "modified": row[3],
                "folder": row[4],
            }
        )

    conn.close()
    return results


def find_note(identifier):
    """Find a note by title, ID, or Apple Notes link"""
    db_path = get_db_path()
    conn = sqlite3.connect(db_path)
    cursor = conn.cursor()

    # Check if it's a numeric ID
    if identifier.isdigit():
        cursor.execute(
            """
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA,
                   COALESCE(n.ZISPASSWORDPROTECTED, 0)
            FROM ZICCLOUDSYNCINGOBJECT n
            JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
            WHERE n.Z_PK = ?
        """,
            (int(identifier),),
        )
    # Check if it's an Apple Notes link (applenotes://...)
    elif identifier.startswith("applenotes://"):
        match = re.search(r"applenotes://[^/]+/([^/]+)", identifier)
        if match:
            note_id = match.group(1)
            cursor.execute(
                """
                SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA,
                       COALESCE(n.ZISPASSWORDPROTECTED, 0)
                FROM ZICCLOUDSYNCINGOBJECT n
                JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
                WHERE n.ZIDENTIFIER = ?
            """,
                (note_id,),
            )
        else:
            conn.close()
            return None
    else:
        # Search by title (exact match first, then partial)
        cursor.execute(
            """
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA,
                   COALESCE(n.ZISPASSWORDPROTECTED, 0)
            FROM ZICCLOUDSYNCINGOBJECT n
            JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
            WHERE n.ZTITLE1 = ?
        """,
            (identifier,),
        )

        # 🛑 Fetch into `result` and return it. An earlier version fetched here
        # AND again after the if/else, so a successful EXACT match consumed its
        # own only row and the second fetch returned None — exact-title lookup
        # never worked, and fell through to nothing rather than to the partial
        # match. Only the numeric-id path was exercised, so it stayed hidden.
        result = cursor.fetchone()
        if result:
            conn.close()
            return result

        # No exact hit — try a partial match.
        cursor.execute(
            """
            SELECT n.Z_PK, n.ZTITLE1, n.ZIDENTIFIER, nd.ZDATA,
                   COALESCE(n.ZISPASSWORDPROTECTED, 0)
            FROM ZICCLOUDSYNCINGOBJECT n
            JOIN ZICNOTEDATA nd ON nd.ZNOTE = n.Z_PK
            WHERE n.ZTITLE1 LIKE ?
        """,
            (f"%{identifier}%",),
        )

    result = cursor.fetchone()
    conn.close()
    return result


def parse_note_content(compressed_data):
    """Parse the note content and extract text with formatting.

    Field numbers below come from notestore.proto:
      Note.note_text = 2, Note.attribute_run = 5
      AttributeRun: length=1 paragraph_style=2 font_weight=5 underlined=6
                    strikethrough=7 link=9 color=10 attachment_info=12
      ParagraphStyle: style_type=1 indent_amount=4 checklist=5
      Checklist.done = 2, AttachmentInfo: identifier=1 type_uti=2
    """
    # Decompress the gzipped protobuf data
    data = gzip.decompress(compressed_data)

    note = parse_note_store(data)
    if note is None:
        return None, []

    text = note.string(2, "")

    # Extract formatting runs with all attributes
    runs = []
    for attr_run in note.messages(5):
        color = attr_run.message(10)
        is_highlight = is_highlight_color(Color(color)) if color is not None else False
        link = attr_run.string(9)

        # Paragraph style info
        para_style = None
        ps = attr_run.message(2)
        if ps is not None:
            checklist = ps.message(5)
            para_style = {
                "style_type": ps.int32(1, -1),  # proto default is -1
                "indent": ps.int32(4, 0),
                "checklist": {"done": checklist.int32(2)} if checklist is not None else None,
            }

        # Embedded object info (dividers, tables, files, images, ...). These occupy
        # a single U+FFFC object-replacement char in the text; the type comes from
        # the protobuf and a human-readable name is resolved later from the DB.
        attachment = None
        ai = attr_run.message(12)
        if ai is not None:
            attachment = {
                "type_uti": ai.string(2),
                "identifier": ai.string(1),
            }

        runs.append({
            "length": attr_run.int32(1),
            "highlight": is_highlight,
            "link": link,
            "underlined": attr_run.int32(6, 0),
            "strikethrough": attr_run.int32(7, 0),
            # 🛑 `font_weight` is an enum: 1 bold, 2 italic, 3 BOTH. Testing
            # `== 1` for bold dropped it on every weight-3 run.
            "bold": run_is_bold(attr_run),
            "italic": run_is_italic(attr_run),
            "paragraph_style": para_style,
            "attachment": attachment,
        })

    return text, runs


# A single U+FFFC object-replacement char marks each embedded object in note text.
OBJECT_REPLACEMENT_CHAR = "￼"
# Notes encodes a horizontal-rule / divider as an inline-text attachment.
DIVIDER_UTI = "com.apple.notes.inlinetextattachment.dividerline"


def get_attachment_labels(identifiers):
    """Map attachment ZIDENTIFIER -> human label (filename/title/url) from the DB."""
    identifiers = [i for i in identifiers if i]
    if not identifiers:
        return {}

    conn = sqlite3.connect(get_db_path())
    cursor = conn.cursor()
    placeholders = ",".join("?" * len(identifiers))
    cursor.execute(
        f"""
        SELECT ZIDENTIFIER, ZTYPEUTI, ZFILENAME, ZTITLE, ZURLSTRING, ZALTTEXT
        FROM ZICCLOUDSYNCINGOBJECT
        WHERE ZIDENTIFIER IN ({placeholders})
        """,
        identifiers,
    )

    labels = {}
    for ident, _uti, filename, title, url, alt in cursor.fetchall():
        # Prefer the most human-friendly non-empty field.
        for candidate in (filename, title, alt, url):
            if candidate and candidate.strip():
                labels[ident] = candidate.strip()
                break
    conn.close()
    return labels


def get_attachment_links(identifiers):
    """Map attachment ZIDENTIFIER -> the target it points at.

    A note link's target lives in `ZTOKENCONTENTIDENTIFIER` as
    `applenotes:note/<uuid>`. ⚠️ **The same column holds non-URI tokens** for
    other inline attachments — a hashtag stores a bare word, a mention stores
    an account id — so the caller must check the value parses as a URI before
    building a link from it.
    """
    identifiers = [i for i in identifiers if i]
    if not identifiers:
        return {}

    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        placeholders = ",".join("?" * len(identifiers))
        rows = conn.execute(
            f"""
            SELECT ZIDENTIFIER, ZTOKENCONTENTIDENTIFIER
            FROM ZICCLOUDSYNCINGOBJECT
            WHERE ZIDENTIFIER IN ({placeholders})
              AND ZTOKENCONTENTIDENTIFIER IS NOT NULL
            """,
            identifiers,
        ).fetchall()
    finally:
        conn.close()
    return {ident: token for ident, token in rows if token}


def get_note_tables(identifiers, labels, links=None):
    """Map attachment ZIDENTIFIER -> rendered Markdown table.

    The cells are not in the note body at all. They live in the attachment
    row's ZMERGEABLEDATA1 blob, which `mergeable.py` also reads for call
    recordings. A table that fails to decode is left out, so the caller falls
    back to the `[attachment: table]` placeholder rather than printing nothing.
    """
    identifiers = [i for i in identifiers if i]
    if not identifiers:
        return {}

    import mergeable

    conn = sqlite3.connect("file:%s?mode=ro" % get_db_path(), uri=True)
    try:
        placeholders = ",".join("?" * len(identifiers))
        rows = conn.execute(
            f"""
            SELECT ZIDENTIFIER, ZMERGEABLEDATA1
            FROM ZICCLOUDSYNCINGOBJECT
            WHERE ZIDENTIFIER IN ({placeholders})
              AND ZTYPEUTI = ? AND ZMERGEABLEDATA1 IS NOT NULL
            """,
            identifiers + [mergeable.TABLE_UTI],
        ).fetchall()
    finally:
        conn.close()

    def decode(known_labels, known_links):
        out, wanted = {}, set()
        for ident, blob in rows:
            try:
                table = mergeable.table_from_blob(blob, known_labels, known_links)
            except Exception:
                continue
            if table is not None and table.rows:
                out[ident] = table
                wanted |= table.attachment_ids
        return out, wanted

    # Two passes, because a link inside a cell is an attachment row with a NULL
    # ZNOTE — nothing joins it to this note, so the first decode is what tells
    # us which identifiers to look up at all.
    links = dict(links or {})
    decoded, wanted = decode(labels, links)
    unresolved = wanted - set(labels)
    if unresolved:
        labels = dict(labels)
        labels.update(get_attachment_labels(sorted(unresolved)))
        links.update(get_attachment_links(sorted(unresolved)))
        decoded, _ = decode(labels, links)

    return {ident: table.markdown() for ident, table in decoded.items()}


def embedded_object_markdown(attachment, labels, tables=None, links=None):
    """Render an embedded object (the U+FFFC placeholder) as markdown."""
    if not attachment:
        return "[attachment]"

    uti = attachment.get("type_uti") or ""
    if uti == DIVIDER_UTI:
        return "---"

    identifier = attachment.get("identifier")
    rendered = (tables or {}).get(identifier)
    if rendered:
        return rendered

    label = labels.get(identifier)

    # 🛑 An inline text attachment is TEXT, not a file. A hashtag, a mention, an
    # inline calculation result and a link to another note all live here, and
    # `[attachment: #trips]` was wrong for every one of them — 227 on the
    # development store. Render the text itself, and make a link where there is
    # a real URI to link to.
    if uti.startswith("com.apple.notes.inlinetextattachment.") and label:
        return mergeable.inline_attachment_markdown(identifier, uti, labels, links)

    if not label:
        if uti.startswith("com.apple.notes.inlinetextattachment."):
            label = uti.rsplit(".", 1)[-1]  # e.g. hashtag, mention
        elif uti == "com.apple.notes.table":
            label = "table"
        else:
            label = uti or "attachment"
    return f"[attachment: {label}]"


def utf16_length(s):
    """Length of `s` in UTF-16 code units.

    🛑 **An AttributeRun's `length` counts UTF-16 code units, not code
    points**, and Python indexes strings by code point. Every astral character
    — every 🎢-style emoji — is 2 units and 1 code point, so a note carrying
    one silently shifts every later run left by one character.

    The failure is invisible and cumulative: bold and highlight markers land
    mid-word, a heading loses its `##`, and an embedded object's run drifts off
    its U+FFFC so a real table renders as a bare `[attachment]`. Measured on a
    real note: 40 astral characters, run lengths summing to 6692 against 6652
    code points, and the table at the end of the note lost entirely.
    """
    return sum(2 if ord(ch) > 0xFFFF else 1 for ch in s)


def apply_formatting(text, runs, attachment_labels=None, tables=None, links=None):
    """Apply markdown formatting based on attribute runs."""
    if not runs:
        return text

    labels = attachment_labels or {}
    tables = tables or {}
    links = links or {}

    # Build character-level formatting map. Indexed in UTF-16 code units, to
    # match what the runs count — see utf16_length.
    char_formats = []
    position = 0
    for run in runs:
        for i in range(run["length"]):
            char_formats.append({
                "highlight": run["highlight"],
                "bold": run["bold"],
                "italic": run["italic"],
                "link": run["link"],
                "strikethrough": run["strikethrough"],
                "underlined": run["underlined"],
                "paragraph_style": run["paragraph_style"],
                "attachment": run.get("attachment"),
            })
        position += run["length"]

    # Decide, once, which link spans are worth marking up.
    #
    # A link is decided over its WHOLE span, not per character, for two
    # reasons. A pasted link has the URL as its own text, and `[url](url)` is
    # noise — 88 of 297 body links here are that shape. And Notes splits one
    # link across several runs, so the span has to be gathered before its text
    # can be compared to its URL.
    raw_text = text.encode("utf-16-le")
    link_at = [usable_link(f["link"]) for f in char_formats]
    bare_link = [False] * len(char_formats)
    start = 0
    while start < len(link_at):
        url = link_at[start]
        if not url:
            start += 1
            continue
        end = start
        while end < len(link_at) and link_at[end] == url:
            end += 1
        span = raw_text[start * 2:end * 2].decode("utf-16-le", "replace")
        if span.strip() == url.strip():
            for i in range(start, end):
                bare_link[i] = True
        start = end

    # Process text line by line for paragraph-level formatting
    lines = text.split('\n')
    result_lines = []
    char_idx = 0

    for line in lines:
        if not line:
            result_lines.append("")
            char_idx += 1  # account for newline
            continue

        # Get paragraph style from first char of line
        para_style = None
        if char_idx < len(char_formats):
            para_style = char_formats[char_idx].get("paragraph_style")

        # A divider sits alone on its line; remember it so we can pad it with a
        # blank line (otherwise "text\n---" is parsed as a setext heading).
        is_divider_line = (
            line == OBJECT_REPLACEMENT_CHAR
            and char_idx < len(char_formats)
            and (char_formats[char_idx].get("attachment") or {}).get("type_uti") == DIVIDER_UTI
        )

        # A table sits alone on its line too, and expands to several lines. It
        # needs a blank line on BOTH sides: without one before it, the row above
        # is absorbed as the table's own header; without one after, the line
        # below is parsed as another table row.
        is_table_line = (
            line == OBJECT_REPLACEMENT_CHAR
            and char_idx < len(char_formats)
            and (char_formats[char_idx].get("attachment") or {}).get("identifier")
            in tables
        )

        # Apply inline formatting to the line.
        #
        # Marks nest in MARKS order — bold, italic, highlight, strikethrough,
        # link — and close in reverse, so a bold italic link reads
        # `***[text](url)***`. `mark_transition` closes only what must close,
        # so an italic span ending inside a bold one does not split the bold.
        formatted_chars = []
        active = NO_MARKS

        offset = char_idx
        for i, char in enumerate(line):
            if offset >= len(char_formats):
                formatted_chars.append(char)
                offset += 2 if ord(char) > 0xFFFF else 1
                continue

            fmt = char_formats[offset]
            # A bare pasted link is its own text, and `[url](url)` is noise.
            url = None if bare_link[offset] else link_at[offset]
            wanted = (fmt["bold"], fmt["italic"], fmt["highlight"],
                      bool(fmt["strikethrough"]), url)
            offset += 2 if ord(char) > 0xFFFF else 1

            # Embedded objects (dividers, tables, files, ...) are a single U+FFFC
            # placeholder; substitute a readable markdown rendering for them.
            if char == OBJECT_REPLACEMENT_CHAR:
                formatted_chars.append(embedded_object_markdown(
                    fmt.get("attachment"), labels, tables, links))
                continue

            # 🛑 U+2028 is a soft line break, and `split("\n")` does not split on
            # it — so a bold span crossing one straddles what every editor draws
            # as a line break. Close every mark around it and let the next
            # character reopen. The character itself is passed through
            # unchanged, so no paragraph structure moves. 254 of these here, 239
            # of them in plain paragraphs.
            if char in SOFT_LINE_BREAKS:
                formatted_chars.append(mark_transition(active, NO_MARKS))
                active = NO_MARKS
                formatted_chars.append(char)
                continue

            formatted_chars.append(mark_transition(active, wanted))
            active = wanted

            # ⚠️ Escape AFTER the markers are placed, and only the source
            # character — never the markers this loop just emitted. 219 literal
            # asterisks live in these notes, and they came back mixed with real
            # bold markers.
            formatted_chars.append(escape_markdown_char(
                char,
                line[i - 1] if i else "",
                line[i + 1] if i + 1 < len(line) else ""))

        # Close anything still open at end of line. ⚠️ A link may not span a
        # line in Markdown, and 9 link runs here contain a newline, so one is
        # closed and reopened per line rather than dropped.
        formatted_chars.append(mark_transition(active, NO_MARKS))

        formatted_line = "".join(formatted_chars)

        # Apply paragraph-level formatting
        if para_style:
            style_type = para_style.get("style_type", -1)
            indent = para_style.get("indent", 0)
            checklist = para_style.get("checklist")

            # Style types (from Apple Notes):
            # 0 = title, 1 = heading, 2 = subheading, 4 = monospace
            # 100 = bullet list, 101 = dashed list, 102 = numbered list
            # 103 = checklist
            if style_type == 0:  # Title
                # 🛑 A `# heading` written through the Markdown path lands on
                # the TITLE style, not the heading style, so a title paragraph
                # mid-note is ordinary. The reader used to emit nothing for it,
                # which silently flattened it into body text.
                #
                # ⚠️ Except when the line is only an embedded object. A note
                # that opens with an image takes its title FROM that image, so
                # `# [attachment: clouds.png]` under the heading `# clouds.png`
                # reads as the same thing twice.
                if line.strip() != OBJECT_REPLACEMENT_CHAR:
                    formatted_line = f"# {formatted_line}"
            elif style_type == 1:  # Heading
                formatted_line = f"## {formatted_line}"
            elif style_type == 2:  # Subheading
                formatted_line = f"### {formatted_line}"
            elif style_type == 4:  # Monospace
                formatted_line = f"`{formatted_line}`"
            elif style_type == 100:  # Bullet list
                prefix = "  " * indent + "- "
                formatted_line = prefix + formatted_line
            elif style_type == 101:  # Dashed list
                prefix = "  " * indent + "- "
                formatted_line = prefix + formatted_line
            elif style_type == 102:  # Numbered list
                prefix = "  " * indent + "1. "
                formatted_line = prefix + formatted_line
            elif style_type == 103:  # Checklist
                if checklist and checklist.get("done"):
                    prefix = "  " * indent + "- [x] "
                else:
                    prefix = "  " * indent + "- [ ] "
                formatted_line = prefix + formatted_line

        # Keep a divider as a proper thematic break by padding with a blank line.
        if (is_divider_line or is_table_line) and result_lines and result_lines[-1] != "":
            result_lines.append("")

        result_lines.append(formatted_line)
        if is_table_line:
            result_lines.append("")
        char_idx += utf16_length(line) + 1  # +1 for newline

    return "\n".join(result_lines)


def format_as_markdown(title, text, links=None):
    """Format the note text as markdown"""
    lines = text.split("\n")

    # Drop the body's own title line, so the title is not printed twice.
    #
    # 🛑 Compare with any marker stripped. The note's first paragraph carries
    # the TITLE style, and once the renderer learned to emit `# ` for that
    # style the raw comparison stopped matching — so every export printed the
    # title twice, once from here and once from the body. Bold markers can
    # appear too, since Notes makes a title bold.
    #
    # ⚠️ And skip leading blank lines first. A note whose body opens with an
    # empty line put its title on line 1, which the old check never looked at.
    start = 0
    while start < len(lines) and not lines[start].strip():
        start += 1
    if start < len(lines):
        first = lines[start].strip().lstrip("#").strip().strip("*").strip()
        if first == title.strip():
            lines = lines[start + 1:]
        # Skip leading empty lines after title
        while lines and not lines[0].strip():
            lines = lines[1:]

    # Reconstruct with title as header.
    #
    # ⚠️ **The title can itself hold a U+FFFC.** A note whose first line is
    # nothing but an embedded object takes that placeholder as its `ZTITLE1`,
    # so the heading came out as a literal `# ￼`. Two notes here do that.
    # Render it the way the body renders one rather than leaking the raw
    # character.
    heading = title.replace(OBJECT_REPLACEMENT_CHAR, "[attachment]")
    markdown = f"# {heading}\n\n"
    markdown += "\n".join(lines)

    # Ensure file ends with newline
    if not markdown.endswith("\n"):
        markdown += "\n"

    return markdown



def cmd_install_shortcuts(args):
    """Install the write-path shortcuts, then verify they landed.

    There is no headless install: `shortcuts` can run, list, view and sign, but
    not add. Writing Shortcuts.sqlite directly would fight CloudKit sync. So
    this opens each file and waits for it to appear in the library.
    """
    src = shortcuts_dir()
    if src is None:
        print("error: cannot find the .shortcut files.", file=sys.stderr)
        print("       Looked next to this script and in share/apple-tools/shortcuts.",
              file=sys.stderr)
        sys.exit(1)

    if not os.path.exists("/usr/bin/shortcuts"):
        print("error: /usr/bin/shortcuts is missing; cannot verify installation.",
              file=sys.stderr)
        sys.exit(1)

    before = installed_shortcuts() or set()
    todo = [n for n in SHORTCUTS if n not in before or args.force]
    if not todo:
        print("All %d shortcuts are already installed." % len(SHORTCUTS))
        print("Re-run with --force to reinstall.")
        return

    print("Installing %d shortcut%s from %s"
          % (len(todo), "" if len(todo) == 1 else "s", src))
    print("Shortcuts.app will open and ask you to add each one — accept it.\n")

    for name in todo:
        path = src / ("%s.shortcut" % name)
        if not path.exists():
            print("  ✗ %s — file missing at %s" % (name, path), file=sys.stderr)
            continue
        print("  opening %s …" % name)
        subprocess.run(["open", str(path)], check=False)
        # Poll rather than sleep blindly; adding is a human action.
        deadline = time.time() + 90
        while time.time() < deadline:
            if name in (installed_shortcuts() or set()):
                print("  ✓ %s installed" % name)
                break
            time.sleep(2)
        else:
            print("  ✗ %s did not appear within 90s" % name, file=sys.stderr)

    have = installed_shortcuts() or set()
    missing = [n for n in SHORTCUTS if n not in have]
    print()
    if missing:
        print("Still missing: %s" % ", ".join(missing), file=sys.stderr)
        print("Open the files yourself from: %s" % src, file=sys.stderr)
        sys.exit(1)

    print("All shortcuts installed.\n")
    print("One more step, the first time each one runs: macOS asks")
    print('  "Allow <shortcut> to ... a note?"')
    print("Choose **Always Allow** for unattended use, or **Allow Once** to")
    print("approve every individual write — that prompt is an OS-enforced")
    print("review of exactly what is being written, and is worth keeping if an")
    print("agent is driving. The grant is per shortcut, not per note.")


