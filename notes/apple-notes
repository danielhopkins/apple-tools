class Style:
    """Terminal styling, mirroring swift/Sources/AppleToolsStyle/Style.swift.

    Only when stdout is a terminal, so piping stays clean. Honours NO_COLOR
    (no-color.org) and the BSD CLICOLOR/CLICOLOR_FORCE spelling.
    """

    @staticmethod
    def _enabled():
        env = os.environ
        if "NO_COLOR" in env or env.get("CLICOLOR") == "0" or env.get("TERM") == "dumb":
            return False
        if env.get("CLICOLOR_FORCE", "0") != "0":
            return True
        return sys.stdout.isatty()

    enabled = None  # resolved on first use

    @classmethod
    def _wrap(cls, text, code):
        if cls.enabled is None:
            cls.enabled = cls._enabled()
        if not cls.enabled or not text:
            return text
        return f"\033[{code}m{text}\033[0m"

    @classmethod
    def title(cls, text):
        return cls._wrap(text, "1")

    @classmethod
    def dim(cls, text):
        return cls._wrap(text, "2")

    @classmethod
    def identifier(cls, text):
        return cls._wrap(text, "35")


