<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Embedded into the binary's __TEXT,__info_plist section by the linker
	  flags in Package.swift.

	  Without a usage description macOS will not show the Contacts permission
	  dialog at all: CNContactStore.requestAccess returns "Access Denied"
	  immediately and the authorization status stays notDetermined, so there is
	  nothing to toggle in System Settings either. The string below is what the
	  dialog shows.
	-->
	<key>CFBundleIdentifier</key>
	<string>com.boulderhopkins.apple-tools.apple-contacts</string>
	<key>CFBundleName</key>
	<string>apple-contacts</string>
	<key>NSContactsUsageDescription</key>
	<string>apple-contacts reads and edits your contacts from the command line.</string>
</dict>
</plist>
