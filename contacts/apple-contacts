#!/usr/bin/env python3
"""apple-contacts - query the local Apple Contacts database.

Reads the AddressBook sqlite stores directly (read-only, never writes). Every
source database under ~/Library/Application Support/AddressBook is searched and
the results merged, so contacts from multiple accounts all show up.
"""

import argparse
import json
import os
import re
import sqlite3
import sys
from glob import glob

__version__ = "26.727.4"

AB_BASE = os.path.expanduser("~/Library/Application Support/AddressBook")

# Apple stores labels as _$!<Home>!$_ ; strip the decoration.
LABEL_RE = re.compile(r"^_\$!<(.+)>!\$_$")


def label(raw):
    if not raw:
        return None
    match = LABEL_RE.match(raw)
    return (match.group(1) if match else raw).lower()


def databases():
    """Every AddressBook source db, most-specific first."""
    found = sorted(glob(os.path.join(AB_BASE, "Sources", "*", "AddressBook-v22.abcddb")))
    root = os.path.join(AB_BASE, "AddressBook-v22.abcddb")
    if os.path.exists(root):
        found.append(root)
    return found


def connect(path):
    # Read-only URI so a stray query can never mutate the user's contacts.
    return sqlite3.connect(f"file:{path}?mode=ro", uri=True)


RECORD_SQL = """
SELECT Z_PK, ZUNIQUEID, ZFIRSTNAME, ZLASTNAME, ZNICKNAME, ZORGANIZATION, ZJOBTITLE
FROM ZABCDRECORD
WHERE {where}
ORDER BY COALESCE(ZLASTNAME, ZORGANIZATION, ZFIRSTNAME) COLLATE NOCASE
"""

SEARCH_WHERE = """(
    COALESCE(ZFIRSTNAME, '') LIKE :q ESCAPE '\\'
    OR COALESCE(ZLASTNAME, '') LIKE :q ESCAPE '\\'
    OR COALESCE(ZNICKNAME, '') LIKE :q ESCAPE '\\'
    OR COALESCE(ZORGANIZATION, '') LIKE :q ESCAPE '\\'
    OR (COALESCE(ZFIRSTNAME, '') || ' ' || COALESCE(ZLASTNAME, '')) LIKE :q ESCAPE '\\'
    OR Z_PK IN (SELECT ZOWNER FROM ZABCDEMAILADDRESS WHERE ZADDRESS LIKE :q ESCAPE '\\')
    OR Z_PK IN (SELECT ZOWNER FROM ZABCDPHONENUMBER WHERE ZFULLNUMBER LIKE :q ESCAPE '\\')
)"""


def like_pattern(term):
    """Escape LIKE wildcards so a search for 'a_b' means a literal underscore."""
    escaped = term.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_")
    return f"%{escaped}%"


def children(conn, table, owner_col, pk, columns):
    cursor = conn.execute(
        f"SELECT {', '.join(columns)} FROM {table} WHERE {owner_col} = ?", (pk,)
    )
    return [dict(zip(columns, row)) for row in cursor.fetchall()]


def build_contact(conn, row):
    pk, unique_id, first, last, nickname, org, title = row

    emails = [
        {"label": label(item["ZLABEL"]), "address": item["ZADDRESS"]}
        for item in children(conn, "ZABCDEMAILADDRESS", "ZOWNER", pk, ["ZLABEL", "ZADDRESS"])
        if item["ZADDRESS"]
    ]
    phones = [
        {"label": label(item["ZLABEL"]), "number": item["ZFULLNUMBER"]}
        for item in children(conn, "ZABCDPHONENUMBER", "ZOWNER", pk, ["ZLABEL", "ZFULLNUMBER"])
        if item["ZFULLNUMBER"]
    ]

    # Some records carry only an email or phone; fall back to those rather than
    # rendering a useless "<unnamed>".
    name = " ".join(part for part in (first, last) if part).strip()
    if not name:
        name = org or nickname
    if not name and emails:
        name = emails[0]["address"]
    if not name and phones:
        name = phones[0]["number"]
    if not name:
        name = "<unnamed>"

    addresses = []
    for item in children(
        conn,
        "ZABCDPOSTALADDRESS",
        "ZOWNER",
        pk,
        ["ZLABEL", "ZSTREET", "ZCITY", "ZSTATE", "ZZIPCODE", "ZCOUNTRYNAME"],
    ):
        parts = {
            "label": label(item["ZLABEL"]),
            "street": item["ZSTREET"],
            "city": item["ZCITY"],
            "state": item["ZSTATE"],
            "zip": item["ZZIPCODE"],
            "country": item["ZCOUNTRYNAME"],
        }
        if any(value for key, value in parts.items() if key != "label"):
            addresses.append({k: v for k, v in parts.items() if v})

    try:
        note_row = conn.execute(
            "SELECT ZTEXT FROM ZABCDNOTE WHERE ZCONTACT = ?", (pk,)
        ).fetchone()
        note = note_row[0] if note_row else None
    except sqlite3.Error:
        note = None

    contact = {
        "id": unique_id,
        "name": name,
        "first_name": first,
        "last_name": last,
        "nickname": nickname,
        "company": org,
        "job_title": title,
        "emails": emails,
        "phones": phones,
        "addresses": addresses,
        "note": note,
        "contact_url": f"addressbook://{unique_id}" if unique_id else None,
    }
    return {k: v for k, v in contact.items() if v not in (None, "", [], {})}


def query(where, params, limit):
    """Run a query across every source db, deduping by contact id."""
    results, seen = [], set()
    for path in databases():
        if len(results) >= limit:
            break
        try:
            with connect(path) as conn:
                rows = conn.execute(RECORD_SQL.format(where=where), params).fetchall()
                for row in rows:
                    contact = build_contact(conn, row)
                    key = contact.get("id") or contact.get("name")
                    if key in seen:
                        continue
                    seen.add(key)
                    results.append(contact)
                    if len(results) >= limit:
                        break
        except sqlite3.Error as error:
            print(f"warning: could not read {path}: {error}", file=sys.stderr)
    return results


def format_plain(contacts):
    lines = []
    for contact in contacts:
        header = contact["name"]
        if contact.get("company") and contact["company"] != header:
            header += f" ({contact['company']})"
        lines.append(header)
        for email in contact.get("emails", []):
            lines.append(f"  email  {email['address']}" + (f"  [{email['label']}]" if email.get("label") else ""))
        for phone in contact.get("phones", []):
            lines.append(f"  phone  {phone['number']}" + (f"  [{phone['label']}]" if phone.get("label") else ""))
        for address in contact.get("addresses", []):
            where = ", ".join(
                address[k] for k in ("street", "city", "state", "zip") if address.get(k)
            )
            if where:
                lines.append(f"  addr   {where}")
        lines.append("")
    return "\n".join(lines).rstrip()


def emit(contacts, as_json):
    if as_json:
        print(json.dumps(contacts, indent=2, ensure_ascii=False))
    elif not contacts:
        print("No contacts found")
    else:
        print(format_plain(contacts))


def main():
    parser = argparse.ArgumentParser(
        prog="apple-contacts",
        description="Query the local Apple Contacts database (read-only).",
    )
    parser.add_argument(
        "--version", action="version", version=f"apple-contacts {__version__}"
    )
    sub = parser.add_subparsers(dest="command", required=True)

    search = sub.add_parser("search", help="Search by name, company, email, or phone")
    search.add_argument("term", help="Search term (substring match)")
    search.add_argument("--limit", type=int, default=25, help="Max results (default 25)")

    get = sub.add_parser("get", help="Fetch one contact by id")
    get.add_argument("id", help="Contact id, from `search --json`")

    listing = sub.add_parser("list", help="List all contacts")
    listing.add_argument("--limit", type=int, default=100, help="Max results (default 100)")

    for name in ("search", "get", "list"):
        target = {"search": search, "get": get, "list": listing}[name]
        group = target.add_mutually_exclusive_group()
        group.add_argument("--json", action="store_true", help="Output as JSON")
        group.add_argument("--plain", action="store_true", help="Output as text")

    args = parser.parse_args()

    if not databases():
        print(f"error: no AddressBook database found under {AB_BASE}", file=sys.stderr)
        return 1

    if args.command == "search":
        contacts = query(SEARCH_WHERE, {"q": like_pattern(args.term)}, args.limit)
    elif args.command == "get":
        contacts = query("ZUNIQUEID = :q", {"q": args.id}, 1)
    else:
        contacts = query(
            "(ZFIRSTNAME IS NOT NULL OR ZLASTNAME IS NOT NULL OR ZORGANIZATION IS NOT NULL)",
            {},
            args.limit,
        )

    # JSON is the default; --plain opts out.
    emit(contacts, as_json=not args.plain)

    if not contacts and args.command == "get":
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
