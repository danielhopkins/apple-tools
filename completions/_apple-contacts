#compdef apple-contacts
# zsh completion for apple-contacts (argparse, so hand-written).
#
# Search terms and contact IDs are free text: completing them would mean
# querying the AddressBook databases on every TAB.

_apple-contacts() {
    local -a commands
    commands=(
        'search:Search by name, company, email, or phone'
        'get:Fetch one contact by id'
        'list:List all contacts'
    )

    # --json and --plain are mutually exclusive on every subcommand.
    local -a output_flags
    output_flags=(
        '(--plain)--json[Output as JSON (default)]'
        '(--json)--plain[Output as text]'
    )

    local curcontext="$curcontext" state
    _arguments -C \
        '(- *)--help[Show usage]' \
        '(- *)--version[Print the version]' \
        '1: :->command' \
        '*:: :->args'

    case $state in
        command)
            _describe -t commands 'command' commands
            ;;
        args)
            case $words[1] in
                search)
                    _arguments \
                        $output_flags \
                        '--limit[Max results (default 25)]:count:' \
                        '--help[Show usage]' \
                        '1:search term:'
                    ;;
                get)
                    _arguments \
                        $output_flags \
                        '--help[Show usage]' \
                        '1:contact id (UUID:ABPerson):'
                    ;;
                list)
                    _arguments \
                        $output_flags \
                        '--limit[Max results (default 100)]:count:' \
                        '--help[Show usage]'
                    ;;
            esac
            ;;
    esac
}

_apple-contacts "$@"
