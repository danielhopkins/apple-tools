    local -i ret=1
    local -ar arg_specs=(
        '--since[Only calls from the last N days]:since:'
        '--before[Only calls older than N days]:before:'
        '--missed[Only calls you missed]'
        '--incoming[Only calls you received]'
        '--outgoing[Only calls you placed]'
        '--unknown[Only callers who are not in Contacts]'
        '--blocked-only[Only callers on your blocked list]'
        '--kind[Restrict to phone, facetime-audio, or facetime-video]:kind:'
        '--handle[Restrict to one number or Apple ID]:handle:'
        '--limit[Maximum calls to list]:limit:'
        '--json[Output as JSON]'
        '--version[Show the version.]'
        '(-h --help)'{-h,--help}'[Show help information.]'
    )
    _arguments -w -s -S : "${arg_specs[@]}" && ret=0

    return "${ret}"
}

