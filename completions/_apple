#compdef apple
# zsh completion for the apple-tools dispatcher.
#
# After the tool name this hands off to the underlying command's own completion
# (_apple-notes, _apple-mail, ...) by rewriting words[1] and calling _normal.
# That way `apple calendar events --<TAB>` offers exactly what
# `apple-calendar events --<TAB>` does, with nothing duplicated here.

_apple() {
    local -a tools
    tools=(
        'notes:Search, export, and link Apple Notes'
        'mail:Search and export Apple Mail messages'
        'messages:Search and export iMessage/SMS history'
        'phone:Read call history and place calls'
        'maps:Read visited places and guides'
        'reminders:Read and write Reminders'
        'calendar:Read and write Calendar events'
        'contacts:Query Contacts'
    )
    # Enabled plugins complete like tools. `apple-plugins enabled` is a
    # subprocess, so it runs only when the tool position is being completed.
    local -a plugins
    if (( $+commands[apple-plugins] )); then
        plugins=(${(f)"$(apple-plugins enabled 2>/dev/null \
            | python3 -c 'import json,sys
for r in json.load(sys.stdin): print("%s:%s" % (r["name"], r["manifest"].get("description","plugin")))' 2>/dev/null)"})
    fi

    local -a top_level
    top_level=(
        'status:Permission state of every tool and enabled plugin, without prompting'
        'plugins:Find, enable and configure plugins'
        '--help:Show usage'
        '--version:Print the apple-tools version'
        '--which:Print the resolved path of each tool'
    )

    local curcontext="$curcontext" state
    _arguments -C \
        '1: :->tool' \
        '*:: :->args'

    case $state in
        tool)
            _describe -t tools 'tool' tools
            (( ${#plugins} )) && _describe -t plugins 'plugin' plugins
            _describe -t options 'option' top_level
            ;;
        args)
            local target
            case $words[1] in
                notes)     target=apple-notes ;;
                mail)      target=apple-mail ;;
                messages)  target=apple-messages ;;
                phone)     target=apple-phone ;;
                maps)      target=apple-maps ;;
                reminders) target=reminders ;;
                calendar)  target=apple-calendar ;;
                contacts)  target=apple-contacts ;;
                plugins)
                    local -a sub
                    sub=(
                        'list:Every plugin found or configured'
                        'enable:Let apple NAME run, and the index read it'
                        'disable:Make it invisible again'
                        'config:Show or set key=value; secrets go to the Keychain'
                        'manifest:Print a plugin manifest'
                    )
                    if (( CURRENT == 2 )); then
                        _describe -t sub 'subcommand' sub
                    else
                        local -a names
                        names=(${(f)"$(apple-plugins list --json 2>/dev/null \
                            | python3 -c 'import json,sys
for r in json.load(sys.stdin): print(r["name"])' 2>/dev/null)"})
                        _describe -t names 'plugin' names
                    fi
                    return
                    ;;
                *)         return 1 ;;
            esac

            # Re-dispatch as if the user had typed the underlying command, so
            # its own completion function handles the rest.
            words[1]=$target
            _normal
            ;;
    esac
}

_apple "$@"
