# calls
# --------------------------------------------------------------------------

def calls(store, start=None):
    if store.calls_db is None:
        return []
    db = store.calls_db
    parts = {}
    for r in db.execute("SELECT Z1PARTICIPANTS AS event, ZJIDSTRING AS jid, ZOUTCOME AS outcome "
                        "FROM ZWACDCALLEVENTPARTICIPANT"):
        parts.setdefault(r["event"], []).append(r["jid"])
    events = {}
    for r in db.execute("SELECT Z_PK, Z1CALLEVENTS AS aggregate, ZDURATION AS duration, "
                        "ZDATE AS date, ZOUTCOME AS outcome, ZGROUPJIDSTRING AS grp, "
                        "ZCALLIDSTRING AS call_id FROM ZWACDCALLEVENT"):
        events.setdefault(r["aggregate"], []).append(r)
    out = []
    for a in db.execute("SELECT Z_PK AS id, ZINCOMING AS incoming, ZMISSED AS missed, "
                        "ZVIDEO AS video, ZFIRSTDATE AS first FROM ZWAAGGREGATECALLEVENT "
                        "ORDER BY ZFIRSTDATE"):
        ts = when(a["first"])
        if start is not None and ts is not None and ts < start:
            continue
        legs = events.get(a["id"], [])
        who = []
        for leg in legs:
            for jid in parts.get(leg["Z_PK"], []):
                handle, name = store.who(jid)
                if handle not in [w["handle"] for w in who]:
                    who.append({"handle": handle, "name": name})
        group = next((leg["grp"] for leg in legs if leg["grp"]), None)
        seconds = sum(float(leg["duration"] or 0) for leg in legs)
        out.append({
            "id": a["id"],
            "call_id": next((leg["call_id"] for leg in legs if leg["call_id"]), None),
            "date": iso(ts), "timestamp": ts,
            "direction": "incoming" if a["incoming"] else "outgoing",
            "missed": bool(a["missed"]),
            "connected": seconds > 0,
            "video": bool(a["video"]),
            "duration": int(round(seconds)),
            "participants": who,
            "group": store.who(group)[1] if group else None,
        })
    return out


def call_title(c):
    names = ", ".join(p["name"] for p in c["participants"]) or "?"
    what = "video call" if c["video"] else "call"
    if c["missed"]:
        return "Missed WhatsApp %s %s %s" % (what, "from" if c["direction"] == "incoming" else "to", names)
    return "WhatsApp %s %s %s" % (what, "from" if c["direction"] == "incoming" else "to", names)


