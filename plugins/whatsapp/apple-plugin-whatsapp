def window(opts):
    start = end = None
    if getattr(opts, "since", None) is not None:
        start = (dt.datetime.now() - dt.timedelta(days=opts.since)).timestamp()
    if getattr(opts, "before", None) is not None:
        end = (dt.datetime.now() - dt.timedelta(days=opts.before)).timestamp()
    return start, end


def public(message):
    return {k: v for k, v in message.items() if k != "timestamp"}


def print_messages(messages, show_chat):
    for m in messages:
        prefix = "%s  " % short(m["timestamp"])
        if show_chat:
            prefix += "[%s] " % m["chat"]
        print("%s%s: %s" % (prefix, m["sender"], m["text"]))


def cmd_manifest(opts):
    print(json.dumps(MANIFEST, indent=2))


def cmd_status(opts):
    """What is on disk and whether it can be read. Never writes, never
    prompts, and exits 0 with --json whatever it finds."""
    path = folder(opts)
    report = {"tool": NAME, "hosts": [], "usable": False, "status": "missing",
              "advice": None, "folder": path,
              "app_installed": os.path.isdir("/Applications/WhatsApp.app")}
    chat_path = os.path.join(path, "ChatStorage.sqlite")
    try:
        db = connect(chat_path)
    except NoAccess:
        db = None
        report["status"] = "denied"
        report["advice"] = ("the store exists and cannot be read. Grant Full Disk Access "
                            "to the terminal or app running this, in System Settings → "
                            "Privacy & Security.")
    if db is None and report["status"] == "missing":
        report["advice"] = ("no ChatStorage.sqlite in %s. Install WhatsApp from the App "
                            "Store and link it to the phone (WhatsApp on the phone → "
                            "Settings → Linked Devices)." % path)
    if db is not None:
        try:
            r = db.execute("SELECT count(*) AS n, min(ZMESSAGEDATE) AS first, "
                           "max(ZMESSAGEDATE) AS last FROM ZWAMESSAGE").fetchone()
            report["messages"] = r["n"]
            report["first_message"] = iso(when(r["first"]))
            report["last_message"] = iso(when(r["last"]))
            report["chats"] = db.execute("SELECT count(*) FROM ZWACHATSESSION "
                                         "WHERE coalesce(ZREMOVED, 0) = 0").fetchone()[0]
            report["status"] = "ok"
            report["usable"] = True
        except sqlite3.DatabaseError as e:
            report["status"] = "unreadable"
            report["advice"] = "ChatStorage.sqlite did not answer: %s" % e
        db.close()
    for name, table, key in (("ContactsV2.sqlite", "ZWAADDRESSBOOKCONTACT", "address_book"),
                             ("CallHistory.sqlite", "ZWAAGGREGATECALLEVENT", "calls")):
        try:
            other = connect(os.path.join(path, name))
            report[key] = other.execute("SELECT count(*) FROM %s" % table).fetchone()[0] \
                if other is not None else None
        except (NoAccess, sqlite3.DatabaseError):
            report[key] = None
    if report["usable"]:
        report["advice"] = ("the Mac holds what WhatsApp Desktop received since it was "
                            "linked, plus a small sample from before; the rest of the "
                            "history is on the phone only.")
    if opts.json:
        print(json.dumps(report, indent=2))
        sys.exit(0)
    print("whatsapp: %s" % report["status"])
    print("  folder: %s" % path)
    if report["usable"]:
        print("  store: %d chats, %d messages (%s – %s), %s calls, %s address-book entries" % (
            report["chats"], report["messages"],
            (report["first_message"] or "?")[:10], (report["last_message"] or "?")[:10],
            report.get("calls") if report.get("calls") is not None else "no",
            report.get("address_book") if report.get("address_book") is not None else "no"))
    if report["advice"]:
        print("  %s" % report["advice"])
    sys.exit(0 if report["usable"] else 1)


def cmd_chats(opts):
    store = Store(opts)
    chats = store.chats()
    if opts.search:
        needle = opts.search.lower()
        chats = [c for c in chats if needle in (c["title"] or "").lower()
                 or needle in (c.get("handle") or "").lower()]
    total = len(chats)
    if opts.limit and total > opts.limit:
        chats = chats[:opts.limit]
        note("showing %d of %d chats" % (opts.limit, total))
    if opts.json:
        print(json.dumps(chats, indent=2, ensure_ascii=False))
        return
    for c in chats:
        extra = c.get("handle") or ("%d members" % c["members"] if c.get("members") else c["type"])
        print("%-5s %-16s %5d  %s  (%s)" % (c["id"], (c["last_message"] or "")[:16].replace("T", " "),
                                           c["message_count"], c["title"], extra))


def cmd_search(opts):
    store = Store(opts)
    wanted = terms(opts.query)
    if not wanted:
        die("an empty query matches everything; use `export` to read a chat", 64)
    chat = store.chat(opts.chat) if opts.chat else None
    start, end = window(opts)
    from_me = True if opts.from_me else (False if opts.to_me else None)
    hits = []
    for m in reversed(store.messages(chat["id"] if chat else None, start, end, from_me)):
        if m["kind"] in EVENTS and not opts.include_events:
            continue
        if matches(m, wanted):
            hits.append(m)
            if opts.limit and len(hits) >= opts.limit:
                note("stopped at --limit %d; older matches may exist" % opts.limit)
                break
    if opts.json:
        print(json.dumps([public(m) for m in hits], indent=2, ensure_ascii=False))
        return
    print_messages(hits, show_chat=chat is None)


def cmd_export(opts):
    store = Store(opts)
    chat = store.chat(opts.chat)
    rows = [m for m in store.messages(chat["id"])
            if opts.include_events or m["kind"] not in EVENTS]
    total = len(rows)
    if opts.limit and total > opts.limit:
        rows = rows[-opts.limit:]
        note("showing the last %d of %d messages" % (opts.limit, total))
    if opts.json:
        text = json.dumps({"chat": chat, "messages": [public(m) for m in rows]},
                          indent=2, ensure_ascii=False)
    else:
        lines = ["# %s" % chat["title"], ""]
        for m in rows:
            lines.append("%s  %s: %s" % (short(m["timestamp"]), m["sender"], m["text"]))
        text = "\n".join(lines)
    if opts.output:
        with open(opts.output, "w", encoding="utf-8") as f:
            f.write(text + "\n")
        note("wrote %d messages to %s" % (len(rows), opts.output))
    else:
        print(text)


def cmd_calls(opts):
    store = Store(opts)
    start, _ = window(opts)
    rows = calls(store, start)
    if opts.missed:
        rows = [c for c in rows if c["missed"]]
    rows.reverse()
    total = len(rows)
    if opts.limit and total > opts.limit:
        rows = rows[:opts.limit]
        note("showing %d of %d calls" % (opts.limit, total))
    if opts.json:
        print(json.dumps([{k: v for k, v in c.items() if k != "timestamp"} for c in rows],
                         indent=2, ensure_ascii=False))
        return
    for c in rows:
        length = duration(c["duration"]).strip() or "-"
        print("%s  %-8s %-6s %6s  %s" % (short(c["timestamp"]), c["direction"],
                                         "missed" if c["missed"] else ("video" if c["video"] else ""),
                                         length, ", ".join(p["name"] for p in c["participants"])))


def cmd_index(opts):
    """NDJSON for apple-index: one record per block of ten messages, one per call."""
    store = Store(opts)
    start, _ = window(opts)
    out = sys.stdout
    by_chat = {}
    for m in store.messages():
        if m["kind"] in EVENTS or not has_words(m):
            continue
        by_chat.setdefault(m["chat_id"], []).append(m)
    chats = {c["id"]: c for c in store.chats()}
    for chat_id, rows in by_chat.items():
        chat = chats[chat_id]
        url = None
        if chat["type"] == "chat" and (chat.get("handle") or "").startswith("+"):
            url = "whatsapp://send?phone=%s" % chat["handle"][1:]
        # 🛑 Blocks are cut from the START of the chat, so a new message
        # changes only the last block and every earlier uid stays put.
        for i in range(0, len(rows), BLOCK):
            block = rows[i:i + BLOCK]
            first, last = block[0], block[-1]
            if start is not None and last["timestamp"] < start:
                continue
            people, seen = [], set()
            for m in block:
                if m["handle"] not in seen:
                    seen.add(m["handle"])
                    people.append({"role": "handle", "name": m["sender"], "handle": m["handle"]})
            if chat["type"] == "chat" and chat.get("handle") and chat["handle"] not in seen:
                people.append({"role": "handle", "name": chat["title"], "handle": chat["handle"]})
            body = "\n".join("%s: %s" % (m["sender"], m["text"]) for m in block)
            # 🛑 The rev covers the body AND the handles. A card that claims
            # an @lid renames old messages without adding one, and a rev of
            # count and last id left every renamed record unchanged.
            rev = hashlib.sha1(json.dumps([body, people], ensure_ascii=False)
                               .encode("utf-8")).hexdigest()[:16]
            out.write(json.dumps({
                "uid": "whatsapp:chat:%s:%s" % (chat["jid"], first["guid"] or first["id"]),
                "tool": NAME, "kind": "conversation", "native_id": chat["jid"], "url": url,
                "title": "%s (%s)" % (chat["title"], (first["date"] or "")[:10]),
                "container": chat["title"],
                "created": first["timestamp"], "modified": None,
                "occurred": last["timestamp"],
                "latitude": None, "longitude": None,
                "people": people,
                "body": body,
                "rev": rev,
            }, ensure_ascii=False) + "\n")
    for c in calls(store, start):
        lines = [call_title(c)]
        if c["connected"]:
            lines.append("lasted%s" % duration(c["duration"]))
        if c["group"]:
            lines.append("in %s" % c["group"])
        out.write(json.dumps({
            "uid": "whatsapp:call:%s" % (c["call_id"] or c["id"]),
            "tool": NAME, "kind": "call", "native_id": str(c["id"]), "url": None,
            "title": call_title(c),
            "container": "Calls",
            "created": None, "modified": None,
            "occurred": c["timestamp"],
            "latitude": None, "longitude": None,
            "people": [{"role": "handle", "name": p["name"], "handle": p["handle"]}
                       for p in c["participants"]],
            "body": "\n".join(lines),
            "rev": "%s|%s|%s" % (c["missed"], c["duration"],
                                 ",".join("%s=%s" % (p["handle"], p["name"]) for p in c["participants"])),
        }, ensure_ascii=False) + "\n")
    out.flush()


# What `--json` prints, per subcommand, for `--help`. A caller who has to run
# the command to learn the field names guesses them, and jq answers a wrong
# guess with null rather than an error.
MESSAGE_FIELDS = """\
  date                 ISO 8601 with the local offset
  from_me              true for the user's own messages
  handle               +digits when a number is known, else the WhatsApp id;
                       "me" for the user
  sender               the address-book name, the chat name, or ~the name
                       the person set in WhatsApp
  text                 the message; media is folded in as [image] caption,
                       [voice note 0:30], [document] title, [link: title]
  kind                 text, image, video, audio, contact, location, link,
                       document, gif, sticker, deleted, poll, event, notice, other
  type                 WhatsApp's raw ZMESSAGETYPE, for a kind shown as other
  chat, chat_id, chat_type   where it was said
  id, guid             store row and WhatsApp's own message id
  media_path           relative to the folder's Message/ directory, when present
  latitude, longitude  a shared location only"""

JSON_FIELDS = {
    "chats": """\
JSON: a list, one object per chat, most recent first.
  id                   what export and --chat take
  jid                  WhatsApp's id for the chat
  type                 chat, group, broadcast, status
  title                the chat's name
  handle               one-to-one only: +digits, or the id when no number is known
  members              groups only: active members
  message_count        messages, not counting events and notices
  last_message, date   ISO 8601
  unread, archived""",
    "search": "JSON: a list, one object per message, newest first.\n" + MESSAGE_FIELDS,
    "export": "JSON: {chat, messages}; messages oldest first.\n" + MESSAGE_FIELDS,
    "calls": """\
JSON: a list, one object per call, newest first.
  date                 ISO 8601
  direction            incoming or outgoing
  missed, connected    connected means some time was spent on the call
  video                true for a video call
  duration             seconds
  participants         list of {handle, name}
  group                the group's name, for a group call
  id, call_id""",
}


def main(argv=None):
    parser = argparse.ArgumentParser(prog="apple whatsapp", description=__doc__.split("\n\n")[0])
    parser.add_argument("--version", action="version", version="apple-plugin-whatsapp %s" % VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--folder", help="the folder holding ChatStorage.sqlite; overrides the configured one")
    common.add_argument("--json", action="store_true", help="print JSON; the fields are listed below")
    ranged = argparse.ArgumentParser(add_help=False)
    ranged.add_argument("--since", type=int, metavar="DAYS")
    ranged.add_argument("--before", type=int, metavar="DAYS")

    sub = parser.add_subparsers(dest="command")
    sub.add_parser("manifest", parents=[common]).set_defaults(func=cmd_manifest)
    sub.add_parser("status", parents=[common]).set_defaults(func=cmd_status)

    p = sub.add_parser("chats", parents=[common], help="conversations, most recent first")
    p.add_argument("search", nargs="?", help="only chats whose name or number contains this")
    p.add_argument("--limit", type=int, default=100)
    p.set_defaults(func=cmd_chats)

    p = sub.add_parser("search", parents=[common, ranged], help="messages containing every term")
    p.add_argument("query")
    p.add_argument("--chat", help="an id, WhatsApp id, number or name from `chats`")
    p.add_argument("--limit", type=int, default=50)
    who = p.add_mutually_exclusive_group()
    who.add_argument("--from-me", action="store_true")
    who.add_argument("--to-me", action="store_true")
    p.add_argument("--include-events", action="store_true", help="also joins, leaves and notices")
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("export", parents=[common], help="one conversation")
    p.add_argument("chat", help="an id, WhatsApp id, number or name from `chats`")
    p.add_argument("--limit", type=int, default=0, help="the last N messages; 0 for all")
    p.add_argument("--include-events", action="store_true", help="also joins, leaves and notices")
    p.add_argument("-o", "--output", help="write to this file")
    p.set_defaults(func=cmd_export)

    p = sub.add_parser("calls", parents=[common, ranged], help="voice and video calls")
    p.add_argument("--missed", action="store_true")
    p.add_argument("--limit", type=int, default=100)
    p.set_defaults(func=cmd_calls)

    p = sub.add_parser("index", parents=[common, ranged], help="NDJSON records for apple-index")
    p.add_argument("--full", action="store_true", help="accepted; index always emits everything")
    p.set_defaults(func=cmd_index)

    for name, text in JSON_FIELDS.items():
        sub.choices[name].epilog = text
        sub.choices[name].formatter_class = argparse.RawDescriptionHelpFormatter

    opts = parser.parse_args(argv)
    if not opts.command:
        parser.print_help()
        return 0
    try:
        opts.func(opts)
    except NoAccess as e:
        die("cannot read %s. Grant Full Disk Access to the terminal or app running "
            "this, in System Settings → Privacy & Security." % e, 77)
    return 0


if __name__ == "__main__":
    sys.exit(main())
