#!/usr/bin/env python3
"""apple-plugin-whatsapp - WhatsApp chats and calls, from WhatsApp Desktop's own store.

WhatsApp Desktop for Mac keeps its data in plain SQLite, Core Data style,
in its group container. This plugin reads three of those files and writes
nothing, anywhere:

  ChatStorage.sqlite   chats, messages, group members, media captions
  ContactsV2.sqlite    WhatsApp's copy of the address book: the only place
                       that maps an @lid id to a phone number
  CallHistory.sqlite   voice and video calls

🛑 THE MAC HOLDS WHAT ARRIVED SINCE WHATSAPP DESKTOP WAS LINKED, and a thin
sample from before. The full history lives on the phone and nothing on a
Mac can read it. Measured on the first run: 157 messages in 20 chats, 138
of them from the month the app was linked. The history grows only while
the Desktop app stays linked.

🛑 A PERSON HAS TWO KINDS OF ID. `<number>@s.whatsapp.net` carries a phone
number; `<n>@lid` is an opaque id newer WhatsApp uses instead, and carries
none. ContactsV2 maps every @lid it knows (314 of 314 here) to the number.
A handle this plugin reports is `+<digits>` when a number is known, the raw
id when it is not — so a phone that is on a card in Contacts matches it,
and one that is not is content, never a guessed person — unless a card
claims the @lid with a `WhatsApp: whatsapp-lid:<n>` URL (see LID_URL).

It makes no connection. It opens every file read-only, through SQLite, so
the write-ahead log — where WhatsApp keeps its newest messages — is read
too. `immutable=1` would skip it.

    apple plugins enable whatsapp
    apple whatsapp chats
    apple whatsapp search "board meeting" --since 30
    apple whatsapp export "District Parent Council" --limit 50
    apple whatsapp calls --since 30

`index` is what apple-index calls: one record per BLOCK of ten messages in a
chat, the shape `apple messages` gets, and one per call.
"""
import argparse
import datetime as dt
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import urllib.parse

VERSION = "26.924.0"
NAME = "whatsapp"

HOME = os.path.expanduser("~")
DEFAULT_FOLDER = os.path.join(HOME, "Library", "Group Containers",
                              "group.net.whatsapp.WhatsApp.shared")
APPLE_EPOCH = 978307200
BLOCK = 10          # messages per index record, the `apple messages` default

MANIFEST = {
    "name": NAME,
    "version": VERSION,
    "description": "WhatsApp chats, group messages, captions and calls, read from "
                   "WhatsApp Desktop's store on this Mac",
    # No hosts. The files are local and nothing here connects anywhere.
    "network": {"hosts": [], "writes": False},
    "commands": ["status", "chats", "search", "export", "calls", "index"],
    "index": {
        "kinds": ["conversation", "call"],
        # The store is local and small, and a full run costs well under a
        # second; a reconcile every refresh keeps a deleted chat out.
        "refresh_args": ["--full"],
        "container_label": "By chat",
        "footnote": "A record is a block of ten messages in one chat, or one "
                    "call. The Mac holds only what WhatsApp Desktop has "
                    "received since it was linked, plus a small sample from "
                    "before; the full history stays on the phone.",
    },
    "config": [
        {"key": "folder", "required": False, "secret": False,
         "help": "The folder holding ChatStorage.sqlite. Default: WhatsApp "
                 "Desktop's group container"},
    ],
}

# ZWAMESSAGE.ZMESSAGETYPE. Measured on this store, and matched against the
# rows' own media: a caption in ZTITLE on 1, a duration on 2 and 3, a vCard
# name on 4, a link title on 7, a file on 8.
KINDS = {
    0: "text", 1: "image", 2: "video", 3: "audio", 4: "contact", 5: "location",
    6: "event", 7: "link", 8: "document", 10: "notice", 11: "gif",
    14: "deleted", 15: "sticker", 46: "poll",
}
# 🛑 6 is a group event (joined, left, renamed) and 10 a system notice
# (security code changed, a call placed). Neither was written by a person,
# so both stay out unless --include-events asks, the `apple messages` rule.
EVENTS = {"event", "notice"}

# ZWACHATSESSION.ZSESSIONTYPE
CHAT_TYPES = {0: "chat", 1: "group", 2: "broadcast", 3: "status"}


def die(message, code=1):
    print("error: %s" % message, file=sys.stderr)
    sys.exit(code)


def note(message):
    print(message, file=sys.stderr)


# --------------------------------------------------------------------------
# configuration
# --------------------------------------------------------------------------

def plugin_manager():
    if os.environ.get("APPLE_PLUGINS_BIN"):
        return [os.environ["APPLE_PLUGINS_BIN"]]
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (os.path.join(here, "..", "..", "bin", "apple-plugins"),
                      os.path.join(here, "..", "..", "apple-plugins"),
                      os.path.join(here, "..", "..", "..", "Helpers", "apple-plugins")):
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return [candidate]
    found = shutil.which("apple-plugins")
    if found:
        return [found]
    found = shutil.which("apple")
    if found:
        return [found, "plugins"]
    return None


def stored_config():
    manager = plugin_manager()
    if manager is None:
        return {}
    try:
        proc = subprocess.run(manager + ["config", NAME, "--json"],
                              capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return {}
    if proc.returncode != 0:
        return {}
    try:
        return json.loads(proc.stdout).get("config") or {}
    except ValueError:
        return {}


def folder(opts):
    """--folder, then $WHATSAPP_FOLDER, then the configured one, then the
    group container. The config is asked for only when nothing nearer
    answers, because asking costs a subprocess."""
    if getattr(opts, "folder", None):
        return os.path.expanduser(opts.folder)
    if os.environ.get("WHATSAPP_FOLDER"):
        return os.path.expanduser(os.environ["WHATSAPP_FOLDER"])
    configured = stored_config().get("folder")
    if configured:
        return os.path.expanduser(configured)
    return DEFAULT_FOLDER


# --------------------------------------------------------------------------
# the store
# --------------------------------------------------------------------------

class NoAccess(Exception):
    pass


def connect(path):
    """Read-only, WAL included. None when the file does not exist."""
    if not os.path.isfile(path):
        return None
    try:
        with open(path, "rb"):
            pass
    except PermissionError as e:
        raise NoAccess(path) from e
    uri = "file:%s?mode=ro" % urllib.parse.quote(path)
    db = sqlite3.connect(uri, uri=True, timeout=5)
    db.row_factory = sqlite3.Row
    return db


# ⚠️ WhatsApp's own "WhatsApp" chat carries a last-message date in the year
# 4000, a sentinel. Anything more than a year ahead is read as no date.
FAR_FUTURE = 366 * 86400


def when(apple_seconds):
    if apple_seconds is None:
        return None
    ts = float(apple_seconds) + APPLE_EPOCH
    if ts > dt.datetime.now().timestamp() + FAR_FUTURE:
        return None
    return ts


def iso(ts):
    if ts is None:
        return None
    return dt.datetime.fromtimestamp(ts).astimezone().isoformat(timespec="seconds")


def short(ts):
    if ts is None:
        return "?"
    return dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")


def local_part(jid):
    return (jid or "").split("@", 1)[0]


# 🛑 WhatsApp wraps names and numbers in bidirectional-text controls — a
# number shows as U+202A "+1 (940) 290‑7669" U+202C — so an exact match or a
# `jq` test on a name fails on characters nobody can see.
BIDI = re.compile("[\u200e\u200f\u202a-\u202e\u2066-\u2069]")


def clean(text):
    return BIDI.sub("", text).strip() if text else text


PHONE_LIKE = re.compile(r"^\+[\d\s()\-\u2011.]{6,}$")


def phone_in(name):
    """A name that IS a number. WhatsApp lists someone outside the address
    book under their number, so an @lid chat that ContactsV2 cannot map
    still carries it in the chat's title."""
    name = clean(name) or ""
    if PHONE_LIKE.match(name):
        return "+" + re.sub(r"\D", "", name)
    return None


def number_of(jid):
    """+digits for a number id. `0@s.whatsapp.net` is WhatsApp itself."""
    if (jid or "").endswith("@s.whatsapp.net"):
        digits = local_part(jid)
        if digits.isdigit() and len(digits) > 4:
            return "+" + digits
    return None


# 🛑 A CARD CAN CLAIM AN @lid, because nothing else can. WhatsApp hides a
# group member's number behind an @lid, and ContactsV2 maps one only for
# people in the phone's address book. So the user writes the id on the card
# as a URL labelled WhatsApp:
#
#     apple contacts edit <id> --add-url "WhatsApp:whatsapp-lid:63080235049176"
#
# It opens nothing — wa.me needs a number and no link format takes an @lid —
# it is a claim. Every URL on every card is read, and one that names an
# @lid gives that id the card's name and the card's handle: its first phone,
# else its first email, so the record matches the card the way a mail does.
LID_URL = re.compile(r"^(?:whatsapp-lid:(\d+)|(\d+)@lid)$", re.IGNORECASE)


def card_phone(number):
    digits = re.sub(r"\D", "", number or "")
    if not digits:
        return None
    if (number or "").strip().startswith("+"):
        return "+" + digits
    if len(digits) == 10:
        return "+1" + digits
    return "+" + digits


def card_links():
    """@lid -> {name, handle, contact_id}, from the cards that claim one.

    $WHATSAPP_CARDS names a JSON file standing in for `apple contacts list`,
    for tests; the suite must never read the user's address book. A failed
    read costs the links and says so, and never stops a command."""
    path = os.environ.get("WHATSAPP_CARDS")
    try:
        if path:
            with open(path, encoding="utf-8") as f:
                cards = json.load(f)
        else:
            apple = shutil.which("apple")
            if apple is None:
                return {}
            proc = subprocess.run([apple, "contacts", "list", "--limit", "1000000", "--json"],
                                  capture_output=True, text=True, timeout=60)
            if proc.returncode != 0:
                note("whatsapp: could not read Contacts, so no card links: %s"
                     % (proc.stderr.strip().splitlines() or ["exit %d" % proc.returncode])[-1])
                return {}
            cards = json.loads(proc.stdout)
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        note("whatsapp: could not read Contacts, so no card links: %s" % e)
        return {}
    links = {}
    for card in cards:
        for url in card.get("urls") or []:
            m = LID_URL.match((url.get("url") or "").strip())
            if not m:
                continue
            phones = [card_phone(p.get("number")) for p in card.get("phones") or []]
            emails = [e.get("address") for e in card.get("emails") or [] if e.get("address")]
            handle = next((x for x in phones if x), None) or (emails[0].lower() if emails else None)
            links["%s@lid" % (m.group(1) or m.group(2))] = {
                "name": card.get("name"), "handle": handle, "contact_id": card.get("id")}
    return links


class Store:
    """The three files, and the one question every command asks of them:
    who is this id."""

    def __init__(self, opts):
        self.folder = folder(opts)
        self.chat_db = connect(os.path.join(self.folder, "ChatStorage.sqlite"))
        if self.chat_db is None:
            die("no ChatStorage.sqlite in %s. Is WhatsApp Desktop installed and "
                "linked?" % self.folder, 66)
        self.contacts_db = connect(os.path.join(self.folder, "ContactsV2.sqlite"))
        self.calls_db = connect(os.path.join(self.folder, "CallHistory.sqlite"))
        self._people = None
        self._chats = None
        self._links = None

    def links(self):
        if self._links is None:
            self._links = card_links()
        return self._links

    # ---- people ----------------------------------------------------------

    def people(self):
        """jid -> {name, phone} from every source that names anyone.

        Order is priority: the address book's own name, then the name the
        chat is listed under, then the group-member row, then the name the
        person set for themselves in WhatsApp, marked with `~` the way
        WhatsApp itself marks one.
        """
        if self._people is not None:
            return self._people
        people = {}

        def put(jid, name=None, phone=None):
            if not jid:
                return
            name = clean(name)
            entry = people.setdefault(jid, {"name": None, "phone": None})
            if name and not entry["name"]:
                entry["name"] = name
            if phone and not entry["phone"]:
                entry["phone"] = phone

        if self.contacts_db is not None:
            for r in self.contacts_db.execute(
                    "SELECT ZLID, ZWHATSAPPID, ZPHONENUMBER, ZFULLNAME, ZBUSINESSNAME "
                    "FROM ZWAADDRESSBOOKCONTACT"):
                name = r["ZFULLNAME"] or r["ZBUSINESSNAME"]
                phone = r["ZPHONENUMBER"]
                if not phone and (r["ZWHATSAPPID"] or "").endswith("@s.whatsapp.net"):
                    phone = "+" + local_part(r["ZWHATSAPPID"])
                # 🛑 The @lid row is the ONLY bridge from an opaque id to a
                # number. Measured: 314 of 314 rows here carry both.
                put(r["ZLID"], name, phone)
                put(r["ZWHATSAPPID"], name, phone)
        db = self.chat_db
        for r in db.execute("SELECT ZCONTACTJID, ZPARTNERNAME FROM ZWACHATSESSION "
                            "WHERE ZSESSIONTYPE = 0"):
            put(r["ZCONTACTJID"], r["ZPARTNERNAME"])
        for r in db.execute("SELECT ZMEMBERJID, ZCONTACTNAME FROM ZWAGROUPMEMBER"):
            put(r["ZMEMBERJID"], r["ZCONTACTNAME"])
        for r in db.execute("SELECT ZJID, ZPUSHNAME FROM ZWAPROFILEPUSHNAME"):
            if r["ZPUSHNAME"]:
                put(r["ZJID"], "~" + r["ZPUSHNAME"])
        # A number id carries its own phone, whether or not anything names it;
        # an @lid one may carry it in its name.
        for jid, entry in people.items():
            if not entry["phone"]:
                entry["phone"] = number_of(jid) or phone_in(entry["name"])
        self._people = people
        return people

    def who(self, jid):
        """(handle, name). The handle is +digits when a number is known."""
        if not jid:
            return ("?", "?")
        entry = self.people().get(jid) or {}
        phone = entry.get("phone") or number_of(jid)
        if jid.endswith("@lid"):
            card = self.links().get(jid)
            if card:
                # The card is the user's own word, so its name wins; a number
                # WhatsApp knows still beats an email as the handle.
                return (phone or card["handle"] or jid, card["name"] or phone or jid)
        handle = phone or jid
        return (handle, entry.get("name") or handle)

    # ---- chats -----------------------------------------------------------

    def chats(self):
        if self._chats is not None:
            return self._chats
        rows = self.chat_db.execute("""
            SELECT s.Z_PK AS id, s.ZCONTACTJID AS jid, s.ZPARTNERNAME AS title,
                   s.ZSESSIONTYPE AS type, s.ZARCHIVED AS archived,
                   s.ZUNREADCOUNT AS unread, s.ZLASTMESSAGEDATE AS last,
                   (SELECT count(*) FROM ZWAMESSAGE m WHERE m.ZCHATSESSION = s.Z_PK
                      AND m.ZMESSAGETYPE NOT IN (6, 10)) AS message_count,
                   (SELECT count(*) FROM ZWAGROUPMEMBER g WHERE g.ZCHATSESSION = s.Z_PK
                      AND g.ZISACTIVE = 1) AS members
            FROM ZWACHATSESSION s
            WHERE coalesce(s.ZREMOVED, 0) = 0
            ORDER BY s.ZLASTMESSAGEDATE DESC""").fetchall()
        rows = sorted(rows, key=lambda r: when(r["last"]) or 0, reverse=True)
        chats = []
        for r in rows:
            kind = CHAT_TYPES.get(r["type"], "other")
            chat = {
                "id": r["id"], "jid": r["jid"], "type": kind,
                "title": clean(r["title"]) or r["jid"],
                "message_count": r["message_count"],
                "last_message": iso(when(r["last"])),
                "date": iso(when(r["last"])),
                "unread": r["unread"] or 0,
                "archived": bool(r["archived"]),
            }
            if kind == "chat":
                handle, name = self.who(r["jid"])
                chat["handle"] = handle
                chat["title"] = clean(r["title"]) or name
            if kind == "group":
                chat["members"] = r["members"]
            chats.append(chat)
        self._chats = chats
        return chats

    def chat(self, ref):
        """A chat by id, jid, phone number or title. Ambiguous is an error,
        not a guess — exporting the wrong conversation is a mistake nobody
        notices until later."""
        chats = self.chats()
        ref = str(ref).strip()
        if ref.isdigit():
            hit = [c for c in chats if c["id"] == int(ref)]
            if hit:
                return hit[0]
        hit = [c for c in chats if c["jid"] == ref]
        if hit:
            return hit[0]
        digits = re.sub(r"\D", "", ref)
        if ref.startswith("+") or (len(digits) >= 7 and len(digits) >= len(ref) - 4):
            hit = [c for c in chats if re.sub(r"\D", "", c.get("handle") or "") == digits]
            if len(hit) == 1:
                return hit[0]
        lowered = ref.lower()
        exact = [c for c in chats if (c["title"] or "").lower() == lowered]
        if len(exact) == 1:
            return exact[0]
        hit = exact or [c for c in chats if lowered in (c["title"] or "").lower()]
        if len(hit) == 1:
            return hit[0]
        if not hit:
            die("no chat matches %r. `apple whatsapp chats` lists them." % ref, 66)
        die("%r matches %d chats; use an id:\n%s" % (
            ref, len(hit), "\n".join("  %-6s %s" % (c["id"], c["title"]) for c in hit)), 64)

    # ---- messages --------------------------------------------------------

    def messages(self, chat_id=None, start=None, end=None, from_me=None):
        """Every message, oldest first, with its sender resolved and its
        media folded into one line of text."""
        where, args = [], []
        if chat_id is not None:
            where.append("m.ZCHATSESSION = ?")
            args.append(chat_id)
        if start is not None:
            where.append("m.ZMESSAGEDATE >= ?")
            args.append(start - APPLE_EPOCH)
        if end is not None:
            where.append("m.ZMESSAGEDATE < ?")
            args.append(end - APPLE_EPOCH)
        if from_me is not None:
            where.append("coalesce(m.ZISFROMME, 0) = ?")
            args.append(1 if from_me else 0)
        rows = self.chat_db.execute("""
            SELECT m.Z_PK AS id, m.ZCHATSESSION AS chat, m.ZMESSAGETYPE AS type,
                   m.ZISFROMME AS from_me, m.ZMESSAGEDATE AS date, m.ZTEXT AS text,
                   m.ZFROMJID AS from_jid, m.ZSTANZAID AS stanza, m.ZSTARRED AS starred,
                   g.ZMEMBERJID AS member_jid,
                   i.ZTITLE AS media_title, i.ZVCARDNAME AS vcard_name,
                   i.ZMEDIALOCALPATH AS media_path, i.ZLATITUDE AS lat,
                   i.ZLONGITUDE AS lon, i.ZMOVIEDURATION AS duration,
                   i.ZFILESIZE AS size
            FROM ZWAMESSAGE m
            LEFT JOIN ZWAGROUPMEMBER g ON g.Z_PK = m.ZGROUPMEMBER
            LEFT JOIN ZWAMEDIAITEM i ON i.Z_PK = m.ZMEDIAITEM
            %s
            ORDER BY m.ZMESSAGEDATE, m.Z_PK""" % (
                ("WHERE " + " AND ".join(where)) if where else ""), args).fetchall()
        chats = {c["id"]: c for c in self.chats()}
        out = []
        for r in rows:
            chat = chats.get(r["chat"])
            if chat is None:
                continue
            out.append(self.shape(r, chat))
        return out

    def shape(self, r, chat):
        kind = KINDS.get(r["type"], "other")
        ts = when(r["date"])
        if r["from_me"]:
            handle, name = "me", "me"
        else:
            # In a group the member row names the sender, and ZFROMJID is the
            # group. In a one-to-one chat ZFROMJID is the other person.
            jid = r["member_jid"]
            if not jid:
                jid = r["from_jid"]
                if not jid or jid.endswith("@g.us") or jid.endswith("@broadcast"):
                    jid = chat["jid"] if chat["type"] == "chat" else jid
            handle, name = self.who(jid)
        message = {
            "id": r["id"], "guid": r["stanza"], "chat_id": chat["id"],
            "chat": chat["title"], "chat_type": chat["type"],
            "date": iso(ts), "timestamp": ts,
            "from_me": bool(r["from_me"]), "handle": handle, "sender": name,
            "kind": kind, "type": r["type"],
            "text": render(kind, r),
        }
        if r["starred"]:
            message["starred"] = True
        if r["media_path"]:
            message["media_path"] = r["media_path"]
        if kind == "location" and valid_coordinate(r["lat"], r["lon"]):
            message["latitude"], message["longitude"] = r["lat"], r["lon"]
        return message


def valid_coordinate(lat, lon):
    # ⚠️ ZLATITUDE is not always a latitude: an image row here carries 654.0.
    return (lat is not None and lon is not None and -90 <= lat <= 90
            and -180 <= lon <= 180 and (lat, lon) != (0.0, 0.0))


def duration(seconds):
    if not seconds:
        return ""
    seconds = int(seconds)
    return " %d:%02d" % (seconds // 60, seconds % 60)


def render(kind, r):
    """One line of text for any message. A caption can sit in ZTEXT or in
    the media row's ZTITLE depending on the type; both are read and a
    repeat is dropped."""
    text = (r["text"] or "").strip()
    title = (r["media_title"] or "").strip()
    words = [x for x in (text, title) if x]
    if len(words) == 2 and words[0] == words[1]:
        words = words[:1]
    if kind in ("text", "other", "poll"):
        return " · ".join(words)
    if kind == "link":
        if text and title:
            return "%s [link: %s]" % (text, title)
        return text or title
    if kind == "contact":
        return "[contact: %s]" % (r["vcard_name"] or title or text or "?")
    if kind == "location":
        tag = "[location]"
        if valid_coordinate(r["lat"], r["lon"]):
            tag = "[location %.5f,%.5f]" % (r["lat"], r["lon"])
        return " ".join([tag] + words)
    if kind in ("video", "audio"):
        label = "voice note" if kind == "audio" else "video"
        return " ".join(["[%s%s]" % (label, duration(r["duration"]))] + words)
    if kind in EVENTS:
        return " ".join(["(%s)" % kind] + words)
    return " ".join(["[%s]" % kind] + words)


PLACEHOLDER = re.compile(r"^(\[[^\]]*\]|\([^)]*\))$")


def has_words(message):
    """A message worth indexing: something beyond a bare `[image]`."""
    text = (message["text"] or "").strip()
    return bool(text) and not PLACEHOLDER.match(text)


# --------------------------------------------------------------------------
# search
# --------------------------------------------------------------------------

def terms(query):
    """An AND of substring terms; double quotes keep a phrase together.
    Exactly the `apple mail` and `apple messages` semantics."""
    out = []
    for phrase, word in re.findall(r'"([^"]+)"|(\S+)', query or ""):
        term = (phrase or word).lower()
        if term:
            out.append(term)
    return out


def matches(message, wanted):
    haystack = (message["text"] or "").lower()
    return all(t in haystack for t in wanted)


