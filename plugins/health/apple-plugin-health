def cmd_status(opts):
    """What is on disk, and what the store holds. Never writes."""
    report = {"tool": NAME, "hosts": [], "usable": False, "status": "unconfigured",
              "advice": None, "folders": folders(opts), "store": store_path()}
    present = [f for f in report["folders"] if os.path.isdir(f)]
    files = daily_files(opts)
    report["daily_files"] = len(files)
    report["newest_daily_file"] = os.path.basename(files[-1]) if files else None
    if os.path.isfile(store_path()):
        db = sqlite3.connect(store_path())
        db.row_factory = sqlite3.Row
        try:
            row = db.execute("SELECT count(DISTINCT date) AS days, min(date) AS first, max(date) AS last FROM day").fetchone()
            report["days"] = row["days"]
            report["first_day"] = row["first"]
            report["last_day"] = row["last"]
            report["workouts"] = db.execute("SELECT count(*) FROM workout").fetchone()[0]
            report["nights"] = db.execute("SELECT count(*) FROM sleep").fetchone()[0]
            report["exports"] = [r["path"] for r in db.execute("SELECT path FROM file WHERE kind = 'export'")]
        except sqlite3.DatabaseError:
            report["days"] = 0
        db.close()
    else:
        report["days"] = 0
    if files or report["days"]:
        report["status"] = "ok"
        report["usable"] = True
        if not files and not report.get("exports"):
            report["status"] = "ok"
    if not files:
        report["advice"] = ("no file from the iPhone yet. Open AppleTools Health on the phone "
                            "and tap Export; the file appears in iCloud Drive within a minute. "
                            "The shortcut (apple health shortcut) and apple health import "
                            "export.zip are the other two routes.")
        if not report["days"]:
            report["status"] = "unconfigured"
            report["usable"] = False
    if opts.json:
        print(json.dumps(report, indent=2))
    else:
        print("health: %s" % report["status"])
        print("  folders: %s" % ", ".join(present or report["folders"]))
        print("  daily files: %d%s" % (len(files), " (newest %s)" % report["newest_daily_file"] if files else ""))
        print("  store: %d days, %d nights, %d workouts%s" % (
            report.get("days", 0), report.get("nights", 0), report.get("workouts", 0),
            " (%s – %s)" % (report["first_day"], report["last_day"]) if report.get("first_day") else ""))
        if report["advice"]:
            print("  %s" % report["advice"])
    sys.exit(0 if report["usable"] or opts.json else 1)


def cmd_import(opts):
