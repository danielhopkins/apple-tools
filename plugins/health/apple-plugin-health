def cmd_days(opts):
    db = open_store()
    sync(db, opts, quiet=True)
    start, end = date_window(opts, 14)
    days = day_rows(db, start, end)
    if opts.json:
        print(json.dumps([days[d] for d in sorted(days)], indent=2))
        return
    if not days:
        print("no days between %s and %s" % (start, end))
        return
    for date in sorted(days):
        day = days[date]
        print("%s  %s" % (date, "; ".join(describe_day(day))))


def cmd_workouts(opts):
    db = open_store()
    start, end = date_window(opts, 90)
    rows = workout_rows(db, start, end)
    if opts.type:
        rows = [w for w in rows if opts.type.lower() in w["type"].lower()]
    if opts.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print("no workouts between %s and %s%s" % (
            start, end, "" if db.execute("SELECT count(*) FROM workout").fetchone()[0]
            else " — run an export in the AppleTools Health app, or apple health import export.zip"))
        return
    total_m = sum(w["distance"] or 0 for w in rows)
    for w in rows:
        when = parse_when(w["start"])
        print("%s  %-28s %s" % (when.strftime("%Y-%m-%d %H:%M") if when else "?",
                                w["type"], "  ".join(describe_workout(w)[1:3])))
    if total_m:
        print("%d workouts, %s" % (len(rows), km_mi(total_m)))


def cmd_shortcut(opts):
    """Copy the signed shortcut somewhere the user can open it from the
    phone. The file ships beside this plugin."""
    here = os.path.dirname(os.path.realpath(__file__))
    source = os.path.join(here, SHORTCUT_NAME + ".shortcut")
    if not os.path.isfile(source):
        die("the shortcut file is not beside this plugin: %s" % source, 66)
    target_dir = os.path.expanduser(opts.to) if opts.to else os.path.join(ICLOUD, "apple-tools")
    os.makedirs(target_dir, exist_ok=True)
    target = os.path.join(target_dir, SHORTCUT_NAME + ".shortcut")
    shutil.copyfile(source, target)
    if opts.json:
        print(json.dumps({"path": target}))
        return
    print("copied to %s" % target)
    print("On the iPhone: open Files → iCloud Drive → apple-tools, tap the file, tap Add Shortcut.")
    print("Then run it. It saves health-<date>.txt into iCloud Drive/apple-tools/health.")


def cmd_log(opts):
    """The iPhone app's own log, mirrored into its container as log.txt."""
    paths = [os.path.join(f, "log.txt") for f in folders(opts)]
    found = [p for p in paths if os.path.isfile(p)]
    if not found:
        die("no log.txt from the app in %s" % ", ".join(folders(opts)), 66)
    lines = []
    for p in found:
        with open(p, encoding="utf-8", errors="replace") as f:
            lines += [l.rstrip("\n") for l in f if l.strip()]
    if opts.tail:
        lines = lines[-opts.tail:]
    if opts.json:
        rows = []
        for l in lines:
            parts = l.split("\t", 2)
            rows.append({"when": parts[0], "level": parts[1] if len(parts) > 1 else None,
                         "text": parts[2] if len(parts) > 2 else l})
        print(json.dumps(rows, indent=2))
        return
    for l in lines:
        print(l)


def _epoch_noon(date):
    """Noon, this Mac's zone, so the day survives `_local_day` in either
    direction of a zone change."""
    return dt.datetime.strptime(date + " 12:00", "%Y-%m-%d %H:%M").timestamp()


