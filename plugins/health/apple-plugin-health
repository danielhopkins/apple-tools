# the store
# --------------------------------------------------------------------------

SCHEMA = """
CREATE TABLE IF NOT EXISTS day (
    date    TEXT NOT NULL,        -- YYYY-MM-DD, the phone's local day
    metric  TEXT NOT NULL,
    value   REAL NOT NULL,        -- in the canonical unit for the metric
    unit    TEXT NOT NULL,
    source  TEXT NOT NULL,        -- 'shortcut' or 'export'
    file    TEXT NOT NULL,
    partial INTEGER NOT NULL DEFAULT 0,   -- the day was not over when written
    PRIMARY KEY (date, metric)
);
CREATE TABLE IF NOT EXISTS sleep (
    date     TEXT PRIMARY KEY,    -- the wake-up day
    start    TEXT, "end" TEXT,    -- ISO with offset, the night's span
    asleep   REAL NOT NULL,       -- minutes, every asleep stage together
    in_bed   REAL, core REAL, deep REAL, rem REAL, awake REAL,
    samples  INTEGER NOT NULL,
    source   TEXT NOT NULL, file TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS workout (
    id        TEXT PRIMARY KEY,   -- type|start|source
    type      TEXT NOT NULL,      -- Cycling, Running …
    start     TEXT NOT NULL, "end" TEXT NOT NULL,
    duration  REAL,               -- seconds
    distance  REAL,               -- metres
    energy    REAL,               -- kcal
    heart_rate REAL,              -- average bpm, when the export carries it
    source    TEXT,
    latitude  REAL, longitude REAL,   -- the route's first point, when there is one
    route     TEXT,               -- the GPX path inside the archive
    file      TEXT NOT NULL
);
CREATE TABLE IF NOT EXISTS file (
    path     TEXT PRIMARY KEY,
    mtime    REAL NOT NULL, size INTEGER NOT NULL,
    kind     TEXT NOT NULL,       -- 'daily' or 'export'
    read_at  TEXT NOT NULL,
    lines    INTEGER, days INTEGER, workouts INTEGER
);
"""


def open_store():
    path = store_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    db = sqlite3.connect(path)
    db.row_factory = sqlite3.Row
    db.executescript(SCHEMA)
    return db


# --------------------------------------------------------------------------
# time and units
# --------------------------------------------------------------------------

def parse_when(text):
    """`2026-09-15 07:25:44 -0600` (both the export and the shortcut write
    this) or ISO 8601 → aware datetime, or None."""
    if not text:
        return None
    text = str(text).strip()
    for pattern in ("%Y-%m-%d %H:%M:%S %z", "%Y-%m-%dT%H:%M:%S%z", "%Y-%m-%d %H:%M:%S%z"):
        try:
            return dt.datetime.strptime(text.replace("Z", "+0000"), pattern)
        except ValueError:
            pass
    try:
        when = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
        return when if when.tzinfo else when.replace(tzinfo=dt.timezone.utc)
    except ValueError:
        return None


def local_day(when):
    """The date in the sample's OWN offset — the phone's day, not this
    Mac's. A night's sleep that ends at 06:12 -0600 belongs to that day
    wherever the Mac is."""
    return when.strftime("%Y-%m-%d")


def number(text):
    """`8,412` → 8412.0. The shortcut coerces a number to text in the
    phone's locale; en_US puts a comma every three digits."""
    if text is None:
        return None
    cleaned = str(text).strip().replace(",", "")
    try:
        return float(cleaned)
    except ValueError:
        return None


def canonical(value, unit, want):
    """Convert `value unit` to the metric's canonical unit, or raise."""
    unit = (unit or "").strip()
    if unit == "s" and want == "ms":
        unit = "s (hrv)"
    if unit not in UNITS:
        raise ValueError("unknown unit %r" % unit)
    to, factor = UNITS[unit]
    if to != want:
        raise ValueError("unit %r is not a %s" % (unit, want))
    return value * factor


def iso(when):
    return when.isoformat() if when else None


def human_minutes(minutes):
    if minutes is None:
        return None
    minutes = int(round(minutes))
    hours, rest = divmod(minutes, 60)
    return "%dh %02dm" % (hours, rest) if hours else "%dm" % rest


def km_mi(metres):
    return "%.1f km (%.1f mi)" % (metres / 1000.0, metres / 1609.344)


