def day_rows(db, start, end):
    """{date: {metric: value, ..., 'sleep': {...}}} between two dates."""
    days = {}
    for r in db.execute("SELECT date, metric, value, source, partial FROM day "
                        "WHERE date >= ? AND date <= ? ORDER BY date", (start, end)):
        day = days.setdefault(r["date"], {"date": r["date"], "sources": set(), "partial": False})
        day[r["metric"]] = round(r["value"], 2)
        day["sources"].add(r["source"])
        day["partial"] = day["partial"] or bool(r["partial"])
    for r in db.execute("SELECT * FROM sleep WHERE date >= ? AND date <= ?", (start, end)):
        day = days.setdefault(r["date"], {"date": r["date"], "sources": set(), "partial": False})
        day["sleep"] = {k: (round(r[k], 1) if isinstance(r[k], float) else r[k])
                        for k in ("start", "end", "asleep", "in_bed", "core", "deep", "rem", "awake", "samples")}
        day["sources"].add(r["source"])
    for day in days.values():
        day["sources"] = sorted(day["sources"])
    return days


def describe_day(day):
    """The lines a day's record body carries, and the plain listing shows."""
    lines = []
    if "steps" in day:
        lines.append("%s steps" % format(int(round(day["steps"])), ","))
    if "walk_run_distance" in day:
        lines.append("walked %s" % km_mi(day["walk_run_distance"]))
    if day.get("cycling_distance"):
        lines.append("cycled %s" % km_mi(day["cycling_distance"]))
    if day.get("swimming_distance"):
        lines.append("swam %d m" % day["swimming_distance"])
    if "active_energy" in day:
        lines.append("%d kcal active" % day["active_energy"])
    if "exercise_minutes" in day:
        lines.append("%d min exercise" % day["exercise_minutes"])
    if "stand_minutes" in day:
        lines.append("%d min standing" % day["stand_minutes"])
    if day.get("flights"):
        lines.append("%d flights climbed" % day["flights"])
    if "resting_heart_rate" in day:
        lines.append("resting heart rate %d bpm" % day["resting_heart_rate"])
    if "walking_heart_rate" in day:
        lines.append("walking heart rate %d bpm" % day["walking_heart_rate"])
    if "hrv" in day:
        lines.append("heart rate variability %d ms" % day["hrv"])
    if "oxygen_saturation" in day:
        value = day["oxygen_saturation"]
        lines.append("oxygen saturation %d%%" % (value * 100 if value <= 1 else value))
    if "vo2_max" in day:
        lines.append("VO2 max %.1f" % day["vo2_max"])
    if "weight" in day:
        lines.append("weight %.1f kg (%.1f lb)" % (day["weight"], day["weight"] / 0.453592))
    sleep = day.get("sleep")
    if sleep:
        extra = ", in bed %s" % human_minutes(sleep["in_bed"]) if sleep.get("in_bed") else ""
        stages = [("%s %s" % (name, human_minutes(sleep[k])))
                  for k, name in (("deep", "deep"), ("core", "core"), ("rem", "REM"), ("awake", "awake"))
                  if sleep.get(k)]
        lines.append("slept %s%s" % (human_minutes(sleep["asleep"]), extra))
        if stages:
            lines.append("sleep stages: " + ", ".join(stages))
    if day.get("partial"):
        lines.append("day not over when written")
    return lines


def day_title(day):
    bits = []
    if "steps" in day:
        bits.append("%s steps" % format(int(round(day["steps"])), ","))
    if day.get("cycling_distance"):
        bits.append("%.1f km bike" % (day["cycling_distance"] / 1000.0))
    if day.get("sleep"):
        bits.append("slept %s" % human_minutes(day["sleep"]["asleep"]))
    when = dt.datetime.strptime(day["date"], "%Y-%m-%d")
    return "%s: %s" % (when.strftime("%a %-d %b %Y"), ", ".join(bits) if bits else "health")


def workout_rows(db, start, end):
    rows = []
    for r in db.execute("SELECT * FROM workout WHERE substr(start, 1, 10) >= ? "
                        "AND substr(start, 1, 10) <= ? ORDER BY start", (start, end)):
        rows.append({k: r[k] for k in r.keys()})
    return rows


def describe_workout(w):
    lines = [w["type"]]
    if w["duration"]:
        lines.append("%s" % human_minutes(w["duration"] / 60.0))
    if w["distance"]:
        lines.append(km_mi(w["distance"]))
    if w["energy"]:
        lines.append("%d kcal" % w["energy"])
    if w["heart_rate"]:
        lines.append("average heart rate %d bpm" % w["heart_rate"])
    if w["source"]:
        lines.append("recorded by %s" % w["source"])
    return lines


def workout_title(w):
    bits = [w["type"]]
    if w["duration"]:
        bits.append(human_minutes(w["duration"] / 60.0))
    if w["distance"]:
        bits.append("%.1f km" % (w["distance"] / 1000.0))
    return ", ".join(bits)


def date_window(opts, default_days):
    today = dt.date.today()
    if getattr(opts, "from_", None):
        start = opts.from_[:10]
    else:
        start = (today - dt.timedelta(days=opts.since if opts.since is not None else default_days)).isoformat()
    end = opts.to[:10] if getattr(opts, "to", None) else today.isoformat()
    return start, end


