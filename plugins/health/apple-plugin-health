def read_daily(path):
    """Parse one file the shortcut wrote. Returns (days, sleep_samples,
    generated, problems), where days is {(date, metric): (value, unit,
    partial)} and sleep_samples is [(start, end, stage)].

    The first line names the format; a file that does not start with it is
    refused, so a stray text file in the folder cannot become a day.
    """
    with open(path, encoding="utf-8") as f:
        lines = f.read().splitlines()
    if not lines or not lines[0].startswith("apple-tools health "):
        raise ValueError("not a health export: first line is %r" % (lines[0][:40] if lines else ""))
    version = lines[0].split()[-1]
    if version != FORMAT_VERSION:
        raise ValueError("format %s; this plugin reads %s" % (version, FORMAT_VERSION))
    generated = None
    window = None
    days = {}
    sleep = []
    workouts = []
    problems = []
    seen = set()
    for lineno, line in enumerate(lines[1:], 2):
        if not line.strip():
            continue
        parts = line.split("\t")
        head = parts[0]
        if head == "generated":
            generated = parse_when(parts[1]) if len(parts) > 1 else None
            continue
        if head == "window":
            window = number(parts[1]) if len(parts) > 1 else None
            continue
        if head == "source":
            continue
        if head == "workout":
            w = parse_workout_row(parts, lineno, problems)
            if w:
                workouts.append(w)
            continue
        if head not in ("day", "sample"):
            problems.append("line %d: unknown row %r" % (lineno, head))
            continue
        if len(parts) < 6:
            problems.append("line %d: %d fields, want 6" % (lineno, len(parts)))
            continue
        _, label, start_text, end_text, value_text, unit = parts[:6]
        seen.add(label)
        start, end = parse_when(start_text), parse_when(end_text)
        if start is None or end is None:
            problems.append("line %d: bad date %r / %r" % (lineno, start_text, end_text))
            continue
        if head == "sample":
            if label != "Sleep":
                problems.append("line %d: raw samples of %r are not read" % (lineno, label))
                continue
            stage = SLEEP_STAGES.get(value_text.strip())
            if stage is None:
                problems.append("line %d: sleep value %r" % (lineno, value_text))
                continue
            sleep.append((start, end, stage))
            continue
        if label not in BY_LABEL:
            problems.append("line %d: type %r is not one this plugin stores" % (lineno, label))
            continue
        key, _, want = BY_LABEL[label]
        value = number(value_text)
        if value is None:
            problems.append("line %d: value %r" % (lineno, value_text))
            continue
        try:
            value = canonical(value, unit, want)
        except ValueError as error:
            problems.append("line %d: %s: %s" % (lineno, label, error))
            continue
        # A grouped-by-day sample spans the whole day; the day it names is
        # its start. It is partial when the file was generated before that
        # day ended.
        date = local_day(start)
        partial = 1 if generated is not None and local_day(generated) <= date else 0
        days[(date, key)] = (value, want, partial)
    # ⚠️ A type the phone never wrote a line for is either one the user has
    # no data for, or one whose label the shortcut got wrong — the editor
    # shows an empty Type, and the run produces nothing for it. Named, so a
    # wrong label is visible on the Mac.
    # Only for a short window: a year file from 2015 has no cycling, no
    # Watch and no sleep, and that is history, not a wrong label.
    absent = [label for _, label, _, _, _ in METRICS if label not in seen]
    if "Sleep" not in seen:
        absent.append("Sleep")
    if absent and (window is None or window <= 31):
        problems.append("no lines for: %s" % ", ".join(absent))
    return days, sleep, workouts, generated, problems


def parse_workout_row(parts, lineno, problems):
    """`workout <type> <start> <end> <seconds> <metres> <kcal> <bpm> <source> <lat> <lon>`.
    A number may be empty. The app writes metres, kcal and seconds already,
    so nothing is converted."""
    if len(parts) < 11:
        problems.append("line %d: workout row has %d fields, want 11" % (lineno, len(parts)))
        return None
    _, kind, start_text, end_text, seconds, metres, kcal, bpm, source, lat, lon = parts[:11]
    start, end = parse_when(start_text), parse_when(end_text)
    if start is None or end is None:
        problems.append("line %d: bad date %r / %r" % (lineno, start_text, end_text))
        return None
    def opt(text):
        return number(text) if text.strip() else None
    duration = opt(seconds)
    if duration is None:
        duration = (end - start).total_seconds()
    return {
        "id": "%s|%s|%s" % (kind, iso(start), source),
        "type": kind, "start": iso(start), "end": iso(end), "duration": duration,
        "distance": opt(metres), "energy": opt(kcal), "heart_rate": opt(bpm),
        "source": source, "latitude": opt(lat), "longitude": opt(lon), "route": None,
    }


def nights(samples):
    """Sleep samples → {wake-up date: totals}.

    🛑 A NIGHT BELONGS TO THE MORNING, and the day of the sample's end is
    not enough to say so: a stage that ends at 23:10 is part of the night
    that ends at 06:30 the next day. Health's own rule is that a sleep day
    runs from 18:00 to 18:00, so a sample is filed under the date of its
    end SHIFTED SIX HOURS FORWARD — 23:10 becomes 05:10 tomorrow, 06:30
    stays today, and a nap ending at 15:00 stays today.

    Stages from every source add up per stage; ⚠️ if two sources both
    record the same night (a Watch and a third-party app), the total is
    twice the truth. Health itself picks one source; `import_export` keeps
    one source per night for that reason, and the shortcut's file carries
    whatever Health returned."""
    by_day = {}
    for start, end, stage in samples:
        date = local_day(end + dt.timedelta(hours=6))
        night = by_day.setdefault(date, {"start": start, "end": end, "samples": 0,
                                         "in_bed": 0.0, "asleep": 0.0, "core": 0.0,
                                         "deep": 0.0, "rem": 0.0, "awake": 0.0})
        minutes = max(0.0, (end - start).total_seconds() / 60.0)
        night[stage] += minutes
        night["samples"] += 1
        night["start"] = min(night["start"], start)
        night["end"] = max(night["end"], end)
    out = {}
    for date, night in by_day.items():
        asleep = sum(night[s] for s in ASLEEP)
        if asleep <= 0 and night["in_bed"] <= 0:
            continue
        out[date] = dict(night, asleep=asleep)
    return out


def store_workouts(db, path, workouts):
    for w in workouts:
        db.execute("INSERT OR REPLACE INTO workout (id, type, start, \"end\", duration, distance, "
                   "energy, heart_rate, source, latitude, longitude, route, file) "
                   "VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)",
                   (w["id"], w["type"], w["start"], w["end"], w["duration"], w["distance"],
                    w["energy"], w["heart_rate"], w["source"], w["latitude"], w["longitude"],
                    w.get("route"), path))


def store_daily(db, path, days, sleep_samples, source):
    """Write one file's days over what is there. The newest file wins for a
    day it carries, because a later run of the shortcut has the whole day
    where an earlier one had part of it."""
    for (date, metric), (value, unit, partial) in days.items():
        db.execute("INSERT OR REPLACE INTO day (date, metric, value, unit, source, file, partial) "
                   "VALUES (?, ?, ?, ?, ?, ?, ?)", (date, metric, value, unit, source, path, partial))
    stored = 0
    for date, night in nights(sleep_samples).items():
        db.execute("INSERT OR REPLACE INTO sleep (date, start, \"end\", asleep, in_bed, core, "
                   "deep, rem, awake, samples, source, file) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
                   (date, iso(night["start"]), iso(night["end"]), night["asleep"],
                    night["in_bed"] or None, night["core"] or None, night["deep"] or None,
                    night["rem"] or None, night["awake"] or None, night["samples"], source, path))
        stored += 1
    return stored


def daily_files(opts):
    found = []
    for folder in folders(opts):
        if os.path.isdir(folder):
            found += sorted(glob.glob(os.path.join(folder, "health-*.txt")))
            found += sorted(glob.glob(os.path.join(folder, "health*.txt")))
    seen, out = set(), []
    for path in found:
        if path not in seen:
            seen.add(path)
            out.append(path)
    return out


def unread(db, path, kind):
    """True when the file is new or changed since it was last read."""
    st = os.stat(path)
    row = db.execute("SELECT mtime, size FROM file WHERE path = ?", (path,)).fetchone()
    return row is None or row["mtime"] != st.st_mtime or row["size"] != st.st_size


def mark_read(db, path, kind, **counts):
    st = os.stat(path)
    db.execute("INSERT OR REPLACE INTO file (path, mtime, size, kind, read_at, lines, days, workouts) "
               "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
               (path, st.st_mtime, st.st_size, kind, dt.datetime.now().isoformat(timespec="seconds"),
                counts.get("lines"), counts.get("days"), counts.get("workouts")))


def sync(db, opts, quiet=False):
    """Read every daily file not read yet. Returns a report dict."""
    report = {"folders": folders(opts), "files": [], "days": 0, "nights": 0, "problems": []}
    for path in daily_files(opts):
        if not unread(db, path, "daily"):
            continue
        try:
            days, sleep_samples, workouts, generated, problems = read_daily(path)
        except (OSError, ValueError) as error:
            report["problems"].append("%s: %s" % (os.path.basename(path), error))
            continue
        # Files are read oldest first by name, and a file is (re)read when
        # it changes, so the newest run always writes last. ⚠️ The app's
        # yearly history files sort before its daily ones (`health-2024.txt`
        # < `health-2026-09-17.txt`), so a daily file always wins a day.
        n_nights = store_daily(db, path, days, sleep_samples, "shortcut")
        store_workouts(db, path, workouts)
        dates = sorted({d for d, _ in days} | set(nights(sleep_samples)))
        mark_read(db, path, "daily", lines=len(days) + len(sleep_samples) + len(workouts),
                  days=len(dates), workouts=len(workouts))
        db.commit()
        report["files"].append({"path": path, "days": len(dates), "nights": n_nights,
                                "workouts": len(workouts), "generated": iso(generated),
                                "first": dates[0] if dates else None,
                                "last": dates[-1] if dates else None})
        report["days"] += len(dates)
        report["nights"] += n_nights
        report["workouts"] = report.get("workouts", 0) + len(workouts)
        for problem in problems:
            report["problems"].append("%s: %s" % (os.path.basename(path), problem))
    if not quiet:
        for problem in report["problems"]:
            note("⚠️  " + problem)
    return report


