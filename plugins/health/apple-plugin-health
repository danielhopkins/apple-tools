def open_export(path):
    """(a file object for export.xml, a zipfile or None, the member name).

    🛑 The folder and file names inside the archive vary by locale and iOS
    version, so nothing here looks for `apple_health_export/export.xml`.
    Any .xml whose first kilobyte carries `<HealthData` is the one — the
    rule healthkit-to-sqlite uses.
    """
    if os.path.isdir(path):
        for name in sorted(os.listdir(path)):
            full = os.path.join(path, name)
            if name.endswith(".xml") and _is_health_xml(open(full, "rb")):
                return open(full, "rb"), None, full
        raise ValueError("no HealthData .xml in %s" % path)
    if path.endswith(".xml"):
        f = open(path, "rb")
        if not _is_health_xml(f):
            raise ValueError("%s does not start with <HealthData" % path)
        f.seek(0)
        return f, None, path
    archive = zipfile.ZipFile(path)
    for info in archive.infolist():
        if info.filename.endswith(".xml") and info.filename.count("/") <= 1 \
                and not info.filename.endswith("export_cda.xml"):
            with archive.open(info) as f:
                if _is_health_xml(f):
                    return archive.open(info), archive, info.filename
    raise ValueError("no HealthData .xml in %s" % path)


def _is_health_xml(f):
    head = f.read(2048)
    return b"<!DOCTYPE HealthData" in head or b"<HealthData" in head


def first_route_point(archive, base_dir, route_path):
    """The first <trkpt> of a workout's GPX, so the workout has a place.
    ⚠️ GPX dates are ISO 8601 with a Z, unlike the export's own; only the
    coordinate is read here."""
    if not route_path:
        return None, None
    try:
        if archive is not None:
            member = next((n for n in archive.namelist() if n.endswith(route_path.lstrip("/"))), None)
            if member is None:
                return None, None
            f = archive.open(member)
        else:
            full = os.path.join(base_dir, route_path.lstrip("/"))
            if not os.path.isfile(full):
                return None, None
            f = open(full, "rb")
        with f:
            for _, elem in ET.iterparse(f, events=("start",)):
                if elem.tag.endswith("trkpt"):
                    return float(elem.get("lat")), float(elem.get("lon"))
    except (OSError, ValueError, ET.ParseError, zipfile.BadZipFile):
        return None, None
    return None, None


def import_export(db, path, opts):
    """Stream export.xml into the store. Returns a report.

    🛑 THE FILE IS TOO BIG TO LOAD — hundreds of MB to a few GB unzipped —
    so it is streamed with iterparse and every element is cleared once
    read. Measured on the first real archive: see docs/apple-health.md.

    Days come out of Records, with one rule that matters: 🛑 A DAY'S STEPS
    ARE NOT THE SUM OF EVERY STEP RECORD. The iPhone and the Watch both
    count the same walk, and Health shows one of them. The export carries
    both. So a cumulative metric is summed PER SOURCE per day, and the day
    takes the largest source's total — nearly what Health shows, never
    twice it. A day the shortcut has written keeps the shortcut's number,
    which IS what Health shows.
    """
    f, archive, member = open_export(path)
    base_dir = path if os.path.isdir(path) else os.path.dirname(path)
    # (date, metric) → {source: sum} for sums; → [values] for means;
    # → (when, value) for last.
    sums, means, lasts = {}, {}, {}
    sleep_samples = []
    workouts = []
    records = 0
    skipped_units = {}
    with f:
        for event, elem in ET.iterparse(f, events=("end",)):
            tag = elem.tag
            if tag == "Record":
                records += 1
                hk = elem.get("type")
                if hk == SLEEP_HK:
                    start, end = parse_when(elem.get("startDate")), parse_when(elem.get("endDate"))
                    stage = SLEEP_STAGES.get(elem.get("value") or "")
                    if start and end and stage:
                        sleep_samples.append((start, end, stage, elem.get("sourceName") or ""))
                elif hk in BY_HK:
                    key, rule, want = BY_HK[hk]
                    value = number(elem.get("value"))
                    start = parse_when(elem.get("startDate"))
                    if value is not None and start is not None:
                        try:
                            value = canonical(value, elem.get("unit"), want)
                        except ValueError:
                            skipped_units[(hk, elem.get("unit"))] = skipped_units.get((hk, elem.get("unit")), 0) + 1
                            elem.clear()
                            continue
                        date = local_day(start)
                        source = elem.get("sourceName") or ""
                        if rule == "sum":
                            sums.setdefault((date, key), {})
                            sums[(date, key)][source] = sums[(date, key)].get(source, 0.0) + value
                        elif rule == "mean":
                            means.setdefault((date, key), []).append(value)
                        else:
                            prior = lasts.get((date, key))
                            if prior is None or start >= prior[0]:
                                lasts[(date, key)] = (start, value)
                elem.clear()
            elif tag == "Workout":
                workouts.append(shape_workout(elem, archive, base_dir))
                elem.clear()
            elif tag in ("ActivitySummary", "Me", "ExportDate"):
                elem.clear()

    # Days from the export never overwrite a day the shortcut wrote.
    written = 0
    have = {(r["date"], r["metric"]) for r in db.execute(
        "SELECT date, metric FROM day WHERE source = 'shortcut'")}
    units = {key: unit for key, _, _, _, unit in METRICS}
    for (date, key), by_source in sums.items():
        if (date, key) in have:
            continue
        db.execute("INSERT OR REPLACE INTO day (date, metric, value, unit, source, file, partial) "
                   "VALUES (?, ?, ?, ?, 'export', ?, 0)",
                   (date, key, max(by_source.values()), units[key], path))
        written += 1
    for (date, key), values in means.items():
        if (date, key) in have:
            continue
        db.execute("INSERT OR REPLACE INTO day (date, metric, value, unit, source, file, partial) "
                   "VALUES (?, ?, ?, ?, 'export', ?, 0)",
                   (date, key, sum(values) / len(values), units[key], path))
        written += 1
    for (date, key), (_, value) in lasts.items():
        if (date, key) in have:
            continue
        db.execute("INSERT OR REPLACE INTO day (date, metric, value, unit, source, file, partial) "
                   "VALUES (?, ?, ?, ?, 'export', ?, 0)", (date, key, value, units[key], path))
        written += 1

    # Sleep: one source per night, the one with the most asleep minutes,
    # so a Watch and a sleep app recording the same night do not double it.
    have_sleep = {r["date"] for r in db.execute("SELECT date FROM sleep WHERE source = 'shortcut'")}
    by_source = {}
    for start, end, stage, source in sleep_samples:
        by_source.setdefault(source, []).append((start, end, stage))
    per_night = {}
    for source, samples in by_source.items():
        for date, night in nights(samples).items():
            best = per_night.get(date)
            if best is None or night["asleep"] > best["asleep"]:
                per_night[date] = night
    n_nights = 0
    for date, night in per_night.items():
        if date in have_sleep:
            continue
        db.execute("INSERT OR REPLACE INTO sleep (date, start, \"end\", asleep, in_bed, core, "
                   "deep, rem, awake, samples, source, file) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)",
                   (date, iso(night["start"]), iso(night["end"]), night["asleep"],
                    night["in_bed"] or None, night["core"] or None, night["deep"] or None,
                    night["rem"] or None, night["awake"] or None, night["samples"], "export", path))
        n_nights += 1

    store_workouts(db, path, workouts)
    mark_read(db, path, "export", lines=records, days=written, workouts=len(workouts))
    db.commit()
    if archive is not None:
        archive.close()
    return {"path": path, "member": member, "records": records, "days_written": written,
            "days_kept_from_shortcut": len(have), "nights": n_nights,
            "workouts": len(workouts),
            "skipped_units": ["%s in %r: %d records" % (hk, unit, n)
                              for (hk, unit), n in sorted(skipped_units.items())]}


WORKOUT_TYPES = {
    # HKWorkoutActivityType names as the export spells them → the label
    # the Health app shows. Anything else is the name with the prefix off.
    "HKWorkoutActivityTypeCycling": "Cycling",
    "HKWorkoutActivityTypeRunning": "Running",
    "HKWorkoutActivityTypeWalking": "Walking",
    "HKWorkoutActivityTypeHiking": "Hiking",
    "HKWorkoutActivityTypeSwimming": "Swimming",
    "HKWorkoutActivityTypeYoga": "Yoga",
    "HKWorkoutActivityTypeFunctionalStrengthTraining": "Functional Strength Training",
    "HKWorkoutActivityTypeTraditionalStrengthTraining": "Traditional Strength Training",
    "HKWorkoutActivityTypeHighIntensityIntervalTraining": "HIIT",
    "HKWorkoutActivityTypeDownhillSkiing": "Downhill Skiing",
    "HKWorkoutActivityTypeSnowboarding": "Snowboarding",
    "HKWorkoutActivityTypeElliptical": "Elliptical",
    "HKWorkoutActivityTypeRowing": "Rowing",
    "HKWorkoutActivityTypeOther": "Other",
}


def workout_label(hk):
    if hk in WORKOUT_TYPES:
        return WORKOUT_TYPES[hk]
    bare = (hk or "").replace("HKWorkoutActivityType", "")
    return re.sub(r"(?<=[a-z])(?=[A-Z])", " ", bare) or "Workout"


def shape_workout(elem, archive, base_dir):
    """One <Workout>. ⚠️ Two shapes: before iOS 16 the distance and energy
    were attributes (`totalDistance`, `totalEnergyBurned`); since then they
    are <WorkoutStatistics> children with a `sum`, and the attributes are
    absent. Both are read; the child wins when both exist."""
    start = parse_when(elem.get("startDate"))
    end = parse_when(elem.get("endDate"))
    duration = number(elem.get("duration"))
    if duration is not None:
        unit = elem.get("durationUnit") or "min"
        duration = duration * {"min": 60.0, "s": 1.0, "hr": 3600.0}.get(unit, 60.0)
    elif start and end:
        duration = (end - start).total_seconds()
    distance = energy = heart_rate = None
    if elem.get("totalDistance"):
        try:
            distance = canonical(number(elem.get("totalDistance")), elem.get("totalDistanceUnit"), "m")
        except (ValueError, TypeError):
            distance = None
    if elem.get("totalEnergyBurned"):
        try:
            energy = canonical(number(elem.get("totalEnergyBurned")), elem.get("totalEnergyBurnedUnit"), "kcal")
        except (ValueError, TypeError):
            energy = None
    route = None
    for child in elem:
        if child.tag == "WorkoutStatistics":
            kind = child.get("type") or ""
            try:
                if kind.startswith("HKQuantityTypeIdentifierDistance") and child.get("sum"):
                    distance = canonical(number(child.get("sum")), child.get("unit"), "m")
                elif kind == "HKQuantityTypeIdentifierActiveEnergyBurned" and child.get("sum"):
                    energy = canonical(number(child.get("sum")), child.get("unit"), "kcal")
                elif kind == "HKQuantityTypeIdentifierHeartRate" and child.get("average"):
                    heart_rate = number(child.get("average"))
            except (ValueError, TypeError):
                pass
        elif child.tag == "WorkoutRoute":
            ref = child.find("FileReference")
            if ref is not None:
                route = ref.get("path")
    lat, lon = first_route_point(archive, base_dir, route)
    source = elem.get("sourceName") or ""
    return {
        "id": "%s|%s|%s" % (elem.get("workoutActivityType"), iso(start), source),
        "type": workout_label(elem.get("workoutActivityType")),
        "start": iso(start), "end": iso(end), "duration": duration,
        "distance": distance, "energy": energy, "heart_rate": heart_rate,
        "source": source, "latitude": lat, "longitude": lon, "route": route,
    }


