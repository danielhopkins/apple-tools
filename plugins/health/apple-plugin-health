def plugin_manager():
    if os.environ.get("APPLE_PLUGINS_BIN"):
        return [os.environ["APPLE_PLUGINS_BIN"]]
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (os.path.join(here, "..", "..", "bin", "apple-plugins"),
                      os.path.join(here, "..", "..", "apple-plugins"),
                      os.path.join(here, "..", "..", "..", "Helpers", "apple-plugins")):
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return [candidate]
    found = shutil.which("apple-plugins")
    if found:
        return [found]
    found = shutil.which("apple")
    if found:
        return [found, "plugins"]
    return None


def stored_config():
    manager = plugin_manager()
    if manager is None:
        return {}
    try:
        proc = subprocess.run(manager + ["config", NAME, "--json"],
                              capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return {}
    if proc.returncode != 0:
        return {}
    try:
        return json.loads(proc.stdout).get("config") or {}
    except ValueError:
        return {}


def folders(opts):
    """The directories the daily files are read from, most specific first.
    A flag, then the environment, then the stored config, then both
    iCloud Drive candidates."""
    chosen = getattr(opts, "folder", None) or os.environ.get("APPLE_HEALTH_FOLDER")
    if not chosen:
        chosen = stored_config().get("folder")
    if chosen:
        return [os.path.expanduser(chosen)]
    return DEFAULT_FOLDERS


def store_path():
    return os.environ.get("APPLE_HEALTH_STORE") or os.path.join(STORE_DIR, "health.sqlite")


