    start = "0000-00-00"
    if opts.since is not None:
        start = (dt.date.today() - dt.timedelta(days=opts.since)).isoformat()
    end = "9999-99-99"
    days = day_rows(db, start, end)
    for date in sorted(days):
        day = days[date]
        lines = describe_day(day)
        out.write(json.dumps({
            "uid": "health:day:%s" % date,
            "tool": NAME, "kind": "day", "native_id": date, "url": None,
            "title": day_title(day),
            "container": date[:4],
            "created": None, "modified": None,
            "occurred": _epoch_noon(date),
            "latitude": None, "longitude": None,
            "people": [],
            "body": "\n".join(lines),
            "rev": "|".join("%s=%s" % (k, day[k]) for k in sorted(day) if k not in ("date", "sources")),
        }) + "\n")
    for w in workout_rows(db, start, end):
        when = parse_when(w["start"])
        lines = describe_workout(w)
        out.write(json.dumps({
            "uid": "health:workout:%s" % re.sub(r"[^A-Za-z0-9|:+-]", "", w["id"]),
            "tool": NAME, "kind": "workout", "native_id": w["id"], "url": None,
            "title": workout_title(w),
            "container": w["start"][:4],
            "created": None, "modified": None,
            "occurred": when.timestamp() if when else None,
            "latitude": w["latitude"], "longitude": w["longitude"],
            "people": [],
            "body": "\n".join(lines),
            "rev": "%s|%s|%s|%s" % (w["end"], w["duration"], w["distance"], w["energy"]),
        }) + "\n")
    out.flush()


def main(argv=None):
    parser = argparse.ArgumentParser(prog="apple health", description=__doc__.split("\n\n")[0])
    parser.add_argument("--version", action="version", version="apple-plugin-health %s" % VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--folder", help="where the daily files are; overrides the configured one")
    common.add_argument("--json", action="store_true")
    ranged = argparse.ArgumentParser(add_help=False)
    ranged.add_argument("--since", type=int, metavar="DAYS")
    ranged.add_argument("--from", dest="from_", metavar="DATE")
    ranged.add_argument("--to", metavar="DATE")

    sub = parser.add_subparsers(dest="command")
    sub.add_parser("manifest", parents=[common]).set_defaults(func=cmd_manifest)
    sub.add_parser("status", parents=[common]).set_defaults(func=cmd_status)

    p = sub.add_parser("import", parents=[common], help="read a Health export archive")
    p.add_argument("path", help="export.zip, export.xml, or the unzipped folder")
    p.set_defaults(func=cmd_import)

    p = sub.add_parser("sync", parents=[common], help="read new daily files from the shortcut")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("days", parents=[common, ranged], help="one line per day")
    p.set_defaults(func=cmd_days)

    p = sub.add_parser("workouts", parents=[common, ranged], help="workouts from the export")
    p.add_argument("--type", help="only workouts whose type contains this")
    p.set_defaults(func=cmd_workouts)

    p = sub.add_parser("log", parents=[common], help="the iPhone app's log, as it wrote it")
    p.add_argument("--tail", type=int, default=50, metavar="N", help="last N lines; 0 for all")
    p.set_defaults(func=cmd_log)

    p = sub.add_parser("shortcut", parents=[common], help="put the iPhone shortcut where you can install it")
    p.add_argument("--to", help="directory; default iCloud Drive/apple-tools")
    p.set_defaults(func=cmd_shortcut)

    p = sub.add_parser("index", parents=[common, ranged], help="NDJSON records for apple-index")
    p.add_argument("--full", action="store_true", help="accepted; index always emits everything")
    p.set_defaults(func=cmd_index)

    opts = parser.parse_args(argv)
    if not opts.command:
        parser.print_help()
        return 0
    opts.func(opts)
    return 0


if __name__ == "__main__":
    sys.exit(main())
