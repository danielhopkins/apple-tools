def cmd_manifest(opts):
    print(json.dumps(MANIFEST, indent=2))


def cmd_status(opts):
    """What is on disk and whether it can be read. Never writes, never
    connects, never starts the app, and exits 0 with --json whatever it finds."""
    store = backend(opts)
    report = {"tool": NAME, "hosts": MANIFEST["network"]["hosts"], "usable": False}
    report.update(store.status())
    report["usable"] = report["status"] == "ok"
    fresh = store.freshness()
    report["store_modified"] = iso(fresh["store_modified"])
    report["last_sync"] = iso(fresh["last_sync"])
    if fresh["app_running"] is not None:
        report["app_running"] = fresh["app_running"]
    report.setdefault("advice", None)
    if report["usable"]:
        report["stale"] = store.stale(fresh)
        if report["stale"]:
            report["advice"] = store.stale_advice(fresh)
    if opts.json:
        print(json.dumps(report, indent=2, ensure_ascii=False))
        sys.exit(0)
    print("shopping: %s (%s)" % (report["status"], store.name))
    print("  store: %s" % store.path)
    if "lists" in report:
        print("  %d lists, %d open items, %d checked off" % (
            report["lists"], report["open_items"], report["checked_items"]))
        line = "  last sync: %s" % age(fresh["last_sync"])
        if fresh["app_running"] is not None:
            line += "; app %s" % ("running" if fresh["app_running"] else "not running")
        if "agent" in report:
            line += "; agent %s" % ("installed" if report["agent"] else "not installed")
        print(line)
    if report["advice"]:
        print("  %s" % report["advice"])
    sys.exit(0 if report["usable"] else 1)


def cmd_setup(opts):
    """Copy the WebDAV login out of the app's HTTP cache, into the config
    and the Keychain, and make milkforus-server the backend. The password is
    never printed."""
    cache = os.environ.get("SHOPPING_MILKFORUS_CACHE") or os.path.join(
        MilkForUs.container, "Caches", "de.danielrinser.milkforus", "Cache.db")
    if not os.path.isfile(cache):
        die("no HTTP cache at %s. Open Milk for Us once, signed in to sync." % cache, 69)
    try:
        db = sqlite3.connect("file:%s?mode=ro" % urllib.parse.quote(cache), uri=True)
        row = db.execute(
            "SELECT d.receiver_data FROM cfurl_cache_response r "
            "JOIN cfurl_cache_receiver_data d ON d.entry_ID = r.entry_ID "
            "WHERE r.request_key LIKE '%/v1/users/webdav_sync_authorization%' "
            "ORDER BY r.time_stamp DESC LIMIT 1").fetchone()
    except sqlite3.DatabaseError as e:
        if "authorization denied" in str(e) or "unable to open" in str(e):
            raise NoAccess(cache) from e
        die("the app's HTTP cache did not answer: %s" % e)
    if row is None or not row[0]:
        die("the app's HTTP cache holds no sync login. Open Milk for Us, check that "
            "sync is on, and run this again.", 69)
    try:
        login = json.loads(row[0])
        url, user, password = (login["webdav_base_url"], login["webdav_username"],
                               login["webdav_password"])
    except (ValueError, KeyError, TypeError):
        die("the cached sync login is not in the shape measured on 2026-11-02")
    # Prove it before keeping it.
    dav = WebDAV(url, user, password)
    try:
        dav.list("milkforus/baselines")
    except Unauthorized:
        die("the server refused the cached login. Open Milk for Us once and run this again.")
    except (OSError, http.client.HTTPException) as e:
        die("could not reach %s: %s" % (urllib.parse.urlsplit(url).netloc, e))
    finally:
        dav.close()
    set_config(["webdav_url=%s" % url, "webdav_user=%s" % user,
                "webdav_password=%s" % password, "backend=milkforus-server"])
    print("stored the sync login (password in the Keychain); backend is now milkforus-server")
    if not opts.no_pull:
        store = MilkForUsServer(opts)
        print(store.sync_summary(store.sync(opts)))


def cmd_sync(opts):
    if opts.agent and not enabled():
        # Disabling the plugin stops the agent's network use at once, even
        # before the agent is removed.
        note("%s: the shopping plugin is not enabled; not pulling" % iso(time.time()))
        return
    store = backend(opts)
    r = store.sync(opts)
    if opts.agent:
        # One line per run in the log, and only when something happened.
        if not r["synced"] or r.get("changed"):
            note("%s %s" % (iso(time.time()), store.sync_summary(r).replace("\n", ";")))
        sys.exit(0 if r["synced"] else 1)
    if opts.json:
        print(json.dumps(r, indent=2))
    else:
        print(store.sync_summary(r))
    sys.exit(0 if r["synced"] else 1)


def cmd_lists(opts):
    store = prepare(opts)
    items = store.items()
    rows = []
    for l in store.lists():
        mine = [i for i in items if i["list_id"] == l["id"]]
        added = [i["last_added"] for i in mine if i["last_added"]]
        rows.append({"id": l["id"], "name": l["name"], "color": l["color"],
                     "open": sum(1 for i in mine if not i["checked"]),
                     "checked": sum(1 for i in mine if i["checked"]),
                     "last_added": iso(max(added)) if added else None})
    if opts.json:
        print(json.dumps(rows, indent=2, ensure_ascii=False))
        return
    for r in rows:
        print("%-20s %3d open  %3d checked   last added %s" % (
            r["name"], r["open"], r["checked"], (r["last_added"] or "?")[:16].replace("T", " ")))


def cmd_items(opts):
    store = prepare(opts)
    items = store.items()
    if opts.list:
        wanted = find_list(store, opts.list)["id"]
        items = [i for i in items if i["list_id"] == wanted]
    if opts.checked:
        items = [i for i in items if i["checked"]]
    elif not opts.all:
        items = [i for i in items if not i["checked"]]
    if opts.search:
        want = fold(opts.search)
        items = [i for i in items if want in fold(i["name"]) or want in fold(i["note"])]
    order = {l["id"]: n for n, l in enumerate(store.lists())}
    # The app's own order: list, then aisle, then name. An item with no
    # category goes first, as the app shows it.
    items.sort(key=lambda i: (order.get(i["list_id"], 0), i["checked"],
                              -1 if i["aisle"] is None else i["aisle"], fold(i["name"])))
    if opts.json:
        print(json.dumps([public(i) for i in items], indent=2, ensure_ascii=False))
        return
    current = None
    for i in items:
        if i["list"] != current:
            if current is not None:
                print()
            current = i["list"]
            print("%s" % current)
        line = "  %s %s" % ("✓" if i["checked"] else "•", i["name"])
        if i["note"]:
            line += " (%s)" % i["note"]
        if i["category"]:
            line += "  — %s" % i["category"]
        print(line)
    if not items:
        note("nothing on %s" % (opts.list or "any list"))


def cmd_history(opts):
    store = prepare(opts)
    rows = store.history()
    if opts.list:
        wanted = find_list(store, opts.list)["id"]
        rows = [r for r in rows if r["list_id"] == wanted]
    if opts.since:
        start = time.time() - opts.since * 86400
        rows = [r for r in rows if r["last_added"] and r["last_added"] >= start]
    if opts.search:
        want = fold(opts.search)
        rows = [r for r in rows if want in fold(r["name"])]
    if opts.most:
        rows.sort(key=lambda r: -(r["times_added"] or 0))
    if opts.limit and len(rows) > opts.limit:
        note("showing %d of %d; --limit 0 for all" % (opts.limit, len(rows)))
        rows = rows[:opts.limit]
    if opts.json:
        print(json.dumps([public(r) for r in rows], indent=2, ensure_ascii=False))
        return
    for r in rows:
        print("%s  %4dx  %-30s %s" % (short(r["last_added"]), r["times_added"] or 0,
                                      r["name"][:30], r["list"] or ""))


def cmd_index(opts):
    """NDJSON for apple-index: one record per list. Never syncs: the agent
    does that, and an index refresh must not start an app or connect."""
    store = backend(opts)
    if store.db() is None:
        return
    items = store.items()
    start = time.time() - opts.since * 86400 if opts.since else None
    out = sys.stdout
    for l in store.lists():
        mine = sorted((i for i in items if i["list_id"] == l["id"]),
                      key=lambda i: (-1 if i["aisle"] is None else i["aisle"], fold(i["name"])))
        added = [i["last_added"] for i in mine if i["last_added"]]
        occurred = max(added) if added else None
        if start is not None and (occurred is None or occurred < start):
            continue

        def line(i):
            s = i["name"]
            if i["note"]:
                s += " (%s)" % i["note"]
            return s
        open_items = [line(i) for i in mine if not i["checked"]]
        done = [line(i) for i in mine if i["checked"]]
        body = "%s shopping list\nTo buy: %s\nChecked off: %s" % (
            l["name"], ", ".join(open_items) or "nothing",
            ", ".join(done) or "nothing")
        out.write(json.dumps({
            "uid": "%s:list:%s" % (NAME, l["id"]),
            "tool": NAME, "kind": "list", "native_id": l["name"], "url": None,
            "title": "%s shopping list (%d to buy)" % (l["name"], len(open_items)),
            "container": l["name"],
            "created": None, "modified": occurred, "occurred": occurred,
            "latitude": None, "longitude": None,
            "people": [],
            "body": body,
            "rev": hashlib.sha1(body.encode("utf-8")).hexdigest()[:16],
        }, ensure_ascii=False) + "\n")
    out.flush()


# What `--json` prints, per subcommand, for `--help`.
JSON_FIELDS = {
    "lists": """\
JSON: a list, one object per shopping list, in the app's order.
  id                   the backend's stable id; items and history take it or the name
  name                 the list's name
  color                #rrggbb, the app's colour for the list
  open, checked        how many items are still to buy, and checked off
  last_added           ISO 8601: when the newest item went on the list""",
    "items": """\
JSON: a list, one object per item, in the app's order (list, aisle, name).
  id                   the backend's stable id for the item
  list, list_id        the list it is on
  name                 what to buy
  note                 the note on the item, or null
  category             the aisle, or null
  checked              true once it is checked off
  last_added           ISO 8601: the last time this product went on this list
  times_added          how many times it has gone on this list""",
    "history": """\
JSON: a list, one object per product per list, newest first (--most: most often first).
  name, category       the product
  list, list_id        the list it went on
  last_added           ISO 8601
  times_added          how many times, all time""",
    "sync": """\
JSON: one object.
  synced               true when the copy is now current
  changed              true when the copy changed
  store_modified       ISO 8601: the last change to the copy
  last_sync            ISO 8601: the last time it was made current
milkforus-server:
  downloaded, dropped  files fetched, and old change sets let go
  baseline, events     the baseline file, and how many change sets follow it
  requests, bytes      what the pull cost
  error                why it failed, or null
milkforus:
  launched, stopped    whether this started the app, and stopped it again
  app_was_running      it was running before; then it is left running
  seconds              how long it took""",
}


def main(argv=None):
    parser = argparse.ArgumentParser(prog="apple shopping", description=__doc__.split("\n\n")[0])
    parser.add_argument("--version", action="version", version="apple-plugin-shopping %s" % VERSION)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--backend", help="milkforus-server or milkforus")
    common.add_argument("--folder", help="the folder holding the backend's store")
    common.add_argument("--json", action="store_true", help="print JSON; the fields are listed below")
    reads = argparse.ArgumentParser(add_help=False)
    reads.add_argument("--sync", action="store_true", help="make the copy current first")

    sub = parser.add_subparsers(dest="command")
    sub.add_parser("manifest", parents=[common]).set_defaults(func=cmd_manifest)
    sub.add_parser("status", parents=[common]).set_defaults(func=cmd_status)

    p = sub.add_parser("setup", parents=[common],
                       help="copy the app's sync login into the Keychain; use the server")
    p.add_argument("--no-pull", action="store_true", help="do not pull after storing the login")
    p.set_defaults(func=cmd_setup)

    p = sub.add_parser("sync", parents=[common],
                       help="make the copy current: pull from the server, or run the app")
    p.add_argument("--timeout", type=int, default=90, metavar="SECONDS",
                   help="milkforus: how long to wait for the app")
    p.add_argument("--keep-running", action="store_true",
                   help="milkforus: leave the app running hidden")
    p.add_argument("--restart", action="store_true",
                   help="milkforus: stop the app first when it is already running")
    p.add_argument("--agent", action="store_true", help=argparse.SUPPRESS)
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("agent", parents=[common], help="a launchd agent that pulls on a timer")
    p.add_argument("action", choices=["install", "remove", "status"], nargs="?", default="status")
    p.add_argument("--every", type=int, default=2, metavar="MINUTES")
    p.set_defaults(func=cmd_agent)

    p = sub.add_parser("lists", parents=[common, reads], help="every list and how much is on it")
    p.set_defaults(func=cmd_lists)

    p = sub.add_parser("items", parents=[common, reads], help="what is on the lists; open items by default")
    p.add_argument("list", nargs="?", help="a list's name or id; every list when omitted")
    state = p.add_mutually_exclusive_group()
    state.add_argument("--checked", action="store_true", help="only items checked off")
    state.add_argument("--all", action="store_true", help="open and checked off")
    p.add_argument("--search", help="only items whose name or note contains this")
    p.set_defaults(func=cmd_items)

    p = sub.add_parser("history", parents=[common, reads],
                       help="every product ever put on a list, newest first")
    p.add_argument("--list", help="a list's name or id")
    p.add_argument("--since", type=int, metavar="DAYS")
    p.add_argument("--search", help="only products whose name contains this")
    p.add_argument("--most", action="store_true", help="most often added first")
    p.add_argument("--limit", type=int, default=50)
    p.set_defaults(func=cmd_history)

    p = sub.add_parser("index", parents=[common], help="NDJSON records for apple-index")
    p.add_argument("--since", type=int, metavar="DAYS")
    p.add_argument("--full", action="store_true", help="accepted; index always emits everything")
    p.set_defaults(func=cmd_index)

    for name, text in JSON_FIELDS.items():
        sub.choices[name].epilog = text
        sub.choices[name].formatter_class = argparse.RawDescriptionHelpFormatter

    opts = parser.parse_args(argv)
    if not opts.command:
        parser.print_help()
        return 0
    if opts.command == "agent" and opts.every < 1:
        die("--every must be at least 1 minute")
    try:
        opts.func(opts)
    except NoAccess as e:
        die("cannot read %s. Grant Full Disk Access to the terminal or app running "
            "this, in System Settings → Privacy & Security." % e, 77)
    return 0


if __name__ == "__main__":
    sys.exit(main())
