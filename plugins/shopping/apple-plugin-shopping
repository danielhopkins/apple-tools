# what every read shares
# --------------------------------------------------------------------------

def fold(text):
    """For matching a list name: case, the trailing space the app keeps, and
    the curly apostrophe in "Trader Joe’s" that nobody types."""
    return (text or "").strip().casefold().replace("’", "'").replace("‘", "'")


def find_list(store, ref):
    lists = store.lists()
    want = fold(ref)
    for l in lists:
        if l["id"] == ref or fold(l["name"]) == want:
            return l
    hits = [l for l in lists if want in fold(l["name"])]
    if len(hits) == 1:
        return hits[0]
    if hits:
        die("%r matches %s; say which" % (ref, ", ".join(l["name"] for l in hits)))
    die("no list %r; lists: %s" % (ref, ", ".join(l["name"] for l in lists)))


def prepare(opts):
    """The backend, synced first when --sync asks, with a note on stderr
    when the copy is stale. Every read goes through here."""
    store = backend(opts)
    if getattr(opts, "sync", False):
        r = store.sync(opts)
        if not r["synced"]:
            note("warning: the sync did not finish (%s); reading what is on disk"
                 % (r.get("error") or "%ss" % r["seconds"]))
    fresh = store.freshness()
    if store.stale(fresh):
        note("note: %s" % store.stale_advice(fresh))
    return store


def public(row):
    out = dict(row)
    out.pop("pk", None)
    out.pop("aisle", None)
    if "last_added" in out:
        out["last_added"] = iso(out["last_added"])
    return out


