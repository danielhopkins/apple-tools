class NoAccess(Exception):
    pass


class MilkForUs:
    """Milk for Us 1.6.1, an iPhone app running on the Mac.

    db.sqlite, in the group container, is plain Core Data:

      ZSHOPPINGLIST       a list: ZNAME, ZSORTORDER, ZCOLORSTRING
      ZSHOPPINGLISTITEM   a thing on a list: ZPRODUCT, ZSHOPPINGLIST,
                          ZCHECKED (0 open, 1 checked off), ZNOTE
      ZPRODUCT            what the thing is: ZNAME, ZCATEGORY
      ZPRODUCTCATEGORY    an aisle: ZNAME, ZDEFAULTSORTORDER
      ZPRODUCTUSAGE       one row per product per list: ZLASTUSED, the last
                          time it was put on that list, and ZTIMESUSED

    ⚠️ An item row carries no date of its own. The time it went on the list
    is ZPRODUCTUSAGE.ZLASTUSED for the same product and list.
    ⚠️ ZSIMPERIUMKEY is the stable id: a UUID, or 32 hex digits on a list
    made by an older version. List names can carry a trailing space.
    """

    name = "milkforus"
    app = "Milk for Us"
    bundle_id = "de.danielrinser.milkforus"
    app_path = "/Applications/Milk for Us.app"
    # A copy older than this is said to be stale on stderr, by every read.
    stale_after = 6 * 3600
    default_folder = os.path.join(HOME, "Library", "Group Containers",
                                  "group.de.danielrinser.milkforus")
    # The app's own container, where the sync engine keeps its state.
    container = os.path.join(HOME, "Library", "Containers", "de.danielrinser.milkforus",
                             "Data", "Library")

    def __init__(self, opts):
        folder = setting(opts, "folder", "SHOPPING_FOLDER")
        self.folder = os.path.expanduser(folder) if folder else self.default_folder
        self.path = os.path.join(self.folder, "db.sqlite")
        self.engine = os.environ.get("SHOPPING_MILKFORUS_ENGINE") or os.path.join(
            self.container, "Application Support", "de.danielrinser.milkforus",
            "com.mentalfaculty.ensembles.eventdata", "milkforus")
        self._db = None

    # -- the store ---------------------------------------------------------

    def db(self):
        if self._db is not None:
            return self._db
        if not os.path.isfile(self.path):
            return None
        try:
            with open(self.path, "rb"):
                pass
        except PermissionError as e:
            raise NoAccess(self.path) from e
        # mode=ro, never immutable=1: the app writes its newest rows to the
        # write-ahead log, and immutable skips it.
        uri = "file:%s?mode=ro" % urllib.parse.quote(self.path)
        self._db = sqlite3.connect(uri, uri=True, timeout=5)
        self._db.row_factory = sqlite3.Row
        return self._db

    def missing_advice(self):
        return "no %s store at %s. Install %s and open it once." % (
            self.app, self.path, self.app)

    def _need(self):
        db = self.db()
        if db is None:
            die(self.missing_advice(), 69)
        return db

    @staticmethod
    def when(apple_seconds):
        if apple_seconds is None:
            return None
        return float(apple_seconds) + APPLE_EPOCH

    def lists(self):
        rows = self._need().execute("""
            SELECT l.Z_PK AS pk, l.ZSIMPERIUMKEY AS key, l.ZNAME AS name,
                   l.ZSORTORDER AS sort, l.ZCOLORSTRING AS color
            FROM ZSHOPPINGLIST l ORDER BY l.ZSORTORDER, l.Z_PK""").fetchall()
        return [{"id": r["key"] or str(r["pk"]), "pk": r["pk"],
                 "name": (r["name"] or "").strip(), "sort": r["sort"],
                 "color": ("#" + r["color"]) if r["color"] else None} for r in rows]

    def items(self):
        lists = {l["pk"]: l for l in self.lists()}
        rows = self._need().execute("""
            SELECT i.Z_PK AS pk, i.ZSIMPERIUMKEY AS key, i.ZSHOPPINGLIST AS list,
                   i.ZCHECKED AS checked, i.ZNOTE AS note,
                   p.ZNAME AS product, c.ZNAME AS category, c.ZDEFAULTSORTORDER AS aisle,
                   u.ZLASTUSED AS last_used, u.ZTIMESUSED AS times
            FROM ZSHOPPINGLISTITEM i
            LEFT JOIN ZPRODUCT p ON p.Z_PK = i.ZPRODUCT
            LEFT JOIN ZPRODUCTCATEGORY c ON c.Z_PK = p.ZCATEGORY
            LEFT JOIN ZPRODUCTUSAGE u ON u.ZPRODUCT = i.ZPRODUCT
                                     AND u.ZSHOPPINGLIST = i.ZSHOPPINGLIST
            ORDER BY u.ZLASTUSED DESC""").fetchall()
        out, seen = [], set()
        for r in rows:
            # ⚠️ One product had two usage rows for the same list; the join
            # then returns the item twice. Keep the first, which the ORDER BY
            # makes the newest.
            if r["pk"] in seen or r["list"] not in lists:
                continue
            seen.add(r["pk"])
            out.append({
                "id": r["key"] or str(r["pk"]),
                "list": lists[r["list"]]["name"],
                "list_id": lists[r["list"]]["id"],
                "name": (r["product"] or "").strip(),
                "note": (r["note"] or "").strip() or None,
                "category": r["category"],
                "aisle": r["aisle"],
                "checked": bool(r["checked"]),
                "last_added": self.when(r["last_used"]),
                "times_added": r["times"],
            })
        return out

    def history(self):
        lists = {l["pk"]: l for l in self.lists()}
        rows = self._need().execute("""
            SELECT u.ZSHOPPINGLIST AS list, u.ZLASTUSED AS last_used, u.ZTIMESUSED AS times,
                   p.ZNAME AS product, c.ZNAME AS category
            FROM ZPRODUCTUSAGE u
            JOIN ZPRODUCT p ON p.Z_PK = u.ZPRODUCT
            LEFT JOIN ZPRODUCTCATEGORY c ON c.Z_PK = p.ZCATEGORY
            ORDER BY u.ZLASTUSED DESC""").fetchall()
        return [{"name": (r["product"] or "").strip(),
                 "list": lists[r["list"]]["name"] if r["list"] in lists else None,
                 "list_id": lists[r["list"]]["id"] if r["list"] in lists else None,
                 "category": r["category"],
                 "last_added": self.when(r["last_used"]),
                 "times_added": r["times"]} for r in rows]

    # -- freshness and sync ------------------------------------------------

    def _data_files(self):
        return [self.path, self.path + "-wal",
                os.path.join(self.engine, "events.sqlite"),
                os.path.join(self.engine, "events.sqlite-wal")]

    def _check_file(self):
        # 🛑 The sync engine rewrites store.plist each time it asks the
        # server for changes: at launch, and every ~16 s while the app runs
        # (measured 2026-11-02). Its mtime is the last sync check.
        return os.path.join(self.engine, "store.plist")

    def freshness(self):
        modified = [m for m in (mtime(f) for f in self._data_files()[:2]) if m]
        return {
            "store_modified": max(modified) if modified else None,
            "last_sync": mtime(self._check_file()),
            "app_running": self.pid() is not None,
        }

    def stale(self, fresh):
        # A running app keeps its copy current by itself: an item added on
        # the phone reached the Mac in 22 s (measured 2026-11-02).
        if fresh.get("app_running"):
            return False
        last = fresh["last_sync"] or fresh["store_modified"]
        return last is None or time.time() - last > self.stale_after

    def stale_advice(self, fresh):
        return ("the copy on this Mac was last synced %s. Run `apple shopping sync`, "
                "which starts %s hidden, waits for it to pull, and stops it." % (
                    age(fresh["last_sync"] or fresh["store_modified"]), self.app))

    def pid(self):
        """The running app's pid, or None. `lsappinfo` knows it by bundle id
        even though the wrapped iPhone app reports bundleID NULL."""
        if os.environ.get("SHOPPING_MILKFORUS_NO_APP"):
            return None
        try:
            proc = subprocess.run(["/usr/bin/lsappinfo", "info", "-only", "pid",
                                   "-app", self.bundle_id],
                                  capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.SubprocessError):
            return None
        m = re.search(r"pid\s*=\s*(\d+)", proc.stdout)
        return int(m.group(1)) if m else None

    def _stop(self, pid):
        """SIGTERM, then wait. 🛑 AppleScript `quit` does not work: the
        wrapped iPhone app never answers it, and osascript waits two minutes
        for AppleEvent timed out (-1712). SIGTERM ends it in about a second,
        and the store passes quick_check after."""
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            return True
        for _ in range(20):
            time.sleep(0.5)
            if self.pid() is None:
                return True
        return False

    def sync(self, opts):
        timeout = getattr(opts, "timeout", None) or 90
        keep_running = getattr(opts, "keep_running", False)
        restart = getattr(opts, "restart", False)
        quiet = 5
        if not os.path.isdir(self.app_path):
            die("%s is not installed in /Applications." % self.app, 69)
        report = {"backend": self.name, "app_was_running": False, "launched": False,
                  "stopped": False, "synced": False, "changed": False}
        pid = self.pid()
        report["app_was_running"] = pid is not None
        if pid is not None and restart:
            if not self._stop(pid):
                die("%s did not stop after SIGTERM." % self.app)
            pid = None

        def snap():
            return [mtime(f) for f in self._data_files()]
        before = snap()
        t0 = time.time()
        if pid is None:
            # -g: do not bring it forward. -j: launch it hidden.
            subprocess.run(["/usr/bin/open", "-g", "-j", "-b", self.bundle_id], check=False)
            report["launched"] = True
        # 🛑 A fresh launch checks the server twice in its first ~20 s, and
        # a long gap pulls for longer: 3.5 months of changes took 23 s to
        # land and 54 s to settle. So wait for TWO sync checks after a
        # launch, ONE when the app was already running, and then for the
        # data files to stay quiet.
        wanted = 2 if report["launched"] else 1
        checks, last_check = 0, mtime(self._check_file())
        last_change, current = t0, before
        while time.time() - t0 < timeout:
            time.sleep(1)
            check = mtime(self._check_file())
            if check and check != last_check and check >= t0 - 1:
                checks += 1
                last_check = check
            now = snap()
            if now != current:
                current, last_change = now, time.time()
            if checks >= wanted and time.time() - last_change >= quiet:
                report["synced"] = True
                break
        report["seconds"] = round(time.time() - t0, 1)
        report["changed"] = current != before
        if report["launched"] and not keep_running:
            pid = self.pid()
            if pid is not None:
                report["stopped"] = self._stop(pid)
        fresh = self.freshness()
        report.update({"store_modified": iso(fresh["store_modified"]),
                       "last_sync": iso(fresh["last_sync"]),
                       "app_running": fresh["app_running"]})
        return report

    def sync_summary(self, r):
        if r["synced"]:
            line = "synced in %ss: %s" % (r["seconds"], "changes arrived" if r["changed"]
                                          else "no changes")
        else:
            line = "no completed sync in %ss; the copy may be old" % r["seconds"]
        if r["launched"]:
            line += "\n  started %s hidden; %s" % (
                self.app, "stopped it again" if r["stopped"] else "left it running")
        return line

    def status(self):
        report = {"backend": self.name, "app": self.app, "folder": self.folder,
                  "store": self.path, "app_installed": os.path.isdir(self.app_path)}
        try:
            db = self.db()
        except NoAccess:
            report["status"] = "denied"
            report["advice"] = ("the store exists and cannot be read. Grant Full Disk "
                                "Access to the terminal or app running this, in System "
                                "Settings → Privacy & Security.")
            return report
        if db is None:
            report["status"] = "missing"
            report["advice"] = self.missing_advice()
            return report
        try:
            items = self.items()
            report["lists"] = len(self.lists())
            report["open_items"] = sum(1 for i in items if not i["checked"])
            report["checked_items"] = sum(1 for i in items if i["checked"])
            report["status"] = "ok"
        except sqlite3.DatabaseError as e:
            report["status"] = "unreadable"
            report["advice"] = "the store did not answer: %s" % e
        return report


