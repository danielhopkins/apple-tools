def plugin_manager():
    if os.environ.get("APPLE_PLUGINS_BIN"):
        return [os.environ["APPLE_PLUGINS_BIN"]]
    here = os.path.dirname(os.path.realpath(__file__))
    for candidate in (os.path.join(here, "..", "..", "bin", "apple-plugins"),
                      os.path.join(here, "..", "..", "apple-plugins"),
                      os.path.join(here, "..", "..", "..", "Helpers", "apple-plugins")):
        if os.path.isfile(candidate) and os.access(candidate, os.X_OK):
            return [candidate]
    found = shutil.which("apple-plugins")
    if found:
        return [found]
    found = shutil.which("apple")
    if found:
        return [found, "plugins"]
    return None


_CONFIG = {}


def stored_config(reveal=False):
    """The manager's view of this plugin's config. --reveal costs a Keychain
    read, so it is asked for only by the backend that needs the password."""
    if reveal in _CONFIG:
        return _CONFIG[reveal]
    _CONFIG[reveal] = {}
    manager = plugin_manager()
    if manager is None:
        return _CONFIG[reveal]
    try:
        proc = subprocess.run(manager + ["config", NAME, "--json"] + (["--reveal"] if reveal else []),
                              capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return _CONFIG[reveal]
    if proc.returncode == 0:
        try:
            parsed = json.loads(proc.stdout)
            _CONFIG[reveal] = parsed.get("config") or {}
            _CONFIG["enabled"] = bool(parsed.get("enabled"))
        except ValueError:
            pass
    return _CONFIG[reveal]


def set_config(assignments):
    manager = plugin_manager()
    if manager is None:
        die("no apple-plugins found to store the config in")
    proc = subprocess.run(manager + ["config", NAME] + assignments,
                          capture_output=True, text=True, timeout=30)
    if proc.returncode != 0:
        die("apple plugins config failed: %s" % proc.stderr.strip())
    _CONFIG.clear()


def enabled():
    if os.environ.get("SHOPPING_ASSUME_ENABLED"):
        return True
    stored_config()
    return _CONFIG.get("enabled", False)


def setting(opts, key, env, reveal=False):
    """--<key>, then $<env>, then the configured value. The config is asked
    for only when nothing nearer answers, because asking costs a subprocess."""
    if getattr(opts, key, None):
        return getattr(opts, key)
    if os.environ.get(env):
        return os.environ[env]
    return stored_config(reveal).get(key)


# --------------------------------------------------------------------------
# time
# --------------------------------------------------------------------------

def iso(ts):
    if ts is None:
        return None
    return dt.datetime.fromtimestamp(ts).astimezone().isoformat(timespec="seconds")


def short(ts):
    if ts is None:
        return "?"
    return dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")


def age(ts):
    if ts is None:
        return "never"
    seconds = max(0, time.time() - ts)
    if seconds < 90:
        return "%d seconds ago" % seconds
    if seconds < 5400:
        return "%d minutes ago" % (seconds / 60)
    if seconds < 172800:
        return "%d hours ago" % (seconds / 3600)
    return "%d days ago" % (seconds / 86400)


def mtime(path):
    try:
        return os.stat(path).st_mtime
    except OSError:
        return None


def write_atomic(path, data):
    tmp = path + ".tmp"
    with open(tmp, "wb") as handle:
        handle.write(data)
    os.replace(tmp, path)


