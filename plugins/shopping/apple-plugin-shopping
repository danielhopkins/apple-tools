def agent_plist():
    folder = os.environ.get("SHOPPING_LAUNCH_AGENTS") or os.path.join(HOME, "Library", "LaunchAgents")
    return os.path.join(folder, AGENT_LABEL + ".plist")


def launchctl(*args):
    tool = os.environ.get("SHOPPING_LAUNCHCTL") or "/bin/launchctl"
    return subprocess.run([tool] + list(args), capture_output=True, text=True)


def agent_program(path=None):
    """The path the agent runs. 🛑 Under Homebrew, realpath is
    Cellar/apple-tools/<version>/..., which the next upgrade deletes; the
    agent would then fail every 2 minutes. opt/apple-tools follows upgrades."""
    path = path or os.path.realpath(__file__)
    parts = path.split(os.sep)
    if "Cellar" in parts:
        at = parts.index("Cellar")
        if len(parts) > at + 3:
            stable = os.sep.join(parts[:at] + ["opt", parts[at + 1]] + parts[at + 3:])
            if os.path.realpath(stable) == path:
                return stable
    return path


def cmd_agent(opts):
    path = agent_plist()
    domain = "gui/%d" % os.getuid()
    log = os.path.join(HOME, "Library", "Logs", "apple-tools", "shopping.log")
    if opts.action == "install":
        if not enabled():
            die("the shopping plugin is not enabled. Run: apple plugins enable shopping")
        if setting(opts, "backend", "SHOPPING_BACKEND") != "milkforus-server":
            die("the agent pulls from the server; run `apple shopping setup` first")
        MilkForUsServer(opts).login()
        os.makedirs(os.path.dirname(path), exist_ok=True)
        os.makedirs(os.path.dirname(log), exist_ok=True)
        plist = {
            "Label": AGENT_LABEL,
            # 🛑 /usr/bin/python3, not the shebang: launchd's PATH may not
            # reach whichever python3 a shell finds first.
            "ProgramArguments": ["/usr/bin/python3", agent_program(), "sync", "--agent"],
            "StartInterval": opts.every * 60,
            "RunAtLoad": True,
            "ProcessType": "Background",
            "LowPriorityIO": True,
            "StandardOutPath": log,
            "StandardErrorPath": log,
        }
        with open(path, "wb") as handle:
            plistlib.dump(plist, handle)
        launchctl("bootout", "%s/%s" % (domain, AGENT_LABEL))
        r = launchctl("bootstrap", domain, path)
        if r.returncode != 0:
            die("launchctl bootstrap failed: %s" % (r.stderr.strip() or r.returncode))
        print("installed %s: pulls every %d minutes; log in %s" % (AGENT_LABEL, opts.every, log))
        return
    if opts.action == "remove":
        launchctl("bootout", "%s/%s" % (domain, AGENT_LABEL))
        if os.path.isfile(path):
            os.remove(path)
            print("removed %s" % AGENT_LABEL)
        else:
            print("no agent installed")
        return
    report = {"installed": os.path.isfile(path), "plist": path, "log": log}
    if report["installed"]:
        with open(path, "rb") as handle:
            report["every_minutes"] = plistlib.load(handle).get("StartInterval", 0) // 60
        r = launchctl("print", "%s/%s" % (domain, AGENT_LABEL))
        report["loaded"] = r.returncode == 0
        m = re.search(r"last exit code = (\S+)", r.stdout)
        report["last_exit"] = m.group(1) if m else None
    if opts.json:
        print(json.dumps(report, indent=2))
        return
    if not report["installed"]:
        print("no agent installed. `apple shopping agent install` pulls every two minutes.")
        return
    print("%s: every %d minutes, %s, last exit %s" % (
        AGENT_LABEL, report["every_minutes"], "loaded" if report["loaded"] else "NOT loaded",
        report["last_exit"]))
    print("  log: %s" % log)


