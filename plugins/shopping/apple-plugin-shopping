class Unauthorized(Exception):
    pass


class WebDAV:
    """PROPFIND and GET, nothing else. One connection, kept alive.

    🛑 The server answers 401 with `WWW-Authenticate: Basic realm="Milk for
    Us Sync"`, so the login goes with every request. A client that waits
    for the challenge pays a second round trip on each: 103 files took
    130 s that way, about 1.3 s each."""

    def __init__(self, url, user, password, timeout=30):
        parts = urllib.parse.urlsplit(url.rstrip("/"))
        if parts.scheme not in ("https", "http"):
            raise ValueError("webdav_url must be http or https: %r" % url)
        self.scheme, self.host, self.root = parts.scheme, parts.netloc, parts.path
        self.timeout = timeout
        token = base64.b64encode(("%s:%s" % (user, password)).encode("utf-8")).decode("ascii")
        self.auth = "Basic " + token
        self.conn = None
        self.requests = 0
        self.bytes = 0

    def _connect(self):
        cls = http.client.HTTPSConnection if self.scheme == "https" else http.client.HTTPConnection
        self.conn = cls(self.host, timeout=self.timeout)

    def _request(self, method, path, body=None, headers=None):
        target = urllib.parse.quote(self.root + "/" + path.lstrip("/"))
        head = {"Authorization": self.auth, "User-Agent": "apple-plugin-shopping/%s" % VERSION}
        head.update(headers or {})
        for attempt in (1, 2):
            if self.conn is None:
                self._connect()
            try:
                self.conn.request(method, target, body=body, headers=head)
                resp = self.conn.getresponse()
                data = resp.read()
                break
            except (http.client.HTTPException, OSError):
                # A kept-alive connection the server closed: one retry on a
                # fresh one.
                self.conn.close()
                self.conn = None
                if attempt == 2:
                    raise
        self.requests += 1
        self.bytes += len(data)
        if resp.status == 401:
            raise Unauthorized(path)
        if resp.status not in (200, 207):
            raise OSError("%s %s: HTTP %d" % (method, path, resp.status))
        return data

    def list(self, folder):
        """File names in a folder, one level."""
        body = (b'<?xml version="1.0" encoding="utf-8"?><D:propfind xmlns:D="DAV:">'
                b'<D:prop><D:resourcetype/><D:getcontentlength/></D:prop></D:propfind>')
        raw = self._request("PROPFIND", folder + "/", body=body,
                            headers={"Depth": "1", "Content-Type": "application/xml"})
        ns = {"D": "DAV:"}
        names = []
        for r in ET.fromstring(raw).findall("D:response", ns):
            if r.find(".//D:resourcetype/D:collection", ns) is not None:
                continue
            href = urllib.parse.unquote(r.findtext("D:href", default="", namespaces=ns))
            name = href.rstrip("/").rsplit("/", 1)[-1]
            if name:
                names.append(name)
        return names

    def get(self, folder, name):
        return self._request("GET", "%s/%s" % (folder, name))

    def close(self):
        if self.conn is not None:
            self.conn.close()


SAFE = re.compile(r"^[A-Za-z][A-Za-z0-9_]*$")
# What the read queries need, so a table exists with these columns even when
# the server never sent a row or a field for it.
COLUMNS = {
    "ShoppingList": ["simperiumKey", "name", "sortOrder", "colorString"],
    "ShoppingListItem": ["simperiumKey", "checked", "note", "product", "shoppingList"],
    "Product": ["simperiumKey", "name", "category"],
    "ProductCategory": ["simperiumKey", "name", "defaultSortOrder"],
    "ProductUsage": ["simperiumKey", "product", "shoppingList", "lastUsed", "timesUsed"],
}


def count_of(name):
    """The global count at the start of a file name: `20994_<store>_<rev>`."""
    head = name.split("_", 1)[0]
    return int(head) if head.isdigit() else -1


class Replay:
    """Objects from a baseline and the change sets after it.

    A change set is JSON: changesByEntity → entity → a list of changes,
    each {globalIdentifier, type, properties}. Change type 100 inserts,
    200 updates (only the properties listed), 300 deletes. Property type
    0 is an attribute (`value`; absent means null), 1 a to-one
    (`relatedIdentifier`), 2 a to-many, which is skipped: the to-one on the
    other side holds the same link. A date is ["date", milliseconds since
    1970]; the store keeps Core Data's seconds since 2001."""

    def __init__(self):
        self.objects = {}

    def apply(self, event):
        for entity, changes in (event.get("changesByEntity") or {}).items():
            if not SAFE.match(entity):
                continue
            table = self.objects.setdefault(entity, {})
            for c in changes:
                gid = c.get("globalIdentifier")
                if not gid:
                    continue
                kind = c.get("type")
                if kind == 300:
                    table.pop(gid, None)
                    continue
                if kind == 100:
                    row = table[gid] = {}
                else:
                    row = table.setdefault(gid, {})
                for p in c.get("properties") or []:
                    prop = p.get("propertyName") or ""
                    if not SAFE.match(prop):
                        continue
                    if p.get("type") == 0:
                        row[prop] = self.value(p.get("value"))
                    elif p.get("type") == 1:
                        row[prop] = ("ref", p.get("relatedIdentifier"))

    @staticmethod
    def value(v):
        if isinstance(v, list) and len(v) == 2 and v[0] == "date" and isinstance(v[1], (int, float)):
            return v[1] / 1000.0 - APPLE_EPOCH
        if isinstance(v, bool):
            return int(v)
        if isinstance(v, (list, dict)):
            return json.dumps(v)
        return v

    def write(self, path):
        """A SQLite file with the app's own table and column names, so the
        reads are the same queries on both backends. Written beside, then
        renamed over, so a reader never sees half of one."""
        tmp = path + ".tmp"
        if os.path.exists(tmp):
            os.remove(tmp)
        db = sqlite3.connect(tmp)
        pks = {}
        for entity, table in self.objects.items():
            for n, gid in enumerate(sorted(table), 1):
                pks[gid] = n
        for entity in sorted(set(self.objects) | set(COLUMNS)):
            table = self.objects.get(entity, {})
            props = set(COLUMNS.get(entity, []))
            for row in table.values():
                props.update(row)
            props = sorted(props)
            cols = ["Z" + p.upper() for p in props]
            db.execute('CREATE TABLE "Z%s" (Z_PK INTEGER PRIMARY KEY%s)' % (
                entity.upper(), "".join(', "%s"' % c for c in cols)))
            rows = []
            for gid in sorted(table):
                row = table[gid]
                values = [pks[gid]]
                for p in props:
                    v = row.get(p)
                    if isinstance(v, tuple):
                        v = pks.get(v[1])
                    if p == "simperiumKey" and not v:
                        v = gid
                    values.append(v)
                rows.append(values)
            db.executemany('INSERT INTO "Z%s" VALUES (%s)' % (
                entity.upper(), ",".join("?" * (len(props) + 1))), rows)
        db.commit()
        db.close()
        os.replace(tmp, path)


class MilkForUsServer(MilkForUs):
    """Pulls from sync.milkforus.com into a store of its own.

      <folder>/baseline/   the newest baseline file, one
      <folder>/events/     every change set after it
      <folder>/store.sqlite  the replay, in the app's own schema
      <folder>/state.json  last pull, last change, last error

    🛑 The app makes a new baseline from time to time and deletes the change
    sets it covers (one on 2026-10-22 here). A pull that finds a newer
    baseline downloads it and keeps only the change sets after it.
    🛑 Every change set after the baseline is replayed in global-count
    order on every change. A late one from a phone that was offline can
    carry a count lower than one already applied; replaying all of them
    puts it in its place. 102 of them replay in well under a second."""

    name = "milkforus-server"
    stale_after = 15 * 60
    default_folder = os.path.join(SUPPORT, "shopping", "milkforus")

    def __init__(self, opts):
        folder = setting(opts, "folder", "SHOPPING_FOLDER")
        self.folder = os.path.expanduser(folder) if folder else self.default_folder
        self.path = os.path.join(self.folder, "store.sqlite")
        self.state_path = os.path.join(self.folder, "state.json")
        self.opts = opts
        self._db = None

    def missing_advice(self):
        if not self.login(required=False):
            return "no login yet. Run `apple shopping setup`."
        return "nothing pulled yet. Run `apple shopping sync`."

    def login(self, required=True):
        url = setting(self.opts, "webdav_url", "SHOPPING_WEBDAV_URL")
        user = setting(self.opts, "webdav_user", "SHOPPING_WEBDAV_USER")
        if url and user:
            password = os.environ.get("SHOPPING_WEBDAV_PASSWORD") or \
                stored_config(reveal=True).get("webdav_password")
            if password:
                return url, user, password
        if required:
            die("no login for the Milk for Us sync server. Run `apple shopping setup`.", 78)
        return None

    def state(self):
        try:
            with open(self.state_path) as handle:
                return json.load(handle)
        except (OSError, ValueError):
            return {}

    def save_state(self, state):
        write_atomic(self.state_path, json.dumps(state, indent=2).encode("utf-8"))

    def freshness(self):
        s = self.state()
        return {"store_modified": s.get("last_change"), "last_sync": s.get("last_pull"),
                "app_running": None}

    def stale(self, fresh):
        last = fresh["last_sync"]
        return last is None or time.time() - last > self.stale_after

    def stale_advice(self, fresh):
        agent = "" if os.path.isfile(agent_plist()) else \
            " `apple shopping agent install` pulls every two minutes."
        return "the last pull from the server was %s. Run `apple shopping sync`.%s" % (
            age(fresh["last_sync"]), agent)

    def sync(self, opts):
        os.makedirs(os.path.join(self.folder, "baseline"), exist_ok=True)
        os.makedirs(os.path.join(self.folder, "events"), exist_ok=True)
        lock = open(os.path.join(self.folder, ".lock"), "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            # Another pull (the agent's, most likely) is running. Wait for it
            # rather than download the same files twice.
            fcntl.flock(lock, fcntl.LOCK_EX)
        t0 = time.time()
        state = self.state()
        report = {"backend": self.name, "synced": False, "changed": False,
                  "baseline": state.get("baseline"), "downloaded": 0, "dropped": 0}
        dav = WebDAV(*self.login())
        try:
            report.update(self._pull(dav, state))
            report["synced"] = True
            state["last_pull"] = time.time()
            state["last_error"] = None
            if report["changed"]:
                state["last_change"] = state["last_pull"]
        except Unauthorized:
            state["last_error"] = ("the server refused the login. Open Milk for Us once, "
                                   "then run `apple shopping setup` again.")
        except (OSError, ValueError, ET.ParseError, http.client.HTTPException) as e:
            state["last_error"] = "%s: %s" % (type(e).__name__, e)
        finally:
            dav.close()
        state["last_attempt"] = time.time()
        self.save_state(state)
        report["error"] = state["last_error"]
        report["requests"] = dav.requests
        report["bytes"] = dav.bytes
        report["seconds"] = round(time.time() - t0, 1)
        fresh = self.freshness()
        report["store_modified"] = iso(fresh["store_modified"])
        report["last_sync"] = iso(fresh["last_sync"])
        return report

    def _pull(self, dav, state):
        base_dir = os.path.join(self.folder, "baseline")
        event_dir = os.path.join(self.folder, "events")
        out = {"changed": False, "downloaded": 0, "dropped": 0}
        baselines = [n for n in dav.list("milkforus/baselines") if count_of(n) >= 0]
        if not baselines:
            raise ValueError("the server holds no baseline")
        newest = max(baselines, key=lambda n: (count_of(n), n))
        if state.get("baseline") != newest or not os.path.isfile(os.path.join(base_dir, newest)):
            data = dav.get("milkforus/baselines", newest)
            json.loads(data)          # refuse a file that is not JSON before keeping it
            write_atomic(os.path.join(base_dir, newest), data)
            for old in os.listdir(base_dir):
                if old != newest:
                    os.remove(os.path.join(base_dir, old))
            state["baseline"] = newest
            out["downloaded"] += 1
            out["changed"] = True
        floor = count_of(newest)
        wanted = {n for n in dav.list("milkforus/events") if count_of(n) > floor}
        have = {n for n in os.listdir(event_dir) if not n.endswith(".tmp")}
        for name in sorted(wanted - have, key=lambda n: (count_of(n), n)):
            data = dav.get("milkforus/events", name)
            json.loads(data)
            write_atomic(os.path.join(event_dir, name), data)
            out["downloaded"] += 1
            out["changed"] = True
        for name in have - wanted:
            os.remove(os.path.join(event_dir, name))
            out["dropped"] += 1
            out["changed"] = True
        out["baseline"] = newest
        out["events"] = len(wanted)
        if out["changed"] or not os.path.isfile(self.path):
            self.rebuild(newest, sorted(wanted, key=lambda n: (count_of(n), n)))
            out["changed"] = True
        return out

    def rebuild(self, baseline, events):
        replay = Replay()
        with open(os.path.join(self.folder, "baseline", baseline), "rb") as handle:
            replay.apply(json.load(handle))
        loaded = []
        for name in events:
            with open(os.path.join(self.folder, "events", name), "rb") as handle:
                loaded.append((count_of(name), json.load(handle), name))
        # Global count, then the event's own timestamp, then the name: the
        # order the sync engine merges in.
        loaded.sort(key=lambda e: (e[0], e[1].get("timestamp") or 0, e[2]))
        for _, event, _ in loaded:
            replay.apply(event)
        if self._db is not None:
            self._db.close()
            self._db = None
        replay.write(self.path)

    def sync_summary(self, r):
        if not r["synced"]:
            return "pull failed: %s" % r["error"]
        return "pulled in %ss: %s (%d requests, %d bytes)" % (
            r["seconds"], "%d files downloaded" % r["downloaded"] if r["changed"]
            else "no changes", r["requests"], r["bytes"])

    def status(self):
        report = MilkForUs.status(self)
        s = self.state()
        report.pop("app_installed", None)
        report["login"] = self.login(required=False) is not None
        report["baseline"] = s.get("baseline")
        report["last_error"] = s.get("last_error")
        report["last_attempt"] = iso(s.get("last_attempt"))
        report["agent"] = os.path.isfile(agent_plist())
        if report["status"] == "ok" and s.get("last_error"):
            report["status"] = "error"
            report["advice"] = "the last pull failed: %s" % s["last_error"]
        return report


BACKENDS = {"milkforus": MilkForUs, "milkforus-server": MilkForUsServer}


def backend(opts):
    name = setting(opts, "backend", "SHOPPING_BACKEND") or "milkforus"
    if name not in BACKENDS:
        die("unknown backend %r; known: %s" % (name, ", ".join(sorted(BACKENDS))))
    return BACKENDS[name](opts)


