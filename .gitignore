.DS_Store
__pycache__/
*.pyc
swift/.build/
bin/reminders
bin/apple-mail
bin/apple-calendar
*.tar.gz

# Generated by `make completions` from the ArgumentParser binaries
completions/_reminders
completions/_apple-mail
completions/_apple-calendar
completions/_apple-contacts

# Local path-shading dev install (make dev)
.dev-bin/

# A stray root .build/ appears if swift build is run from the repo root
# rather than swift/, and .claude/ holds local agent state and worktrees.
.build/
.claude/

# app/ — xcodegen generates the project, xcodebuild fills build/
app/AppleTools.xcodeproj/
app/build/
app/Info.plist
app/AppleTools.entitlements
