#!/usr/bin/env bash
# Run the live apple-tools integration suites.
#
# WARNING: these drive the real binaries against your real data. The calendar
# suite creates and deletes events on a writable calendar, which syncs to your
# other devices. Every event it creates is titled with the
# "__claude_calendar_test__" prefix and is swept before and after each test;
# the sweep refuses to delete anything without that prefix. Fixtures are dated
# in the year 2099 so a stray leftover never appears in a real week view.
#
# Usage:
#   ./tests/run-tests                        # calendar writes + mail read guards
#   ./tests/run-tests --mail                 # + the mail draft suite
#   ./tests/run-tests --contacts             # + the contacts write suite
#   ./tests/run-tests test_calendar_write    # one module
#
# test_mail_wedge is read-only and always on. Some of it only applies with
# Mail.app closed and some only with it open, so run it both ways to cover
# everything; each half skips in the wrong state rather than failing.
#
# Pick the calendar fixtures land on (defaults to the first writable one):
#   APPLE_CALENDAR_TEST_CALENDAR="Personal" ./tests/run-tests
#
# Point the contacts suite at a specific binary (see below):
#   APPLE_CONTACTS_BIN="$(command -v apple-contacts)" ./tests/run-tests --contacts

set -euo pipefail

# The mail and contacts suites are opt-in on top of the calendar one. Mail
# creates real drafts and sweeps them to trash, where they stay until you empty
# it. Contacts creates real contacts and groups, which sync to every device on
# the account and have no undo — hence a separate flag and a stricter sweep.

ROOT="$(cd "$(dirname "$0")" && pwd)"
PY="$(command -v python3)"

cd "$ROOT"
export RUN_LIVE_CALENDAR_TESTS=1
# The mail wedge-guard suite is read-only — it creates nothing and sweeps
# nothing — so it runs by default rather than behind a flag. Its most expensive
# act is one bounded health probe.
export RUN_LIVE_MAIL_READ_TESTS=1
while [ "$#" -gt 0 ]; do
  case "${1:-}" in
    --mail)
      export RUN_LIVE_MAIL_TESTS=1
      shift
      echo "Mail draft tests ENABLED — creates ~15 drafts prefixed"
      echo "__claude_mail_test__ and moves them to trash afterwards. Cleanup is"
      echo "best-effort; if any survive, delete them by hand in Mail.app."
      ;;
    --contacts)
      export RUN_LIVE_CONTACTS_TESTS=1
      shift
      echo "Contacts write tests ENABLED — creates real contacts and groups"
      echo "whose first name / name is exactly __claude_contacts_test__, and"
      echo "deletes them afterwards. Contact writes SYNC TO EVERY DEVICE and"
      echo "there is no undo. The sweep only ever deletes exact-prefix matches."
      echo
      ;;
    *)
      break
      ;;
  esac
done
export PYTHONPATH="$ROOT"

CAL="${APPLE_CALENDAR_TEST_CALENDAR:-<first writable>}"
echo "Live calendar tests — fixtures go to: $CAL"
echo "Every fixture is prefixed __claude_calendar_test__ and swept afterwards."
echo

if [ "$#" -gt 0 ]; then
  exec "$PY" -m unittest -v "$1"
else
  exec "$PY" -m unittest discover -s . -p "test_*.py" -t . -v
fi
