#!/usr/bin/env bash
# apple - single entry point for the apple-tools CLIs.
#
#   apple notes search "budget"
#   apple mail search --from alice@example.com
#   apple reminders show-lists --json
#   apple calendar events --days 3 --json
#   apple contacts search "smith"
#
# Each subcommand forwards every remaining argument to the underlying tool, so
# `apple notes --help` is exactly `apple-notes --help`.

set -euo pipefail

APPLE_TOOLS_VERSION="26.804.0"

# Resolve the repo root even when invoked through a symlink in ~/bin.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT="$(cd -P "$BIN_DIR/.." && pwd)"

SWIFT_RELEASE="$ROOT/swift/.build/release"
SWIFT_DEBUG="$ROOT/swift/.build/debug"

# Same rules as AppleToolsStyle: colour only on a terminal, NO_COLOR and
# CLICOLOR=0 disable, CLICOLOR_FORCE enables through a pipe.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${CLICOLOR:-1}" != "0" ] \
   && [ "${TERM:-}" != "dumb" ] || [ "${CLICOLOR_FORCE:-0}" != "0" ]; then
    H=$'\033[1;34m'; C=$'\033[1;35m'; G=$'\033[32m'; R=$'\033[0m'
else
    H=""; C=""; G=""; R=""
fi

usage() {
    cat <<EOF
${C}apple${R} - interact with local Apple app data

${H}USAGE:${R} ${C}apple${R} <tool> [args...]

${H}TOOLS:${R}
    ${G}notes${R}       Search, export, and link Apple Notes       (reads NoteStore.sqlite)
    ${G}mail${R}        Search, export, and draft Apple Mail       (reads Mail's own store)
    ${G}messages${R}    Search and export iMessage/SMS history     (reads chat.db)
    ${G}phone${R}       Read call history and place calls          (reads CallHistory)
    ${G}reminders${R}   Full CRUD on Reminders                     (EventKit)
    ${G}calendar${R}    Read and write Calendar events             (EventKit)
    ${G}contacts${R}    Read and write Contacts, relations, groups (Contacts framework)

Every tool supports --json. Run \`apple <tool> --help\` for its own options.

${H}OTHER:${R}
    ${G}apple status${R}        Permission state of every tool, without prompting
    ${G}apple --help${R}        Show this message
    ${G}apple --version${R}     Print the apple-tools version
    ${G}apple --which${R}       Print the resolved path of each tool

${H}EXAMPLES:${R}
    apple notes search "budget" --json            # title search
    apple notes export 261                        # note as Markdown
    apple mail accounts --json                    # addresses for --from
    apple mail search "invoice" --json            # whole store, milliseconds
    apple mail search "budget" --field content    # full-text over bodies
    apple mail draft --to a@b.com --subject "Hi" --body "text"
    apple messages chats --json                   # conversations, recent first
    apple messages search "dinner" --since 30     # whole store, milliseconds
    apple messages export 8 --limit 50            # one conversation
    apple phone recents --missed --since 7        # who called while I was out
    apple phone recents --unknown --since 30      # callers not in Contacts
    apple phone dial "Alice"                      # Phone.app asks you to confirm
    apple reminders show-all --due-date today --include-overdue --json
    apple reminders add Inbox "Buy milk" --due-date "tomorrow 9am"
    apple calendar events --days 7 --json         # next week
    apple calendar add "Dentist" --start "tomorrow 2pm" --duration 45
    apple contacts search "smith"                 # JSON by default
    apple contacts groups                         # groups + member counts
EOF
}

# Map a subcommand to the executable name it dispatches to.
binary_name() {
    case "$1" in
        notes)     echo "apple-notes" ;;
        mail)      echo "apple-mail" ;;
        messages)  echo "apple-messages" ;;
        phone)     echo "apple-phone" ;;
        calendar)  echo "apple-calendar" ;;
        contacts)  echo "apple-contacts" ;;
        reminders) echo "reminders" ;;
        *)         return 1 ;;
    esac
}

# Find a tool, in order of preference:
#   0. $APPLE_TOOLS_BIN       — an explicit override dir (`make dev` sets this)
#   1. alongside this script  — an installed layout (Homebrew, `make install`)
#   2. the source checkout    — running straight out of the repo
#   3. $PATH                  — installed some other way
#
# The override exists because the installed copy and the checkout can disagree,
# and following a symlink back to bin/apple lands BIN_DIR in the repo either
# way — so "alongside this script" cannot express "use the dev build". It also
# has to name every tool, not just the ones being worked on: a dev dir that
# resolves four tools and lets the fifth fall through to a stale build is worse
# than one that is wrong consistently.
resolve() {
    local tool="$1" name
    name="$(binary_name "$tool")" || return 1

    if [ -n "${APPLE_TOOLS_BIN:-}" ] && [ -x "$APPLE_TOOLS_BIN/$name" ]; then
        echo "$APPLE_TOOLS_BIN/$name"
        return 0
    fi

    if [ -x "$BIN_DIR/$name" ]; then
        echo "$BIN_DIR/$name"
        return 0
    fi

    local candidate
    for candidate in \
        "$ROOT/notes/$name" \
        "$SWIFT_RELEASE/$name" \
        "$SWIFT_DEBUG/$name"
    do
        if [ -x "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    if candidate="$(command -v "$name" 2>/dev/null)"; then
        echo "$candidate"
        return 0
    fi

    echo "error: '$name' not found. Run 'make build' in $ROOT, or 'make install'." >&2
    return 1
}

# Collect every tool's `status --json` and render one report.
#
# Each tool answers for itself rather than the dispatcher guessing, so this
# stays correct as the underlying permission models drift apart. Records are
# separated by \x1e because the JSON is pretty-printed and contains newlines.
status_report() {
    local want_json=0
    [ "${1:-}" = "--json" ] && want_json=1

    local payload="" tool bin js
    for tool in notes mail messages phone reminders calendar contacts; do
        if ! bin="$(resolve "$tool" 2>/dev/null)"; then
            payload+="$tool"$'\t'$'\x1f'"not installed"$'\x1e'
            continue
        fi
        if ! js="$("$bin" status --json 2>/dev/null)"; then
            payload+="$tool"$'\t'$'\x1f'"status unavailable"$'\x1e'
            continue
        fi
        payload+="$tool"$'\t'"$js"$'\x1e'
    done

    printf '%s' "$payload" | python3 -c '
import json, os, sys

want_json = sys.argv[1] == "1"

# Which System Settings pane, and whether the grant follows the tool or the
# terminal that launched it. That distinction is the whole reason this report
# is useful: three of these are per-tool, two are per-terminal.
META = {
    "notes":     ("Full Disk Access",    "terminal"),
    # Two grants, two halves: Full Disk Access reads the mail store, Automation
    # drafts and sends. `usable` is true when either works, so the detail line
    # below is what says which half is missing.
    "mail":      ("Full Disk Access + Automation", "terminal"),
    # Reads chat.db directly, so Full Disk Access for the calling terminal.
    # Automation is reported too but gates nothing today: there is no write path.
    "messages":  ("Full Disk Access",    "terminal"),
    # Reads CallHistory.storedata and the AddressBook stores under one grant.
    # Phone.app has no scripting dictionary, so no Automation grant exists to
    # report — dialing goes through a tel: URL and needs no permission at all.
    "phone":     ("Full Disk Access",    "terminal"),
    "reminders": ("Reminders",           "tool"),
    "calendar":  ("Calendars",           "tool"),
    "contacts":  ("Contacts",            "tool"),
}

records = []
for chunk in sys.stdin.read().split("\x1e"):
    if not chunk.strip():
        continue
    name, _, raw = chunk.partition("\t")
    if raw.startswith("\x1f"):
        records.append((name, {"status": raw[1:], "usable": False}))
        continue
    try:
        records.append((name, json.loads(raw)))
    except ValueError:
        records.append((name, {"status": "unparseable", "usable": False}))

unusable = [name for name, info in records if info.get("usable") is not True]

if want_json:
    print(json.dumps(
        {name: {**info, "pane": META.get(name, ("", ""))[0],
                "granted_to": META.get(name, ("", ""))[1]}
         for name, info in records},
        indent=2, sort_keys=True))
    # Same contract as the table form: non-zero when something needs attention.
    sys.exit(1 if unusable else 0)

colour = (sys.stdout.isatty() and not os.environ.get("NO_COLOR")
          and os.environ.get("CLICOLOR", "1") != "0"
          and os.environ.get("TERM") != "dumb") or \
         os.environ.get("CLICOLOR_FORCE", "0") != "0"
def paint(text, code):
    return "\033[%sm%s\033[0m" % (code, text) if colour else text

print(paint("%-10s %-30s %s" % ("TOOL", "PERMISSION", "OK"), "1;34"))
problems = []
for name, info in records:
    pane = META.get(name, ("", ""))[0]
    ok = info.get("usable") is True
    # Pad before painting: %-10s counts the escape bytes, so a coloured name is
    # already wider than the field and never gets padded at all.
    print("%s %-30s %s" % (
        paint("%-10s" % name, "1;35"), pane,
        paint("✓", "32") if ok else paint("✗", "31")))
    if not ok:
        problems.append((name, info.get("status", "unknown"), info.get("advice")))

if problems:
    # The exact state (denied, writeOnly, notDetermined, ...) matters when
    # something is wrong and is noise when nothing is, so it lives here rather
    # than in a column everyone has to read past.
    print()
    for name, state, advice in problems:
        detail = " — %s" % advice if advice else ""
        print("%s: %s%s" % (paint(name, "1;35"), state, detail))
else:
    print()
    print(paint("All tools have the access they need.", "32"))

# Non-zero when anything is unusable, so this can gate a script.
sys.exit(1 if problems else 0)
' "$want_json"
}

main() {
    if [ $# -eq 0 ]; then
        usage
        exit 0
    fi

    case "$1" in
        -h|--help|help)
            usage
            exit 0
            ;;
        -V|--version)
            echo "apple-tools $APPLE_TOOLS_VERSION"
            exit 0
            ;;
        --which)
            for tool in notes mail messages phone reminders calendar contacts; do
                printf '%-10s %s\n' "$tool" "$(resolve "$tool" 2>&1 || true)"
            done
            exit 0
            ;;
        status)
            shift
            # `|| exit` keeps this in a condition context, so `set -e` doesn't
            # abort before the status can be propagated. 1 means a tool lacks
            # access; 0 means everything is usable.
            status_report "${1:-}" || exit $?
            exit 0
            ;;
    esac

    local tool="$1"
    shift

    local target
    if ! target="$(resolve "$tool")"; then
        echo "error: unknown tool '$tool'" >&2
        echo >&2
        usage >&2
        exit 1
    fi

    exec "$target" "$@"
}

main "$@"
