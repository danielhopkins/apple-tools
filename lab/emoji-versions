#!/usr/bin/env python3
"""Generate `emoji-versions.txt`: which emoji arrived when.

🛑 GENERATED, NEVER HAND-WRITTEN, and that is the whole point of this script.
The window reports how long the user took to start using a new emoji, which is
a subtraction between two dates. Half-remembering that 🫠 is Emoji 14 and that
Emoji 14 shipped in September 2021 produces a wrong lag with nothing on screen
to show it is wrong — the same class of silent error as a mis-decoded table
cell.

Both halves come from unicode.org and neither is typed in:

  which version an emoji belongs to   the `E<version>` field of emoji-test.txt
  when that version was published     the `# Date:` header of THAT version's
                                      own emoji-test.txt

⚠️ E0.6 AND E0.7 PREDATE THE EMOJI SPEC. They are Unicode 6.0 and 7.0, which
have no directory under Public/emoji, so their dates come from the UCD's own
ReadMe. Both are fetched, not remembered.

Run it when a new Emoji version ships:

    ./emoji-versions            # rewrite emoji-versions.txt
    ./emoji-versions --check    # exit 1 if the file is out of date
"""

import os
import re
import sys
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
OUT = os.path.join(HERE, "emoji-versions.txt")

LATEST = "16.0"
BASE = "https://unicode.org/Public/emoji/%s/%s"
TEST = "https://unicode.org/Public/emoji/%s/emoji-test.txt"

# 🛑 NOT EVERY VERSION HAS THE SAME FILES. Emoji 1.0 to 3.0 predate
# `emoji-test.txt` and 13.0 onward dropped `emoji-data.txt`, so the date is
# taken from whichever of these the version actually publishes. Every one of
# them carries the same `# Date:` header.
DATED = ["emoji-test.txt", "emoji-data.txt", "emoji-sequences.txt"]

# ⚠️ E0.6 AND E0.7 PREDATE THE EMOJI SPEC ENTIRELY. They are Unicode 6.0 and
# 7.0, which have no directory under Public/emoji at all, so they are dated
# from the UCD release each one belongs to.
UCD_DATE_URL = "https://www.unicode.org/Public/%s/ucd/ReadMe.txt"
PRE_SPEC = {"0.6": "6.0.0", "0.7": "7.0.0"}

SKIN_TONES = "\U0001F3FB\U0001F3FC\U0001F3FD\U0001F3FE\U0001F3FF"


def fetch(url):
    with urllib.request.urlopen(url, timeout=60) as response:
        return response.read().decode("utf-8", "replace")


def emoji_rows(text):
    """(cluster, version) for every fully-qualified emoji, skin tones aside.

    ⚠️ SKIN-TONE VARIANTS ARE NOT NEW EMOJI. 👍🏽 arrived with the modifier, not
    with 👍, and counting the five tones separately would multiply every
    person-shaped emoji by five for no answer anybody wants.
    """
    for line in text.split("\n"):
        if "; fully-qualified" not in line:
            continue
        found = re.search(r"#\s+(\S+)\s+E(\d+\.\d+)\s", line)
        if not found:
            continue
        cluster, version = found.group(1), found.group(2)
        if any(tone in cluster for tone in SKIN_TONES):
            continue
        yield cluster, version


DATE_LINE = re.compile(r"^#\s*Date:\s*(\d{4})-(\d{2})-(\d{2})", re.M)


def date_in(url):
    """The `# Date:` header of one unicode.org data file, or None."""
    try:
        found = DATE_LINE.search(fetch(url))
    except Exception:
        return None
    return "-".join(found.groups()) if found else None


def published(version):
    """The date unicode.org stamped on that version's own data file."""
    if version in PRE_SPEC:
        return date_in(UCD_DATE_URL % PRE_SPEC[version])
    for name in DATED:
        date = date_in(BASE % (version, name))
        if date:
            return date
    return None


def build():
    rows = sorted(set(emoji_rows(fetch(TEST % LATEST))),
                  key=lambda row: (order(row[1]), row[0]))
    versions = sorted({version for _, version in rows}, key=order)
    dates = {}
    for version in versions:
        date = published(version)
        if not date:
            sys.exit("emoji-versions: no date for E%s" % version)
        dates[version] = date
        print("E%-5s %s  %d emoji" % (version, date,
                                      sum(1 for _, v in rows if v == version)),
              file=sys.stderr)

    lines = [
        "# GENERATED by lab/emoji-versions. Do not edit.",
        "# emoji-test.txt: " + TEST % LATEST,
        "# Each version's date is the `# Date:` header of that version's own",
        "# emoji-test.txt; E0.6 and E0.7 predate the emoji spec and are dated",
        "# from their UCD ReadMe.",
        "#",
        "# V<tab>version<tab>published",
        "# E<tab>emoji<tab>version",
    ]
    for version in versions:
        lines.append("V\t%s\t%s" % (version, dates[version]))
    for cluster, version in rows:
        lines.append("E\t%s\t%s" % (cluster, version))
    return "\n".join(lines) + "\n"


def order(version):
    return [int(part) for part in version.split(".")]


def main():
    check = "--check" in sys.argv[1:]
    built = build()
    if check:
        have = open(OUT).read() if os.path.exists(OUT) else ""
        if have != built:
            print("emoji-versions.txt is out of date. Run ./emoji-versions",
                  file=sys.stderr)
            return 1
        print("emoji-versions.txt is current")
        return 0
    with open(OUT, "w") as handle:
        handle.write(built)
    print("wrote %s" % OUT)
    return 0


if __name__ == "__main__":
    sys.exit(main())
