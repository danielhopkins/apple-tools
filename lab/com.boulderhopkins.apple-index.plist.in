<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.boulderhopkins.apple-index</string>

  <!-- 🛑 The Swift binary, not `uv run daemon.py`. The Core ML daemon needs no
       PyTorch and no virtualenv, and it holds 110 MB against 661 MB. -->
  <key>ProgramArguments</key>
  <array>
    <string>@VEC@</string>
    <string>daemon</string>
    <string>--db</string><string>@HOME@/Library/Application Support/apple-tools/lab-index.db</string>
    <string>--socket</string><string>@HOME@/Library/Application Support/apple-tools/index.sock</string>
    <!-- 🛑 The agent SERVES but does not INGEST, and `vec daemon` cannot
         ingest at all. A launchd agent has no Full Disk Access, so `apple
         mail`, `apple notes` and `apple messages` all fail from here.
         Measured, all three. Serving needs no grant, because the index file is
         not TCC-protected. Refresh from a terminal:  apple-index refresh -->
    <string>--reload-every</string><string>60</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@PATH@</string>
    <key>HOME</key><string>@HOME@</string>
  </dict>

  <key>WorkingDirectory</key><string>@INDEXDIR@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>

  <!-- It watches the index every 60s and holds 110 MB idle. Keep it out of the
       way of anything the user is actually doing. -->
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>5</integer>

  <key>StandardOutPath</key><string>@LOGDIR@/daemon.log</string>
  <key>StandardErrorPath</key><string>@LOGDIR@/daemon.log</string>
</dict>
</plist>
