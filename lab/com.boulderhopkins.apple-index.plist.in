<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.boulderhopkins.apple-index</string>

  <!-- 🛑 The Swift binary, not `uv run daemon.py`. The Core ML daemon needs no
       PyTorch and no virtualenv, and it holds 110 MB against 661 MB. -->
  <key>ProgramArguments</key>
  <array>
    <string>@VEC@</string>
    <string>daemon</string>
    <string>--db</string><string>@HOME@/Library/Application Support/apple-tools/lab-index.db</string>
    <string>--socket</string><string>@HOME@/Library/Application Support/apple-tools/index.sock</string>
    <!-- 🛑 The agent SERVES but does not INGEST, and `vec daemon` cannot
         ingest at all. A launchd agent has no Full Disk Access, so `apple
         mail`, `apple notes` and `apple messages` all fail from here.
         Measured, all three. Serving needs no grant, because the index file is
         not TCC-protected. Refresh from a terminal:  apple-index refresh -->
    <string>--reload-every</string><string>60</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>@PATH@</string>
    <key>HOME</key><string>@HOME@</string>
  </dict>

  <key>WorkingDirectory</key><string>@INDEXDIR@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>

  <!-- 🛑 `Interactive`, and NOT `Background` or `Adaptive`. The QoS class
       decides which cores this runs on, and a person is waiting at a prompt.
       Measured with one binary and one set of flags, changing only this key:

         Background   scan 17.55 ms   total 43.50 ms
         Adaptive     scan 17.90 ms   total 21.75 ms
         Standard     scan  2.55 ms   total  4.60 ms
         Interactive  scan  2.10 ms   total  4.20 ms

       ⚠️ `Adaptive` is documented as raising a job while it works, and it did
       not raise this one. Measure the key rather than reading it.
       ⚠️ The daemon is idle almost always: it watches the index every 60s and
       holds about 470 MB warm. `LowPriorityIO` stays, because the only disk
       work it does is that background reload. -->
  <key>ProcessType</key><string>Interactive</string>
  <key>LowPriorityIO</key><true/>

  <key>StandardOutPath</key><string>@LOGDIR@/daemon.log</string>
  <key>StandardErrorPath</key><string>@LOGDIR@/daemon.log</string>
</dict>
</plist>
