#!/bin/bash
# apple-index — the semantic index over the apple tools.
#
# A thin wrapper so the command works from any directory. The real program is
# index.py, which is stdlib-only Python. The embedding half is `vec`, a Swift
# binary using Core ML — no PyTorch, no `uv`, nothing to install.
set -u
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do self="$(readlink "$self")"; done
here="$(cd "$(dirname "$self")" && pwd)"

# Two layouts: a checkout has this in bin/ with index.py one level up; an
# install puts them side by side.
for candidate in "$here/.." "$here"; do
  if [ -f "$candidate/index.py" ]; then
    exec /usr/bin/python3 "$candidate/index.py" "$@"
  fi
done
echo "apple-index: cannot find index.py (looked in $here and $here/..)" >&2
exit 1
